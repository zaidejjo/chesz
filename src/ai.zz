// Evaluation (material, side-to-move perspective) and negamax search
// with alpha-beta pruning. Mate scores: 100000 adjusted by depth so
// faster mates rank higher.

import std.vec

import board
import moves
import rand

pub func piece_val(pc: int) -> int {
    if pc == 1 {
        100
    } else {
        if pc == 2 {
            320
        } else {
            if pc == 3 {
                330
            } else {
                if pc == 4 {
                    500
                } else {
                    if pc == 5 {
                        900
                    } else {
                        0
                    }
                }
            }
        }
    }
}

// Small centralization bonus so equal-material moves don't all tie.

func pst(pc: int, f: int, r: int) -> int {
    if f >= 2 && f <= 5 && r >= 2 && r <= 5 {
        if pc == 1 {
            6
        } else {
            if pc == 2 {
                12
            } else {
                if pc == 3 {
                    4
                } else {
                    0
                }
            }
        }
    } else {
        0
    }
}

pub func evaluate(p: board.Pos) -> int {
    s := 0
    i := 0
    while i < 64 {
        v := p.b[i]
        if v > 0 {
            s = s + piece_val(v) + pst(v, board.file_of(i), board.rank_of(i))
        } else {
            if v < 0 {
                s = s - piece_val(0 - v) - pst(0 - v, board.file_of(i), board.rank_of(i))
            }
        }
        i = i + 1
    }
    if p.side == 1 {
        s
    } else {
        0 - s
    }
}

// MVV-LVA loud-move score: most valuable victim, then cheapest
// attacker, promotions just below winning captures. Quiet moves score
// zero and keep their generated order behind the loud ones.

func loud_score(p: board.Pos, mv: int) -> int {
    to := moves.mv_to(mv)
    vic := p.b[to]
    if vic < 0 {
        vic = 0 - vic
    }
    from := moves.mv_from(mv)
    att := p.b[from]
    if att < 0 {
        att = 0 - att
    }
    // En-passant victim is off-target.
    if vic == 0 && att == 1 && to == p.ep {
        vic = 1
    }
    score := piece_val(vic) * 10 - piece_val(att) / 100
    if moves.mv_promo(mv) != 0 {
        score = score + 5000
    }
    score
}

func is_loud(p: board.Pos, mv: int) -> bool {
    if moves.mv_promo(mv) != 0 {
        true
    } else {
        to := moves.mv_to(mv)
        if p.b[to] != 0 {
            true
        } else {
            from := moves.mv_from(mv)
            att := p.b[from]
            if att < 0 {
                att = 0 - att
            }
            att == 1 && to == p.ep
        }
    }
}

// Captures and promotions search first, best victims first: they
// refute fastest, so alpha-beta prunes the quiet rest away.

func ordered(p: board.Pos, ms: [int], first_caps: int) -> [int] {
    out := []
    loud := []
    i := 0
    while i < len(ms) {
        if is_loud(p, ms[i]) == (first_caps == 1) {
            if first_caps == 1 {
                // Insertion by victim value (tiny lists, no alloc sort).
                s := loud_score(p, ms[i])
                j := 0
                while j < len(loud) {
                    if loud_score(p, loud[j]) < s {
                        break
                    }
                    j = j + 1
                }
                loud = vec_insert(loud, j, ms[i])
            } else {
                out = vec.push(out, ms[i])
            }
        }
        i = i + 1
    }
    concat_moves(loud, out)
}

func vec_insert(v: [int], at: int, x: int) -> [int] {
    out := []
    i := 0
    while i < at {
        out = vec.push(out, v[i])
        i = i + 1
    }
    out = vec.push(out, x)
    while i < len(v) {
        out = vec.push(out, v[i])
        i = i + 1
    }
    out
}

// Quiescence: captures/promotions play out past the horizon so the
// static eval never scores mid-exchange. Standing pat is always an
// option (fail-soft). Checks force full evasions, capped so a checking
// cascade cannot run away. qd counts remaining loud plies.

func qsearch(p: board.Pos, alpha: int, beta: int, qd: int) -> int {
    if moves.in_check(p) {
        if qd <= 0 {
            return evaluate(p)
        }
        ms := moves.gen_legal(p)
        if len(ms) == 0 {
            return 0 - 100000 - qd
        }
        a := alpha
        i := 0
        while i < len(ms) {
            q := moves.make(p, ms[i])
            score := 0 - qsearch(q, 0 - beta, 0 - a, qd - 1)
            if score >= beta {
                return score
            }
            if score > a {
                a = score
            }
            i = i + 1
        }
        return a
    }
    stand := evaluate(p)
    if stand >= beta {
        return stand
    }
    a := alpha
    if stand > a {
        a = stand
    }
    if qd <= 0 {
        return a
    }
    all := moves.gen_pseudo(p)
    loud := []
    i := 0
    while i < len(all) {
        if is_loud(p, all[i]) {
            loud = vec.push(loud, all[i])
        }
        i = i + 1
    }
    loud = ordered(p, loud, 1)
    i = 0
    while i < len(loud) {
        // Pseudo-loud may leave the king hanging; skip illegal ones.
        q := moves.make(p, loud[i])
        k := moves.king_sq(q.b, p.side)
        if k >= 0 && !moves.is_attacked(q.b, k, q.side) {
            score := 0 - qsearch(q, 0 - beta, 0 - a, qd - 1)
            if score >= beta {
                return score
            }
            if score > a {
                a = score
            }
        }
        i = i + 1
    }
    a
}

func search(p: board.Pos, depth: int, alpha: int, beta: int) -> int {
    // Horizon hands off to quiescence (captures resolve, checks evade)
    // instead of a blind static eval.
    if depth == 0 {
        return qsearch(p, alpha, beta, 6)
    }
    all := moves.gen_legal(p)
    if len(all) == 0 {
        if moves.in_check(p) {
            return 0 - 100000 - depth
        }
        return 0
    }
    ms := concat_moves(ordered(p, all, 1), ordered(p, all, 0))
    a := alpha
    i := 0
    while i < len(ms) {
        q := moves.make(p, ms[i])
        // Negate bounds through the recursion (negamax).
        score := 0 - search(q, depth - 1, 0 - beta, 0 - a)
        if score >= beta {
            return score
        }
        if score > a {
            a = score
        }
        i = i + 1
    }
    a
}

func concat_moves(a: [int], b: [int]) -> [int] {
    i := 0
    while i < len(b) {
        a = vec.push(a, b[i])
        i = i + 1
    }
    a
}

// Best move for the side to move at `depth` (0 when no legal move).
// `hist` holds past boards back-to-back (64 ints each, most recent
// last); moves repeating any same-side position in it are skipped to
// break shuffle loops, unless nothing else exists.

pub func best_move(p: board.Pos, depth: int, hist: [int]) -> int {
    all := moves.gen_legal(p)
    if len(all) == 0 {
        return 0
    }
    ms := concat_moves(ordered(p, all, 1), ordered(p, all, 0))
    best := 0
    best_score := 0 - 1000000
    tied := []
    i := 0
    while i < len(ms) {
        q := moves.make(p, ms[i])
        if !seen_before(hist, q.side, q.b) {
            score := 0 - search(q, depth - 1, 0 - 1000000, 1000000)
            if best == 0 || score > best_score {
                best_score = score
                best = ms[i]
                tied = [ms[i]]
            } else {
                // Equal-best moves share the top score: collect them
                // and draw one below so play varies instead of always
                // keeping the first in move order (knight/rook dances).
                if score == best_score {
                    tied = vec.push(tied, ms[i])
                }
            }
        }
        i = i + 1
    }
    if best == 0 {
        best = ms[0]
    } else {
        if len(tied) > 1 {
            (k, _) := rand.below(rand.auto_seed(), len(tied))
            best = tied[k]
        }
    }
    best
}

// True when b matches a same-side-to-move board in hist. Entries hold
// 65 ints (side + 64 squares), most recent last; only odd-ago entries
// (1, 3, 5 plies back) share the mover's resulting side to move.

func seen_before(hist: [int], side: int, b: [int]) -> bool {
    n := len(hist) / 65
    k := 1
    while k <= n && k <= 11 {
        base := (n - k) * 65
        if hist[base] == side {
            same := true
            i := 0
            while i < 64 {
                if hist[base + 1 + i] != b[i] {
                    same = false
                }
                i = i + 1
            }
            if same {
                return true
            }
        }
        k = k + 2
    }
    false
}

// Record side + board, keeping at most the last 12 positions.

pub func push_hist(hist: [int], p: board.Pos) -> [int] {
    out := []
    start := len(hist) + 65 - 12 * 65
    if start < 0 {
        start = 0
    }
    i := start
    while i < len(hist) {
        out = vec.push(out, hist[i])
        i = i + 1
    }
    out = vec.push(out, p.side)
    i = 0
    while i < 64 {
        out = vec.push(out, p.b[i])
        i = i + 1
    }
    out
}

// Counts appearances of the side-to-move board in hist (plus the
// current one). Three or more means threefold repetition.

pub func repetitions(hist: [int], p: board.Pos) -> int {
    count := 1
    n := len(hist) / 65
    k := 0
    while k < n {
        base := k * 65
        if hist[base] == p.side {
            same := true
            i := 0
            while i < 64 {
                if hist[base + 1 + i] != p.b[i] {
                    same = false
                }
                i = i + 1
            }
            if same {
                count = count + 1
            }
        }
        k = k + 1
    }
    count
}

// Dead positions no legal sequence can mate from: bare kings, or one
// side with a single minor and nothing else.

pub func insufficient_material(b: [int]) -> bool {
    i := 0
    minors := 0
    while i < 64 {
        v := b[i]
        if v != 0 {
            a := v
            if a < 0 {
                a = 0 - a
            }
            if a == 1 || a == 4 || a == 5 {
                return false
            }
            if a == 2 || a == 3 {
                minors = minors + 1
            }
        }
        i = i + 1
    }
    minors <= 1
}

// Score of the best move (for display, in centipawns).

pub func best_score(p: board.Pos, depth: int) -> int {
    all := moves.gen_legal(p)
    if len(all) == 0 {
        return 0
    }
    ms := concat_moves(ordered(p, all, 1), ordered(p, all, 0))
    best := 0 - 1000000
    i := 0
    while i < len(ms) {
        q := moves.make(p, ms[i])
        score := 0 - search(q, depth - 1, 0 - 1000000, 1000000)
        if score > best {
            best = score
        }
        i = i + 1
    }
    best
}
