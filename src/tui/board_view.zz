// Board renderer: pure position -> rows. No terminal, no input —
// fully unit-testable. Highlights: cursor (reverse), selected piece,
// legal targets, last move, king in check. Pass color=false on
// colorless terminals (or when screen.mode() == 0).

import std.colors
import std.vec

import chess.engine.board
import chess.engine.moves

pub func has_sq(v: [int], sq: int) -> bool {
    i := 0
    while i < len(v) {
        if v[i] == sq {
            return true
        }
        i = i + 1
    }
    false
}

// Cursor step with edge clamping (no wraparound — predictable).

pub func step_cursor(cur: int, dx: int, dy: int) -> int {
    f := board.file_of(cur) + dx
    r := board.rank_of(cur) + dy
    if f < 0 {
        f = 0
    }
    if f > 7 {
        f = 7
    }
    if r < 0 {
        r = 0
    }
    if r > 7 {
        r = 7
    }
    r * 8 + f
}

// Destination squares for the piece on `from` (empty when no piece).

pub func targets_for(p: board.Pos, from: int) -> [int] {
    out := []
    ms := moves.gen_legal(p)
    i := 0
    while i < len(ms) {
        if moves.mv_from(ms[i]) == from {
            out = vec.push(out, moves.mv_to(ms[i]))
        }
        i = i + 1
    }
    out
}

// Every legal move from->to (promotion variants included).

pub func find_moves(legal: [int], from: int, to: int) -> [int] {
    out := []
    i := 0
    while i < len(legal) {
        if moves.mv_from(legal[i]) == from && moves.mv_to(legal[i]) == to {
            out = vec.push(out, legal[i])
        }
        i = i + 1
    }
    out
}

func uni(v: int) -> str {
    if v == 1 {
        "♙"
    } else {
        if v == 2 {
            "♘"
        } else {
            if v == 3 {
                "♗"
            } else {
                if v == 4 {
                    "♖"
                } else {
                    if v == 5 {
                        "♕"
                    } else {
                        if v == 6 {
                            "♔"
                        } else {
                            if v == 0 - 1 {
                                "♟"
                            } else {
                                if v == 0 - 2 {
                                    "♞"
                                } else {
                                    if v == 0 - 3 {
                                        "♝"
                                    } else {
                                        if v == 0 - 4 {
                                            "♜"
                                        } else {
                                            if v == 0 - 5 {
                                                "♛"
                                            } else {
                                                if v == 0 - 6 {
                                                    "♚"
                                                } else {
                                                    " "
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

func glyph_for(v: int, mode: int) -> str {
    if mode == 0 {
        if v == 0 {
            " "
        } else {
            board.glyph(v)
        }
    } else {
        uni(v)
    }
}

// Piece ink: near-black coffee on both shades in truecolor/256 (the
// outline-vs-filled glyphs carry the side); bright pairs on basic16.

func piece_fg(v: int, text: str, mode: int) -> str {
    if mode == 0 {
        return text
    }
    if mode >= 3 {
        return colors.bold(colors.rgb(text, 40, 25, 15))
    }
    if mode == 2 {
        return colors.bold(colors.color256(text, 232))
    }
    if v > 0 {
        colors.bright_white(text)
    } else {
        if v < 0 {
            colors.yellow(text)
        } else {
            text
        }
    }
}

func rank_label(r: int, mode: int) -> str {
    t := str(r + 1) + " "
    if mode == 0 {
        t
    } else {
        colors.dim(t)
    }
}

func vbar(mode: int) -> str {
    if mode == 0 {
        "|"
    } else {
        colors.dim("│")
    }
}

func shade(sq: int, text: str, mode: int) -> str {
    if mode >= 3 {
        if (board.file_of(sq) + board.rank_of(sq)) % 2 == 0 {
            return colors.bg_rgb(text, 181, 136, 99)
        }
        return colors.bg_rgb(text, 240, 217, 181)
    }
    if mode == 2 {
        if (board.file_of(sq) + board.rank_of(sq)) % 2 == 0 {
            return colors.bg_256(text, 137)
        }
        return colors.bg_256(text, 223)
    }
    if mode == 1 {
        f := board.file_of(sq)
        r := board.rank_of(sq)
        if (f + r) % 2 == 0 {
            return colors.bg_black(text)
        }
        return colors.bg_bright_black(text)
    }
    text
}

func hi_bg(text: str, kind: int, mode: int) -> str {
    if mode >= 3 {
        if kind == 0 {
            return colors.bg_rgb(text, 220, 60, 60)
        }
        if kind == 1 {
            return colors.bg_rgb(text, 250, 200, 60)
        }
        if kind == 2 {
            return colors.bg_rgb(text, 110, 190, 110)
        }
        return colors.bg_rgb(text, 205, 210, 106)
    }
    if mode == 2 {
        if kind == 0 {
            return colors.bg_256(text, 196)
        }
        if kind == 1 {
            return colors.bg_256(text, 220)
        }
        if kind == 2 {
            return colors.bg_256(text, 114)
        }
        return colors.bg_256(text, 186)
    }
    if kind == 0 {
        return colors.bg_red(text)
    }
    if kind == 1 {
        return colors.bg_yellow(text)
    }
    if kind == 2 {
        return colors.bg_green(text)
    }
    colors.bg_cyan(text)
}

func mark_bg(sq: int, text: str, cursor: int, selected: int, targets: [int], last_from: int, last_to: int, check_king: int, mode: int) -> str {
    if mode == 0 {
        if sq == cursor {
            return "[" + text + "]"
        }
        return " " + text + " "
    }
    inner := text
    if sq == check_king {
        inner = hi_bg(text, 0, mode)
    } else {
        if sq == selected {
            inner = hi_bg(text, 1, mode)
        } else {
            if has_sq(targets, sq) {
                inner = hi_bg(text, 2, mode)
            } else {
                if sq == last_from || sq == last_to {
                    inner = hi_bg(text, 3, mode)
                } else {
                    inner = shade(sq, text, mode)
                }
            }
        }
    }
    if sq == cursor {
        inner = colors.reverse(inner)
    }
    inner
}

func cell_row(p: board.Pos, r: int, cursor: int, selected: int, targets: [int], last_from: int, last_to: int, check_king: int, mode: int, piece_line: bool) -> str {
    head := "  │"
    if piece_line {
        head = rank_label(r, mode) + vbar(mode)
    } else {
        if mode != 0 {
            head = "  " + colors.dim("│")
        }
    }
    line := head
    f := 0
    while f < 8 {
        sq := r * 8 + f
        v := p.b[sq]
        glyph := " "
        if piece_line && mode != 4 {
            glyph = glyph_for(p.b[sq], mode)
        }
        cell := piece_fg(v, "   " + glyph + "   ", mode)
        line = line + mark_bg(sq, cell, cursor, selected, targets, last_from, last_to, check_king, mode)
        f = f + 1
    }
    if mode == 0 {
        line + "|"
    } else {
        line + vbar(mode)
    }
}

// Stack board rows beside a plain-text side panel and center the
// block: pure math on visible widths (ANSI stripped), so highlights
// never shift columns. ox/oy pad left/top.

pub func render(p: board.Pos, cursor: int, selected: int, targets: [int], last_from: int, last_to: int, mode: int) -> [str] {
    check_king := 0 - 1
    if moves.in_check(p) {
        check_king = moves.king_sq(p.b, p.side)
    }
    rows := []
    rows = vec.push(rows, frame_top(mode))
    r := 7
    while r >= 0 {
        rows = vec.push(rows, cell_row(p, r, cursor, selected, targets, last_from, last_to, check_king, mode, false))
        rows = vec.push(rows, cell_row(p, r, cursor, selected, targets, last_from, last_to, check_king, mode, true))
        r = r - 1
    }
    rows = vec.push(rows, frame_bottom(mode))
    rows = vec.push(rows, foot_row(mode))
    rows
}

// 7-wide cells, 2 tall: pixel art pairs per cell row.
// Border frame + labels included; 19 rows total, 60 cells wide.

func rep_str(g: str, n: int) -> str {
    s := ""
    i := 0
    while i < n {
        s = s + g
        i = i + 1
    }
    s
}

func frame_top(mode: int) -> str {
    if mode == 0 {
        "  +" + rep_str("-", 56) + "+"
    } else {
        colors.dim("  ┌" + rep_str("─", 56) + "┐")
    }
}

func frame_bottom(mode: int) -> str {
    if mode == 0 {
        "  +" + rep_str("-", 56) + "+"
    } else {
        colors.dim("  └" + rep_str("─", 56) + "┘")
    }
}

func foot_row(mode: int) -> str {
    foot := "      a      b      c      d      e      f      g      h"
    if mode == 0 {
        foot
    } else {
        colors.dim(foot)
    }
}

pub func compose(rows: [str], side: [str], ox: int, oy: int) -> [str] {
    width := 0
    i := 0
    while i < len(rows) {
        w := len(colors.strip(rows[i]))
        if w > width {
            width = w
        }
        i = i + 1
    }
    out := []
    i = 0
    while i < oy {
        out = vec.push(out, "")
        i = i + 1
    }
    pad := rep_str(" ", ox)
    i = 0
    while i < len(rows) || i < len(side) {
        line := ""
        if i < len(rows) {
            line = rows[i] + rep_str(" ", width - len(colors.strip(rows[i])) + 2)
        } else {
            line = rep_str(" ", width + 2)
        }
        if i < len(side) {
            line = line + side[i]
        }
        out = vec.push(out, pad + line)
        i = i + 1
    }
    out
}
