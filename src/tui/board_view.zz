// Board renderer: pure position -> rows. No terminal, no input —
// fully unit-testable. Highlights: cursor (reverse), selected piece,
// legal targets, last move, king in check. Pass color=false on
// colorless terminals (or when screen.mode() == 0).

import std.colors
import std.env
import std.fs
import std.json
import std.vec

import chesz.engine.board
import chesz.engine.eval
import chesz.engine.moves

pub func has_sq(v: [int], sq: int) -> bool {
    i := 0
    while i < len(v) {
        if v[i] == sq {
            return true
        }
        i = i + 1
    }
    false
}

// Cursor step with edge clamping (no wraparound — predictable).

pub func step_cursor(cur: int, dx: int, dy: int) -> int {
    f := board.file_of(cur) + dx
    r := board.rank_of(cur) + dy
    if f < 0 {
        f = 0
    }
    if f > 7 {
        f = 7
    }
    if r < 0 {
        r = 0
    }
    if r > 7 {
        r = 7
    }
    r * 8 + f
}

// Destination squares for the piece on `from` (empty when no piece).

pub func targets_for(p: board.Pos, from: int) -> [int] {
    out := []
    ms := moves.gen_legal(p)
    i := 0
    while i < len(ms) {
        if moves.mv_from(ms[i]) == from {
            out = vec.push(out, moves.mv_to(ms[i]))
        }
        i = i + 1
    }
    out
}

// Every legal move from->to (promotion variants included).

pub func find_moves(legal: [int], from: int, to: int) -> [int] {
    out := []
    i := 0
    while i < len(legal) {
        if moves.mv_from(legal[i]) == from && moves.mv_to(legal[i]) == to {
            out = vec.push(out, legal[i])
        }
        i = i + 1
    }
    out
}

func uni(v: int) -> str {
    table := ["♚", "♛", "♜", "♝", "♞", "♟", " ", "♙", "♘", "♗", "♖", "♕", "♔"]
    i := v + 6
    if i < 0 || i >= len(table) {
        " "
    } else {
        table[i]
    }
}

func glyph_for(v: int, mode: int) -> str {
    if mode == 0 {
        if v == 0 {
            " "
        } else {
            board.glyph(v)
        }
    } else {
        uni(v)
    }
}

// Piece ink: white pieces ride a dark coffee chip, black pieces a cream
// chip — constant islands that read on every square shade and every
// theme, instead of ink mixed into the square itself.

func piece_fg(v: int, text: str, mode: int) -> str {
    if mode == 0 {
        return text
    }
    if mode >= 3 {
        if v > 0 {
            return colors.bold(colors.bg_rgb(colors.rgb(text, 255, 255, 255), 55, 35, 20))
        }
        if v < 0 {
            return colors.bold(colors.bg_rgb(colors.rgb(text, 30, 20, 15), 235, 225, 205))
        }
        return text
    }
    if mode == 2 {
        if v > 0 {
            return colors.bold(colors.bg_256(colors.color256(text, 231), 94))
        }
        if v < 0 {
            return colors.bold(colors.bg_256(colors.color256(text, 232), 230))
        }
        return text
    }
    if v > 0 {
        colors.bright_white(text)
    } else {
        if v < 0 {
            colors.yellow(text)
        } else {
            text
        }
    }
}

func rank_label(r: int, mode: int) -> str {
    t := str(r + 1) + " "
    if mode == 0 {
        t
    } else {
        colors.dim(t)
    }
}

func vbar(mode: int) -> str {
    if mode == 0 {
        "|"
    } else {
        colors.dim("│")
    }
}

func shade(sq: int, text: str, mode: int, theme: int, pal: [int]) -> str {
    dark := (board.file_of(sq) + board.rank_of(sq)) % 2 == 0
    if mode >= 3 {
        if len(pal) == 6 && theme >= 100 {
            if dark {
                return colors.bg_rgb(text, pal[0], pal[1], pal[2])
            }
            return colors.bg_rgb(text, pal[3], pal[4], pal[5])
        }
        d := theme_dark(theme)
        l := theme_light(theme)
        if dark {
            return colors.bg_rgb(text, d[0], d[1], d[2])
        }
        return colors.bg_rgb(text, l[0], l[1], l[2])
    }
    if mode == 2 {
        c := theme_256(theme)
        if dark {
            return colors.bg_256(text, c[0])
        }
        return colors.bg_256(text, c[1])
    }
    if mode == 1 {
        f := board.file_of(sq)
        r := board.rank_of(sq)
        if (f + r) % 2 == 0 {
            return colors.bg_black(text)
        }
        return colors.bg_bright_black(text)
    }
    text
}

func hi_bg(text: str, kind: int, mode: int) -> str {
    if mode >= 3 {
        if kind == 0 {
            return colors.bg_rgb(text, 220, 60, 60)
        }
        if kind == 1 {
            return colors.bg_rgb(text, 250, 200, 60)
        }
        if kind == 2 {
            return colors.bg_rgb(text, 110, 190, 110)
        }
        return colors.bg_rgb(text, 205, 210, 106)
    }
    if mode == 2 {
        if kind == 0 {
            return colors.bg_256(text, 196)
        }
        if kind == 1 {
            return colors.bg_256(text, 220)
        }
        if kind == 2 {
            return colors.bg_256(text, 114)
        }
        return colors.bg_256(text, 186)
    }
    if kind == 0 {
        return colors.bg_red(text)
    }
    if kind == 1 {
        return colors.bg_yellow(text)
    }
    if kind == 2 {
        return colors.bg_green(text)
    }
    colors.bg_cyan(text)
}

func mark_bg(sq: int, text: str, cursor: int, selected: int, targets: [int], last_from: int, last_to: int, check_king: int, mode: int, theme: int, pal: [int]) -> str {
    if mode == 0 {
        if sq == cursor {
            return "[" + text + "]"
        }
        return " " + text + " "
    }
    inner := text
    if sq == check_king {
        inner = hi_bg(text, 0, mode)
    } else {
        if sq == selected {
            inner = hi_bg(text, 1, mode)
        } else {
            if has_sq(targets, sq) {
                inner = hi_bg(text, 2, mode)
            } else {
                if sq == last_from || sq == last_to {
                    inner = hi_bg(text, 3, mode)
                } else {
                    inner = shade(sq, text, mode, theme, pal)
                }
            }
        }
    }
    if sq == cursor {
        inner = colors.reverse(inner)
    }
    inner
}

func cell_row(p: board.Pos, r: int, cursor: int, selected: int, targets: [int], last_from: int, last_to: int, check_king: int, mode: int, piece_line: bool, style: int, theme: int, pal: [int]) -> str {
    head := "  │"
    if piece_line {
        head = rank_label(r, mode) + vbar(mode)
    } else {
        if mode != 0 {
            head = "  " + colors.dim("│")
        }
    }
    line := head
    f := 0
    while f < 8 {
        sq := r * 8 + f
        v := p.b[sq]
        art := "       "
        if true {
            if mode == 0 || style == 2 {
                if piece_line {
                    g := " "
                    if v != 0 {
                        g = board.glyph(v)
                    }
                    art = "   " + g + "   "
                }
            } else {
                if style == 1 {
                    if piece_line {
                        art = "   " + glyph_for(v, mode) + "   "
                    }
                } else {
                    sub := 0
                    if piece_line {
                        sub = 1
                    }
                    art = ascii_art(v, sub)
                }
            }
        }
        cell := piece_fg(v, art, mode)
        line = line + mark_bg(sq, cell, cursor, selected, targets, last_from, last_to, check_king, mode, theme, pal)
        f = f + 1
    }
    if mode == 0 {
        line + "|"
    } else {
        line + vbar(mode)
    }
}

// Stack board rows beside a plain-text side panel and center the
// block: pure math on visible widths (ANSI stripped), so highlights
// never shift columns. ox/oy pad left/top.

pub func render(p: board.Pos, cursor: int, selected: int, targets: [int], last_from: int, last_to: int, mode: int, style: int, theme: int, pal: [int]) -> [str] {
    check_king := 0 - 1
    if moves.in_check(p) {
        check_king = moves.king_sq(p.b, p.side)
    }
    rows := []
    rows = vec.push(rows, frame_top(mode))
    r := 7
    while r >= 0 {
        rows = vec.push(rows, cell_row(p, r, cursor, selected, targets, last_from, last_to, check_king, mode, false, style, theme, pal))
        rows = vec.push(rows, cell_row(p, r, cursor, selected, targets, last_from, last_to, check_king, mode, true, style, theme, pal))
        r = r - 1
    }
    rows = vec.push(rows, frame_bottom(mode))
    rows = vec.push(rows, foot_row(mode))
    rows
}

// 7-wide cells, 2 tall: pixel art pairs per cell row.
// Border frame + labels included; 19 rows total, 60 cells wide.

func rep_str(g: str, n: int) -> str {
    s := ""
    i := 0
    while i < n {
        s = s + g
        i = i + 1
    }
    s
}

func frame_top(mode: int) -> str {
    if mode == 0 {
        "  +" + rep_str("-", 56) + "+"
    } else {
        colors.dim("  ┌" + rep_str("─", 56) + "┐")
    }
}

func frame_bottom(mode: int) -> str {
    if mode == 0 {
        "  +" + rep_str("-", 56) + "+"
    } else {
        colors.dim("  └" + rep_str("─", 56) + "┘")
    }
}

// Piece style: ascii character art by default (byte-clean, works
// everywhere); glyphs or letters via CHESS_PIECES=glyphs|letters.

// Piece style, resolved ONCE per game (never per cell — file IO):
// CHESS_PIECES env wins, then ~/.config/chess.json (chesz.json
// fallback), then letters. Styles: 0 ascii, 1 glyphs, 2 letters.

pub func style_of(name: str) -> int {
    names := ["ascii", "glyphs", "letters"]
    i := 0
    while i < len(names) {
        if names[i] == name {
            return i
        }
        i = i + 1
    }
    0 - 1
}

pub func style_in_json(text: str) -> int {
    j := json.parse_or_null(text)
    if !json.is_object(j) {
        return 0 - 1
    }
    v := json.path_get_or(j, "pieces", json.null())
    if !json.is_string(v) {
        return 0 - 1
    }
    style_of(json.as_str(v))
}

// Board themes: 15 built-ins (0 lichess default through 14 rose-pine)
// plus user files in ~/.config/chesz/themes/ (ids 100+). Tables, not
// pyramids: names, palettes and 256-color pairs all index by id.

func theme_names_all() -> [str] {
    ["lichess", "green", "slate", "blue", "catppuccin", "latte", "tokyo-night", "dracula", "nord", "gruvbox", "solarized-dark", "solarized-light", "monokai", "everforest", "rose-pine"]
}

pub func theme_count() -> int {
    len(theme_names_all())
}

pub func all_theme_names() -> [str] {
    out := theme_names_all()
    customs := custom_names()
    i := 0
    while i < len(customs) {
        out = vec.push(out, customs[i])
        i = i + 1
    }
    out
}

pub func theme_of(name: str) -> int {
    names := theme_names_all()
    i := 0
    while i < len(names) {
        if names[i] == name {
            return i
        }
        i = i + 1
    }
    0 - 1
}

pub func theme_name(theme: int) -> str {
    names := theme_names_all()
    if theme < 0 || theme >= len(names) {
        if theme >= 100 {
            customs := custom_names()
            idx := theme - 100
            if idx >= 0 && idx < len(customs) {
                return customs[idx]
            }
        }
        return "lichess"
    }
    names[theme]
}

// User themes: ~/.config/chesz/themes/<name>.json holding
// {"dark": "#181825", "light": "#f5e0dc"}. Sorted by the OS read,
// ids 100+ in that order (stable across launches).

func themes_dir() -> str {
    home_dir() + "/.config/chesz/themes"
}

func strip_json(name: str) -> str {
    b := str.bytes(name)
    if len(b) <= 5 {
        return ""
    }
    out := ""
    i := 0
    while i < len(b) - 5 {
        out = out + str.chr(b[i])
        i = i + 1
    }
    out
}

pub func custom_names() -> [str] {
    out := []
    match fs.read_dir(themes_dir()) {
        .ok(all) => out = collect_custom(all)
        .err(_) => out = out
    }
    out
}

func collect_custom(all: [str]) -> [str] {
    out := []
    i := 0
    while i < len(all) {
        n := all[i]
        if str.ends_with(n, ".json") && !str.starts_with(n, ".") {
            out = vec.push(out, strip_json(n))
        }
        i = i + 1
    }
    out
}

func hex_val(b: int) -> int {
    if b >= 48 && b <= 57 {
        b - 48
    } else {
        if b >= 97 && b <= 102 {
            b - 87
        } else {
            if b >= 65 && b <= 70 {
                b - 55
            } else {
                0 - 1
            }
        }
    }
}

pub func hex_rgb(text: str) -> [int] {
    b := str.bytes(text)
    if len(b) != 7 || b[0] != 35 {
        return []
    }
    out := []
    i := 1
    while i < 7 {
        hi := hex_val(b[i])
        lo := hex_val(b[i + 1])
        if hi < 0 || lo < 0 {
            return []
        }
        out = vec.push(out, hi * 16 + lo)
        i = i + 2
    }
    out
}

func str_field(j: json, key: str) -> str {
    match json.get(j, key) {
        .ok(v) => {
            if json.is_string(v) {
                json.as_str(v)
            } else {
                ""
            }
        }
        .err(_) => ""
    }
}

pub func load_custom(theme: int) -> [int] {
    if theme < 100 {
        return []
    }
    customs := custom_names()
    idx := theme - 100
    if idx < 0 || idx >= len(customs) {
        return []
    }
    match fs.read_to_string(themes_dir() + "/" + customs[idx] + ".json") {
        .ok(t) => {
            j := json.parse_or_null(t)
            if !json.is_object(j) {
                return []
            }
            d := hex_rgb(str_field(j, "dark"))
            l := hex_rgb(str_field(j, "light"))
            if len(d) != 3 || len(l) != 3 {
                return []
            }
            [d[0], d[1], d[2], l[0], l[1], l[2]]
        }
        .err(_) => []
    }
}

func theme_dark(theme: int) -> [int] {
    pal := [[181, 136, 99], [118, 150, 86], [105, 115, 130], [105, 145, 185], [108, 112, 134], [172, 178, 194], [86, 95, 137], [98, 114, 164], [76, 86, 106], [102, 92, 84], [88, 110, 117], [147, 161, 161], [117, 113, 94], [125, 131, 119], [110, 106, 134]]
    if theme < 0 || theme >= len(pal) {
        return [181, 136, 99]
    }
    pal[theme]
}

func theme_light(theme: int) -> [int] {
    pal := [[240, 217, 181], [238, 238, 210], [225, 230, 238], [232, 242, 252], [245, 224, 220], [239, 241, 245], [192, 202, 245], [248, 248, 242], [216, 222, 233], [235, 219, 178], [238, 232, 213], [253, 246, 227], [248, 248, 242], [211, 198, 170], [246, 240, 236]]
    if theme < 0 || theme >= len(pal) {
        return [240, 217, 181]
    }
    pal[theme]
}

func theme_256(theme: int) -> [int] {
    pal := [[137, 223], [107, 194], [103, 195], [110, 195], [102, 224], [146, 255], [60, 189], [61, 255], [60, 188], [59, 223], [66, 228], [109, 230], [101, 255], [108, 187], [102, 255]]
    if theme < 0 || theme >= len(pal) {
        return [137, 223]
    }
    pal[theme]
}

pub func theme_in_json(text: str) -> int {
    j := json.parse_or_null(text)
    if !json.is_object(j) {
        return 0 - 1
    }
    v := json.path_get_or(j, "theme", json.null())
    if !json.is_string(v) {
        return 0 - 1
    }
    theme_id(json.as_str(v))
}

pub func resolve_theme() -> int {
    if let .some(v) = env.get_var("CHESS_THEME") {
        t := theme_id(v)
        if t >= 0 {
            return t
        }
    }
    t := theme_in_json_file(config_path())
    if t >= 0 {
        return t
    }
    0
}

// Builtin id, or 100+ for a user file, or -1.

pub func theme_id(name: str) -> int {
    t := theme_of(name)
    if t >= 0 {
        return t
    }
    customs := custom_names()
    i := 0
    while i < len(customs) {
        if customs[i] == name {
            return 100 + i
        }
        i = i + 1
    }
    0 - 1
}

func theme_in_json_file(path: str) -> int {
    if !fs.exists(path) {
        return 0 - 1
    }
    match fs.read_to_string(path) {
        .ok(t) => theme_in_json(t)
        .err(_) => 0 - 1
    }
}

func home_dir() -> str {
    match env.home_dir() {
        .some(h) => h
        .none => "."
    }
}

func file_style(path: str) -> int {
    if !fs.exists(path) {
        return 0 - 1
    }
    match fs.read_to_string(path) {
        .ok(t) => style_in_json(t)
        .err(_) => 0 - 1
    }
}

pub func resolve_style() -> int {
    if let .some(v) = env.get_var("CHESS_PIECES") {
        s := style_of(v)
        if s >= 0 {
            return s
        }
    }
    s := file_style(config_path())
    if s >= 0 {
        return s
    }
    s = file_style(home_dir() + "/.config/chesz.json")
    if s >= 0 {
        return s
    }
    s = file_style(home_dir() + "/.config/chess.json")
    if s >= 0 {
        return s
    }
    2
}

// Where the resolved style came from (panel diagnostics).

pub func style_source() -> str {
    if let .some(v) = env.get_var("CHESS_PIECES") {
        if style_of(v) >= 0 {
            return "env"
        }
    }
    if file_style(config_path()) >= 0 {
        return "config"
    }
    if file_style(home_dir() + "/.config/chesz.json") >= 0 {
        return "config"
    }
    if file_style(home_dir() + "/.config/chess.json") >= 0 {
        return "config"
    }
    "default"
}

// First-run setup: create ~/.config/chesz.json with defaults when no
// config exists yet. Never overwrites.

pub func config_path() -> str {
    home_dir() + "/.config/chesz/config.json"
}

// Last PGN browser directory, remembered across launches in the same
// config file (pieces setting preserved on write).

pub func last_dir_in_json(text: str) -> str {
    j := json.parse_or_null(text)
    if !json.is_object(j) {
        return ""
    }
    v := json.path_get_or(j, "last_dir", json.null())
    if !json.is_string(v) {
        return ""
    }
    json.as_str(v)
}

func read_last_dir() -> str {
    if !fs.exists(config_path()) {
        return ""
    }
    match fs.read_to_string(config_path()) {
        .ok(t) => last_dir_in_json(t)
        .err(_) => ""
    }
}

pub func get_last_dir() -> str {
    d := read_last_dir()
    if d == "" {
        home_dir()
    } else {
        d
    }
}

func style_name(style: int) -> str {
    if style == 0 {
        "ascii"
    } else {
        if style == 1 {
            "glyphs"
        } else {
            "letters"
        }
    }
}

func esc_json(t: str) -> str {
    s := str.replace(t, "\\", "\\\\")
    str.replace(s, "\"", "\\\"")
}

func current_style() -> int {
    style := file_style(config_path())
    if style < 0 {
        style = file_style(home_dir() + "/.config/chesz.json")
    }
    if style < 0 {
        style = file_style(home_dir() + "/.config/chess.json")
    }
    if style < 0 {
        style = 2
    }
    style
}

func current_theme() -> int {
    theme := theme_in_json_file(config_path())
    if theme < 0 {
        theme = 0
    }
    theme
}

func save_config(style: int, theme: int, dir: str) -> str {
    match fs.mkdir_all(home_dir() + "/.config/chesz") {
        .ok(_) => 0
        .err(_) => 0 - 1
    }
    match fs.write(config_path(), "{\"pieces\": \"" + style_name(style) + "\", \"theme\": \"" + theme_name(theme) + "\", \"last_dir\": \"" + esc_json(dir) + "\"}\n") {
        .ok(_) => 0
        .err(_) => 0 - 1
    }
    config_path()
}

pub func set_last_dir(dir: str) -> str {
    save_config(current_style(), current_theme(), dir)
}

pub func set_theme(name: str) -> str {
    id := theme_id(name)
    if id < 0 {
        return ""
    }
    save_config(current_style(), id, read_last_dir())
}

pub func ensure_config() -> str {
    cfg := config_path()
    if fs.exists(cfg) {
        return cfg
    }
    if fs.exists(home_dir() + "/.config/chesz.json") {
        return home_dir() + "/.config/chesz.json"
    }
    if fs.exists(home_dir() + "/.config/chess.json") {
        return home_dir() + "/.config/chess.json"
    }
    match fs.mkdir_all(home_dir() + "/.config/chesz") {
        .ok(_) => 0
        .err(_) => 0 - 1
    }
    match fs.write(cfg, "{\n  \"pieces\": \"letters\"\n}\n") {
        .ok(_) => 0
        .err(_) => 0 - 1
    }
    cfg
}

// 7x4 character art, shared silhouette both sides (ink reads side).
// Every row is exactly 7 cells; bases rhyme like a real set.

pub func ascii_art(v: int, sub: int) -> str {
    if v == 0 {
        return "       "
    }
    a := v
    if a < 0 {
        a = 0 - a
    }
    top := ascii_top(a)
    bot := ascii_bot(a)
    if sub == 0 {
        top
    } else {
        bot
    }
}

func ascii_top(a: int) -> str {
    if a == 1 {
        "  (_)  "
    } else {
        if a == 2 {
            "  .--  "
        } else {
            if a == 3 {
                "   o   "
            } else {
                if a == 4 {
                    "|_|_|_|"
                } else {
                    if a == 5 {
                        " o o o "
                    } else {
                        "   +   "
                    }
                }
            }
        }
    }
}

func ascii_bot(a: int) -> str {
    if a == 1 {
        " _|_|_ "
    } else {
        if a == 2 {
            " |__/, "
        } else {
            if a == 3 {
                "  _+_  "
            } else {
                " _|_|_ "
            }
        }
    }
}

func foot_row(mode: int) -> str {
    foot := "      a      b      c      d      e      f      g      h"
    if mode == 0 {
        foot
    } else {
        colors.dim(foot)
    }
}

// Captured pieces as two tray lines (pure): what White took
// (missing black) and what Black took. Letters in mode 0.

func start_count(pc: int) -> int {
    table := [0, 8, 2, 2, 2, 1]
    if pc < 0 || pc >= len(table) {
        2
    } else {
        table[pc]
    }
}

pub func captured(p: board.Pos, mode: int) -> [str] {
    w := [0, 0, 0, 0, 0, 0, 0]
    b := [0, 0, 0, 0, 0, 0, 0]
    i := 0
    while i < 64 {
        v := p.b[i]
        if v > 0 && v <= 6 {
            w[v] = w[v] + 1
        } else {
            if v < 0 && v >= 0 - 6 {
                a := 0 - v
                b[a] = b[a] + 1
            }
        }
        i = i + 1
    }
    wt := ""
    bt := ""
    pc := 5
    while pc >= 1 {
        n := 0
        while n < start_count(pc) - b[pc] {
            wt = wt + glyph_for(0 - pc, mode)
            n = n + 1
        }
        n = 0
        while n < start_count(pc) - w[pc] {
            bt = bt + glyph_for(pc, mode)
            n = n + 1
        }
        pc = pc - 1
    }
    if wt == "" {
        wt = "-"
    }
    if bt == "" {
        bt = "-"
    }
    ["W takes: " + wt, "B takes: " + bt]
}

// Last n plies, numbered ("12. Nf3"). total is the full ply count.

pub func movelist(sans: [str], total: int, n: int) -> [str] {
    out := []
    start := len(sans) - n
    if start < 0 {
        start = 0
    }
    i := start
    while i < len(sans) {
        ply := total - (len(sans) - i)
        num := ply / 2 + 1
        if ply % 2 == 0 {
            out = vec.push(out, str(num) + ". " + sans[i])
        } else {
            out = vec.push(out, str(num) + "... " + sans[i])
        }
        i = i + 1
    }
    out
}

// Eval bar: white win-% as a 16-tall strip beside the board rows.
// Rows 1..16 are the cell rows (top rank first); white fills from the
// bottom, exactly like the major GUIs. Pure: same rows in, rows out.

// Eval graph: one shade block per position (bucket-averaged to width),
// so the panel shows where the game swung. Pure over cached evals.

func graph_char(pct: int) -> str {
    lvl := pct * 8 / 100
    if lvl < 0 {
        lvl = 0
    }
    if lvl > 7 {
        lvl = 7
    }
    if lvl == 0 {
        "▁"
    } else {
        if lvl == 1 {
            "▂"
        } else {
            if lvl == 2 {
                "▃"
            } else {
                if lvl == 3 {
                    "▄"
                } else {
                    if lvl == 4 {
                        "▅"
                    } else {
                        if lvl == 5 {
                            "▆"
                        } else {
                            if lvl == 6 {
                                "▇"
                            } else {
                                "█"
                            }
                        }
                    }
                }
            }
        }
    }
}

pub func eval_graph(evals: [int], width: int) -> str {
    n := len(evals)
    if n == 0 || width <= 0 {
        return ""
    }
    out := ""
    i := 0
    while i < width {
        lo := i * n / width
        hi := (i + 1) * n / width
        if hi <= lo {
            hi = lo + 1
        }
        tot := 0
        k := lo
        while k < hi && k < n {
            tot = tot + evals[k]
            k = k + 1
        }
        out = out + graph_char(eval.win_pct(tot / (hi - lo)))
        i = i + 1
    }
    out
}

pub func fmt_cp(cp: int) -> str {
    a := cp
    neg := false
    if a < 0 {
        neg = true
        a = 0 - a
    }
    w := a / 100
    r := a % 100
    dec := str(r)
    if r < 10 {
        dec = "0" + dec
    }
    if neg {
        "-" + str(w) + "." + dec
    } else {
        "+" + str(w) + "." + dec
    }
}

pub func eval_line(cp: int, pct: int, mate: int) -> str {
    if mate > 0 {
        "Eval: mate " + str(mate) + " · White 100%"
    } else {
        if mate < 0 {
            "Eval: mated " + str(0 - mate) + " · White 0%"
        } else {
            "Eval: " + fmt_cp(cp) + " · White " + str(pct) + "%"
        }
    }
}

func bar_seg(white: bool, mode: int) -> str {
    if mode == 0 {
        if white {
            "#"
        } else {
            "."
        }
    } else {
        if white {
            colors.bright_white("█")
        } else {
            colors.dim("░")
        }
    }
}

func bar_part(rem: int, mode: int) -> str {
    if mode == 0 {
        if rem >= 5 {
            "#"
        } else {
            "."
        }
    } else {
        if rem >= 7 {
            colors.bright_white("▓")
        } else {
            if rem >= 4 {
                colors.bright_white("▒")
            } else {
                colors.bright_white("░")
            }
        }
    }
}

pub func with_bar(rows: [str], pct: int, mode: int) -> [str] {
    // Tenths of a row (0..160) so the boundary slides smoothly instead
    // of jumping whole ranks: full white rows from the bottom plus one
    // partial shade block (░▒▓) at the waterline.
    t := pct * 160 / 100
    if t < 0 {
        t = 0
    }
    if t > 160 {
        t = 160
    }
    full := t / 10
    rem := t % 10
    out := []
    i := 0
    while i < len(rows) {
        pre := "  "
        if i >= 1 && i <= 16 {
            from_bottom := 16 - i
            if from_bottom < full {
                pre = bar_seg(true, mode) + " "
            } else {
                if from_bottom == full && rem > 0 && full < 16 {
                    pre = bar_part(rem, mode) + " "
                } else {
                    pre = bar_seg(false, mode) + " "
                }
            }
        }
        out = vec.push(out, pre + rows[i])
        i = i + 1
    }
    out
}

pub func compose(rows: [str], side: [str], ox: int, oy: int) -> [str] {
    width := 0
    i := 0
    while i < len(rows) {
        w := len(colors.strip(rows[i]))
        if w > width {
            width = w
        }
        i = i + 1
    }
    out := []
    i = 0
    while i < oy {
        out = vec.push(out, "")
        i = i + 1
    }
    pad := rep_str(" ", ox)
    i = 0
    while i < len(rows) || i < len(side) {
        line := ""
        if i < len(rows) {
            line = rows[i] + rep_str(" ", width - len(colors.strip(rows[i])) + 2)
        } else {
            line = rep_str(" ", width + 2)
        }
        if i < len(side) {
            line = line + side[i]
        }
        out = vec.push(out, pad + line)
        i = i + 1
    }
    out
}
