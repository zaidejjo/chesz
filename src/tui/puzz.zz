// Puzzle mode: white to move and mate in one, three tries each.
// Any mating move solves it; burning all tries reveals the key.
// Owns the screen like game/watch (defer exit, nothing prints after).

import std.vec

import chesz.engine.ai
import chesz.engine.board
import chesz.engine.fen
import chesz.engine.moves
import chesz.engine.person
import chesz.engine.puzzles
import chesz.engine.san
import chesz.tui.board_view
import chesz.tui.game
import chesz.tui.pick
import tui.keys as tkeys
import tui.screen

func draw_puzzle(p: board.Pos, cursor: int, selected: int, targets: [int], idx: int, tries: int, note: str, mode: int, style: int) {
    rows := board_view.render(p, cursor, selected, targets, 0 - 1, 0 - 1, mode, style)
    side := []
    side = vec.push(side, "Puzzle " + str(idx + 1) + "/" + str(puzzles.count()))
    side = vec.push(side, puzzles.desc_at(idx))
    side = vec.push(side, "White to move and mate in 1")
    side = vec.push(side, "Tries left: " + str(tries))
    if len(note) > 0 {
        side = vec.push(side, note)
    }
    side = vec.push(side, "")
    side = vec.push(side, "arrows/hjkl move · enter select")
    side = vec.push(side, "q skip puzzle")
    game.draw_frame(rows, side)
}

func queenish(legal: [int], from: int, to: int) -> int {
    opts := board_view.find_moves(legal, from, to)
    if len(opts) == 0 {
        return 0
    }
    i := 0
    while i < len(opts) {
        if moves.mv_promo(opts[i]) == 5 {
            return opts[i]
        }
        i = i + 1
    }
    opts[0]
}

func solve_loop(start: board.Pos, idx: int, mode: int, style: int) -> bool {
    p := start
    hist := []
    cursor := 28
    selected := 0 - 1
    targets := []
    tries := 3
    note := ""
    done := false
    won := false
    while !done {
        draw_puzzle(p, cursor, selected, targets, idx, tries, note, mode, style)
        k := tkeys.read()
        if k == tkeys.eof() || k == tkeys.ctrl_c() || k == 113 || k == tkeys.esc() {
            done = true
        } else {
            if k == 104 || k == 106 || k == 107 || k == 108 || k == tkeys.up() || k == tkeys.down() || k == tkeys.left() || k == tkeys.right() {
                dx := 0
                dy := 0
                if k == tkeys.left() || k == 104 {
                    dx = 0 - 1
                }
                if k == tkeys.right() || k == 108 {
                    dx = 1
                }
                if k == tkeys.up() || k == 107 {
                    dy = 1
                }
                if k == tkeys.down() || k == 106 {
                    dy = 0 - 1
                }
                cursor = board_view.step_cursor(cursor, dx, dy)
            } else {
                if k == tkeys.enter() || k == 32 {
                    if selected < 0 {
                        if p.b[cursor] > 0 {
                            selected = cursor
                            targets = board_view.targets_for(p, cursor)
                        }
                    } else {
                        if board_view.has_sq(targets, cursor) {
                            m := queenish(moves.gen_legal(p), selected, cursor)
                            if m != 0 {
                                q := moves.make(p, m)
                                h := ai.push_hist(hist, p)
                                if person.result(q, h) == 1 {
                                    won = true
                                    done = true
                                } else {
                                    tries = tries - 1
                                    selected = 0 - 1
                                    targets = []
                                    if tries <= 0 {
                                        sol := puzzles.find_mate(p)
                                        msg := "Out of tries"
                                        if sol != 0 {
                                            msg = "Out of tries — " + san.notation(p, sol)
                                        }
                                        pick.pick(msg, ["OK"])
                                        done = true
                                    } else {
                                        note = "Not mate — " + str(tries) + " tries left"
                                    }
                                }
                            }
                        } else {
                            if p.b[cursor] > 0 {
                                selected = cursor
                                targets = board_view.targets_for(p, cursor)
                            } else {
                                selected = 0 - 1
                                targets = []
                            }
                        }
                    }
                }
            }
        }
    }
    won
}

pub func run() -> bool {
    if !screen.is_tty() {
        return false
    }
    if !screen.enter() {
        return false
    }
    defer screen.exit()
    screen.hide()
    mode := screen.mode()
    board_view.ensure_config()
    style := board_view.resolve_style()
    solved := 0
    i := 0
    while i < puzzles.count() {
        if let .some(p) = fen.parse(puzzles.fen_at(i)) {
            if solve_loop(p, i, mode, style) {
                solved = solved + 1
            }
        }
        i = i + 1
    }
    pick.pick("Solved " + str(solved) + "/" + str(puzzles.count()), ["OK"])
    true
}
