// Full-TUI entry: floating palettes from the first screen — no ask
// menus when a terminal is present. Falls back (false) so main keeps
// its text menu for pipes. Palettes draw over the current screen and
// return indices; game/watch own the alternate screen themselves.

import std.fs
import std.term
import std.vec

import chesz.engine.board
import chesz.engine.moves
import chesz.engine.person
import chesz.engine.pgn
import chesz.engine.san
import chesz.engine.stats
import chesz.tui.board_view
import chesz.tui.browse
import chesz.tui.game
import chesz.tui.mouse
import chesz.tui.pick
import chesz.tui.puzz
import chesz.tui.watch
import tui.keys as tkeys
import tui.screen

// Palettes read raw bytes (Enter must arrive as 13, not cooked \n).

func raw_off() {
    match term.disable_raw() {
        .ok(_) => term.flush()
        .err(_) => term.flush()
    }
}

// Raw mode is global, not refcounted: game/watch disable it on exit,
// so re-arm every lobby turn or arrows echo as garbage mid-menu.

func raw_on() {
    match term.enable_raw() {
        .ok(_) => term.flush()
        .err(_) => term.flush()
    }
}

func engine_palette() -> person.Engine {
    opts := person.roster_names()
    c := pick.pick("Engine", opts)
    if c < 0 || c >= len(opts) {
        person.club()
    } else {
        person.by_index(c)
    }
}

// Play palette: engine names with the stored W-L-D record appended.

func play_engine_palette() -> person.Engine {
    base := person.roster_names()
    all := person.roster()
    opts := []
    i := 0
    while i < len(base) {
        line := base[i]
        rec := stats.line_for(all[i].name)
        if len(rec) > 0 {
            line = line + " [" + rec + "]"
        }
        opts = vec.push(opts, line)
        i = i + 1
    }
    c := pick.pick("Engine", opts)
    if c < 0 || c >= len(opts) {
        person.club()
    } else {
        person.by_index(c)
    }
}

func color_palette() -> int {
    // 1 white, -1 black, 0 cancelled.
    c := pick.pick("Play as", ["White", "Black"])
    if c == 1 {
        0 - 1
    } else {
        if c == 0 {
            1
        } else {
            0
        }
    }
}

func clock_palette() -> [int] {
    // [white ms, black ms, increment ms]; -1 runs casual (no clock).
    c := pick.pick("Clock", ["Casual (no clock)", "Blitz 5+0", "Rapid 15+10"])
    if c == 1 {
        [300000, 300000, 0]
    } else {
        if c == 2 {
            [900000, 900000, 10000]
        } else {
            [0 - 1, 0 - 1, 0]
        }
    }
}

// Load flow: browse (reopens at the remembered dir), parse the
// movetext, replay onto a live frame, then pick a side/engine/clock
// and continue the game from the final position.

func load_pgn_flow() {
    path := browse.browse(board_view.get_last_dir())
    if path == "" {
        return
    }
    match fs.read_to_string(path) {
        .ok(text) => {
            toks := pgn.tokens(text)
            p := board.setup()
            ms := []
            bad := ""
            i := 0
            while i < len(toks) {
                m := san.parse_san(p, toks[i])
                if m == 0 {
                    bad = toks[i]
                    i = len(toks)
                } else {
                    ms = vec.push(ms, m)
                    p = moves.make(p, m)
                    i = i + 1
                }
            }
            if bad != "" {
                pick.pick("Bad move in file: " + bad, ["OK"])
                return
            }
            if len(ms) == 0 {
                pick.pick("No moves in file", ["OK"])
                return
            }
            st := game.from_moves(ms)
            side := color_palette()
            if side == 0 {
                return
            }
            eng := play_engine_palette()
            clock := clock_palette()
            if side == 1 {
                game.run_loaded(st, eng, side, clock, "Human", eng.name)
                return
            }
            game.run_loaded(st, eng, side, clock, eng.name, "Human")
            return
        }
        .err(_) => {
            pick.pick("Cannot read file", ["OK"])
            return
        }
    }
}

func theme_palette() {
    names := board_view.all_theme_names()
    if len(names) == 0 {
        return
    }
    cur := board_view.theme_name(board_view.resolve_theme())
    style := board_view.resolve_style()
    mode := screen.mode()
    pos := board.setup()
    sel := 0
    i := 0
    while i < len(names) {
        if names[i] == cur {
            sel = i
        }
        i = i + 1
    }
    live := true
    while live {
        id := board_view.theme_id(names[sel])
        rows := board_view.render(pos, 0 - 1, 0 - 1, [], 0 - 1, 0 - 1, mode, style, id, board_view.load_custom(id))
        side := []
        side = vec.push(side, "Board theme (now: " + cur + ")")
        side = vec.push(side, "")
        i = 0
        while i < len(names) {
            mark := "  "
            if i == sel {
                mark = "> "
            }
            side = vec.push(side, mark + names[i])
            i = i + 1
        }
        side = vec.push(side, "")
        side = vec.push(side, "arrows choose · enter keep · esc back")
        game.draw_frame(rows, side)
        k := tkeys.read()
        if k == tkeys.enter() {
            _s := board_view.set_theme(names[sel])
            _s = _s
            live = false
        } else {
            if k == tkeys.esc() || k == tkeys.eof() {
                live = false
            } else {
                if k == tkeys.up() || k == 107 {
                    sel = sel - 1
                    if sel < 0 {
                        sel = len(names) - 1
                    }
                } else {
                    if k == tkeys.down() || k == 106 {
                        sel = (sel + 1) % len(names)
                    }
                }
            }
        }
    }
}

pub func run() -> bool {
    if !screen.is_tty() {
        return false
    }
    raw_on()
    defer raw_off()
    mouse.enable()
    again := true
    while again {
        raw_on()
        mouse.enable()
        c := pick.pick("ZZ Chess", ["Play vs engine", "Two humans (hotseat)", "Load PGN game", "Puzzles", "Board theme", "Watch engine vs engine", "Quit"])
        if c == 0 {
            side := color_palette()
            if side != 0 {
                played := game.run(play_engine_palette(), side, clock_palette())
                if !played {
                    again = false
                }
                mouse.enable()
            }
        } else {
            if c == 1 {
                played := game.run_duo(clock_palette())
                if !played {
                    again = false
                }
                mouse.enable()
            } else {
                if c == 2 {
                    load_pgn_flow()
                    mouse.enable()
                } else {
                    if c == 3 {
                        puzzled := puzz.run()
                        if !puzzled {
                            again = false
                        }
                        mouse.enable()
                    } else {
                        if c == 4 {
                            theme_palette()
                        } else {
                            if c == 5 {
                                w := engine_palette()
                                b := engine_palette()
                                watched := watch.run(w, b)
                                if !watched {
                                    again = false
                                }
                                mouse.enable()
                            } else {
                                again = false
                            }
                        }
                    }
                }
            }
        }
    }
    mouse.disable()
    true
}
