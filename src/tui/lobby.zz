// Full-TUI entry: floating palettes from the first screen — no ask
// menus when a terminal is present. Falls back (false) so main keeps
// its text menu for pipes. Palettes draw over the current screen and
// return indices; game/watch own the alternate screen themselves.

import std.fs
import std.str
import std.term
import std.vec

import ask
import chesz.engine.achieve
import chesz.engine.board
import chesz.engine.moves
import chesz.engine.netproto
import chesz.engine.person
import chesz.engine.pgn
import chesz.engine.san
import chesz.engine.stats
import chesz.engine.suspend
import chesz.engine.tourney
import chesz.tui.board_view
import chesz.tui.browse
import chesz.tui.drill
import chesz.tui.game
import chesz.tui.lesson
import chesz.tui.mouse
import chesz.tui.netgame
import chesz.tui.pick
import chesz.tui.puzz
import chesz.tui.watch
import tui.keys as tkeys
import tui.screen

// Palettes read raw bytes (Enter must arrive as 13, not cooked \n).

func raw_off() {
    match term.disable_raw() {
        .ok(_) => term.flush()
        .err(_) => term.flush()
    }
}

// Raw mode is global, not refcounted: game/watch disable it on exit,
// so re-arm every lobby turn or arrows echo as garbage mid-menu.

func raw_on() {
    match term.enable_raw() {
        .ok(_) => term.flush()
        .err(_) => term.flush()
    }
}

func engine_palette() -> person.Engine {
    opts := person.roster_names()
    c := pick.pick("Engine", opts)
    if c < 0 || c >= len(opts) {
        person.club()
    } else {
        person.by_index(c)
    }
}

// Play palette: engine names with the stored W-L-D record appended.

func play_engine_palette() -> person.Engine {
    base := person.roster_names()
    all := person.roster()
    opts := []
    i := 0
    while i < len(base) {
        line := base[i]
        rec := stats.line_for(all[i].name)
        if len(rec) > 0 {
            line = line + " [" + rec + "]"
        }
        opts = vec.push(opts, line)
        i = i + 1
    }
    c := pick.pick("Engine", opts)
    if c < 0 || c >= len(opts) {
        person.club()
    } else {
        person.by_index(c)
    }
}

func color_palette() -> int {
    // 1 white, -1 black, 0 cancelled.
    c := pick.pick("Play as", ["White", "Black"])
    if c == 1 {
        0 - 1
    } else {
        if c == 0 {
            1
        } else {
            0
        }
    }
}

pub func clock_of(mins: int, inc_secs: int) -> [int] {
    [mins * 60000, mins * 60000, inc_secs * 1000]
}

// Clock odds: uneven minutes per side (e.g. human 10 vs engine 2).
// Maps to [white, black, inc] by your color. Pure, tested.

pub func clock_odds(my_side: int, my_mins: int, op_mins: int, inc_s: int) -> [int] {
    mine := my_mins * 60000
    theirs := op_mins * 60000
    if my_side == 1 {
        [mine, theirs, inc_s * 1000]
    } else {
        [theirs, mine, inc_s * 1000]
    }
}

func custom_clock() -> [int] {
    mins_opts := ["1 min", "3 min", "5 min", "10 min", "15 min", "30 min", "60 min"]
    mins_val := [1, 3, 5, 10, 15, 30, 60]
    m := pick.pick("Minutes per side", mins_opts)
    if m < 0 || m >= len(mins_val) {
        return [0 - 1, 0 - 1, 0]
    }
    inc_opts := ["+0s", "+1s", "+2s", "+3s", "+5s", "+10s", "+30s"]
    inc_val := [0, 1, 2, 3, 5, 10, 30]
    s := pick.pick("Increment", inc_opts)
    if s < 0 || s >= len(inc_val) {
        return [0 - 1, 0 - 1, 0]
    }
    clock_of(mins_val[m], inc_val[s])
}

func clock_palette() -> [int] {
    clock_palette_side(1)
}

func odds_clock(my_side: int) -> [int] {
    min_opts := ["1 min", "2 min", "3 min", "5 min", "10 min", "15 min", "30 min", "60 min"]
    min_val := [1, 2, 3, 5, 10, 15, 30, 60]
    m := pick.pick("Your minutes", min_opts)
    if m < 0 || m >= len(min_val) {
        return [0 - 1, 0 - 1, 0]
    }
    o := pick.pick("Opponent minutes", min_opts)
    if o < 0 || o >= len(min_val) {
        return [0 - 1, 0 - 1, 0]
    }
    inc_opts := ["+0s", "+1s", "+2s", "+3s", "+5s", "+10s", "+30s"]
    inc_val := [0, 1, 2, 3, 5, 10, 30]
    s := pick.pick("Increment", inc_opts)
    if s < 0 || s >= len(inc_val) {
        return [0 - 1, 0 - 1, 0]
    }
    clock_odds(my_side, min_val[m], min_val[o], inc_val[s])
}

func clock_palette_side(my_side: int) -> [int] {
    // [white ms, black ms, increment ms]; -1 runs casual (no clock).
    c := pick.pick("Clock", ["Casual (no clock)", "Blitz 5+0", "Rapid 15+10", "Custom…", "Odds (uneven)…"])
    if c == 1 {
        [300000, 300000, 0]
    } else {
        if c == 2 {
            [900000, 900000, 10000]
        } else {
            if c == 3 {
                custom_clock()
            } else {
                if c == 4 {
                    odds_clock(my_side)
                } else {
                    [0 - 1, 0 - 1, 0]
                }
            }
        }
    }
}

// Handicap: the engine starts minus one queenside piece (rook odds
// also drop its queenside castling). 0 plays even.

func handicap_palette() -> int {
    c := pick.pick("Handicap", ["Even game", "Knight odds", "Bishop odds", "Rook odds"])
    if c == 1 {
        2
    } else {
        if c == 2 {
            3
        } else {
            if c == 3 {
                4
            } else {
                0
            }
        }
    }
}

// Load flow: browse (reopens at the remembered dir), parse the
// movetext, replay onto a live frame, then pick a side/engine/clock
// and continue the game from the final position.

func load_pgn_flow() {
    path := browse.browse(board_view.get_last_dir())
    if path == "" {
        return
    }
    match fs.read_to_string(path) {
        .ok(text) => {
            toks := pgn.tokens(text)
            p := board.setup()
            ms := []
            bad := ""
            i := 0
            while i < len(toks) {
                m := san.parse_san(p, toks[i])
                if m == 0 {
                    bad = toks[i]
                    i = len(toks)
                } else {
                    ms = vec.push(ms, m)
                    p = moves.make(p, m)
                    i = i + 1
                }
            }
            if bad != "" {
                pick.pick("Bad move in file: " + bad, ["OK"])
                return
            }
            if len(ms) == 0 {
                pick.pick("No moves in file", ["OK"])
                return
            }
            parts := str.split(path, "/")
            name := parts[len(parts) - 1]
            if pick.pick(name + ": " + str(len(ms)) + " moves", ["Play", "Cancel"]) != 0 {
                return
            }
            st := game.from_moves(ms)
            side := color_palette()
            if side == 0 {
                return
            }
            eng := play_engine_palette()
            clock := clock_palette()
            if side == 1 {
                game.run_loaded(st, eng, side, clock, "Human", eng.name)
                return
            }
            game.run_loaded(st, eng, side, clock, eng.name, "Human")
            return
        }
        .err(_) => {
            pick.pick("Cannot read file", ["OK"])
            return
        }
    }
}

// Suspended game: rebuild the live frame from the SAN trail with the
// saved clocks, then pick a side/engine and continue. Repetition
// history past the last-12 window does not survive (see suspend.zz).

func resume_flow() {
    if !suspend.has_save() {
        pick.pick("No suspended game", ["OK"])
        return
    }
    text := suspend.load_text()
    if suspend.fen_in(text) == "" && len(suspend.sans_in(text)) == 0 {
        pick.pick("No suspended game", ["OK"])
        return
    }
    st := game.load_suspend()
    if len(st.sans) == 0 {
        pick.pick("Suspended game is empty", ["OK"])
        return
    }
    side := color_palette()
    if side == 0 {
        return
    }
    eng := play_engine_palette()
    clock := [st.wms, st.bms, st.inc]
    if side == 1 {
        game.run_loaded(st, eng, side, clock, "Human", eng.name)
        return
    }
    game.run_loaded(st, eng, side, clock, eng.name, "Human")
    return
}

// Tournament: round-robin over every personality, alternating colors,
// crosstable at the end. Engine clocks make this native-fast;
// the VM takes its time (Master thinks 3s a move).

func tournament_flow() {
    names := person.roster_names()
    n := len(names)
    mat := []
    i := 0
    while i < n * n {
        mat = vec.push(mat, 0 - 1)
        i = i + 1
    }
    a := 0
    while a < n {
        b := a + 1
        while b < n {
            r1 := tourney.play_game(person.by_index(a), person.by_index(b), 40)
            if r1 == 1 {
                mat[a * n + b] = 2
                mat[b * n + a] = 0
            } else {
                if r1 == 2 {
                    mat[a * n + b] = 0
                    mat[b * n + a] = 2
                } else {
                    mat[a * n + b] = 1
                    mat[b * n + a] = 1
                }
            }
            r2 := tourney.play_game(person.by_index(b), person.by_index(a), 40)
            if r2 == 1 {
                mat[b * n + a] = 2
                mat[a * n + b] = 0
            } else {
                if r2 == 2 {
                    mat[b * n + a] = 0
                    mat[a * n + b] = 2
                } else {
                    mat[b * n + a] = 1
                    mat[a * n + b] = 1
                }
            }
            b = b + 1
        }
        a = a + 1
    }
    lines := tourney.table(names, mat, n)
    msg := str.join(lines, "\n")
    pick.pick(msg, ["OK"])
}

// Online LAN game: host deals color + clock on a port, or join a
// host:port. Address input needs cooked stdin, so drop raw mode for
// the prompt and re-arm after (same dance as game/watch exits).

func online_flow() {
    c := pick.pick("Online (LAN)", ["Host a game", "Join a game"])
    if c == 0 {
        side := color_palette()
        if side == 0 {
            return
        }
        clock := clock_palette()
        port := netproto.default_port()
        p := pick.pick("Port", ["8377 (default)", "Custom…"])
        if p == 1 {
            raw_off()
            text := ask.text("Port", "8377", |s: str| len(s) >= 2)
            raw_on()
            mouse.enable()
            match int(text) {
                .some(n) => {
                    if n > 0 && n < 65536 {
                        port = n
                    } else {
                        port = port
                    }
                }
                .none => port = port
            }
        }
        played := netgame.host(port, side, clock)
        if !played {
            _o := pick.pick("Online needs a terminal", ["OK"])
            _o = _o
        }
        mouse.enable()
    } else {
        if c == 1 {
            raw_off()
            addr := ask.text("Host address (host:port)", "127.0.0.1:8377", |s: str| len(s) >= 3)
            raw_on()
            mouse.enable()
            if addr == "" {
                return
            }
            played := netgame.join(addr)
            if !played {
                _o := pick.pick("Online needs a terminal", ["OK"])
                _o = _o
            }
            mouse.enable()
        }
    }
}

func trophies_flow() {
    lines := achieve.trophy_lines(achieve.load_csv())
    msg := str.join(lines, "\n")
    pick.pick(msg, ["OK"])
}

func theme_palette() {
    names := board_view.all_theme_names()
    if len(names) == 0 {
        return
    }
    cur := board_view.theme_name(board_view.resolve_theme())
    style := board_view.resolve_style()
    mode := screen.mode()
    pos := board.setup()
    sel := 0
    i := 0
    while i < len(names) {
        if names[i] == cur {
            sel = i
        }
        i = i + 1
    }
    live := true
    while live {
        id := board_view.theme_id(names[sel])
        rows := board_view.render(pos, 0 - 1, 0 - 1, [], 0 - 1, 0 - 1, mode, style, id, board_view.load_custom(id))
        side := []
        side = vec.push(side, "Board theme (now: " + cur + ")")
        side = vec.push(side, "")
        i = 0
        while i < len(names) {
            mark := "  "
            if i == sel {
                mark = "> "
            }
            side = vec.push(side, mark + names[i])
            i = i + 1
        }
        side = vec.push(side, "")
        side = vec.push(side, "arrows choose · enter keep · esc back")
        game.draw_frame(rows, side)
        k := tkeys.read()
        if k == tkeys.enter() {
            _s := board_view.set_theme(names[sel])
            _s = _s
            live = false
        } else {
            if k == tkeys.esc() || k == tkeys.eof() {
                live = false
            } else {
                if k == tkeys.up() || k == 107 {
                    sel = sel - 1
                    if sel < 0 {
                        sel = len(names) - 1
                    }
                } else {
                    if k == tkeys.down() || k == 106 {
                        sel = (sel + 1) % len(names)
                    }
                }
            }
        }
    }
}

pub func run() -> bool {
    if !screen.is_tty() {
        return false
    }
    raw_on()
    defer raw_off()
    mouse.enable()
    again := true
    while again {
        raw_on()
        mouse.enable()
        title := "Chesz · " + stats.profile()
        c := pick.pick(title, ["Play vs engine", "Two humans (hotseat)", "Load PGN game", "Puzzles", "Lessons", "Blunder drills", "Board theme", "Watch engine vs engine", "Tournament", "Resume game", "Play online (LAN)", "Trophies", "Quit"])
        if c == 0 {
            side := color_palette()
            if side != 0 {
                eng := play_engine_palette()
                odds := handicap_palette()
                clock := clock_palette_side(side)
                played := false
                if odds == 0 {
                    played = game.run(eng, side, clock)
                } else {
                    played = game.run_odds(eng, side, clock, odds)
                }
                if !played {
                    again = false
                }
                mouse.enable()
            }
        } else {
            if c == 1 {
                played := game.run_duo(clock_palette())
                if !played {
                    again = false
                }
                mouse.enable()
            } else {
                if c == 2 {
                    load_pgn_flow()
                    mouse.enable()
                } else {
                    if c == 3 {
                        puzzled := puzz.run()
                        if !puzzled {
                            again = false
                        }
                        mouse.enable()
                    } else {
                        if c == 4 {
                            lessoned := lesson.run()
                            if !lessoned {
                                again = false
                            }
                            mouse.enable()
                        } else {
                            if c == 5 {
                                drilled := drill.run()
                                if !drilled {
                                    again = false
                                }
                                mouse.enable()
                            } else {
                                if c == 6 {
                                    theme_palette()
                                } else {
                                    if c == 7 {
                                        w := engine_palette()
                                        b := engine_palette()
                                        watched := watch.run(w, b)
                                        if !watched {
                                            again = false
                                        }
                                        mouse.enable()
                                    } else {
                                        if c == 8 {
                                            tournament_flow()
                                            mouse.enable()
                                        } else {
                                            if c == 9 {
                                                resume_flow()
                                                mouse.enable()
                                            } else {
                                                if c == 10 {
                                                    online_flow()
                                                    mouse.enable()
                                                } else {
                                                    if c == 11 {
                                                        trophies_flow()
                                                        mouse.enable()
                                                    } else {
                                                        again = false
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    mouse.disable()
    true
}
