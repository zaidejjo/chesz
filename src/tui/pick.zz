// Arrow-safe option picker: centered win.box_at drawing plus a
// tkeys-decoded loop (arrows/hjkl/home/end/enter/esc). Replaces the
// toast win.palette/win.show widgets here because those read raw
// bytes but compare decoded codes — arrows arrive as ESC and cancel.
// Titles/options must stay ASCII (box padding counts bytes).

import std.str
import std.vec

import chesz.tui.board_view
import chesz.tui.mouse
import toast.win
import tui.keys as tkeys
import tui.screen

// Pure selection step (unit-testable): arrows, hjkl, home/end.

pub func step(sel: int, n: int, key: int) -> int {
    if key == tkeys.up() || key == 107 {
        if sel > 0 {
            sel - 1
        } else {
            0
        }
    } else {
        if key == tkeys.down() || key == 106 {
            if sel + 1 < n {
                sel + 1
            } else {
                n - 1
            }
        } else {
            if key == 1004 {
                0
            } else {
                if key == 1005 {
                    n - 1
                } else {
                    sel
                }
            }
        }
    }
}

func view(title: str, options: [str], sel: int) -> [str] {
    body := []
    body = vec.push(body, title)
    body = vec.push(body, "")
    i := 0
    while i < len(options) {
        mark := "  "
        if i == sel {
            mark = "> "
        }
        body = vec.push(body, mark + options[i])
        i = i + 1
    }
    w := 30
    i = 0
    while i < len(body) {
        L := len(body[i]) + 6
        if L > w {
            w = L
        }
        i = i + 1
    }
    win.box_at(0, 0, w, body, 1, 0)
}

// Modal pick; index or -1 on esc/EOF. Caller must own raw mode
// (lobby wraps it, game/watch enter the screen first).

pub func pick(title: str, options: [str]) -> int {
    if len(options) == 0 {
        return 0 - 1
    }
    sel := 0
    live := true
    while live {
        rows := view(title, options, sel)
        ox := 0
        oy := 0
        sz := screen.size()
        if len(sz) >= 2 {
            vw := 0
            i := 0
            while i < len(rows) {
                L := len(rows[i])
                if L > vw {
                    vw = L
                }
                i = i + 1
            }
            if sz[0] > vw {
                ox = (sz[0] - vw) / 2
            }
            if sz[1] > len(rows) {
                oy = (sz[1] - len(rows)) / 2
            }
        }
        frame := board_view.compose(rows, [], ox, oy)
        screen.clear()
        screen.write(str.join(frame, "\r\n"))
        screen.flush()
        ev := mouse.read()
        if mouse.is_mouse(ev) {
            if ev[1] == 0 {
                idx := (ev[3] - 1 - oy) - 2
                if idx >= 0 && idx < len(options) {
                    return idx
                }
            }
        } else {
            k := ev[0]
            if k == tkeys.enter() {
                return sel
            }
            if k == tkeys.esc() || k == tkeys.eof() {
                return 0 - 1
            }
            sel = step(sel, len(options), k)
        }
    }
    0 - 1
}
