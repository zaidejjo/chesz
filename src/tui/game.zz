// Retained board UI: owns the screen, dispatches single keys, stacks
// a status panel under the position. Engine-only game logic
// (person.result, book, search); presentation via tui.screen,
// tui.keys (aliased — ask ships its own keys.zz), tui.menu,
// tui.dialog, and a toast.flash on check. Non-TTY callers get `false`
// and should fall back to the ask flow in main.

import std.env
import std.fs
import std.str
import std.time
import std.vec

import chesz.engine.ai
import chesz.engine.board
import chesz.engine.book
import chesz.engine.eval
import chesz.engine.moves
import chesz.engine.person
import chesz.engine.pgn
import chesz.engine.san
import chesz.engine.stats
import chesz.tui.board_view
import chesz.tui.pick
import toast.toast
import tui.keys as tkeys
import tui.screen

pub struct Frame {
    pos: board.Pos,
    hist: [int],
    sans: [str],
    played: [int],
    cursor: int,
    selected: int,
    targets: [int],
    last_from: int,
    last_to: int,
    hint: str,
    hlast: int,
    after: int,
    show_bar: bool,
    bar_cp: int,
    bar_pct: int,
    bar_mate: int,
    wms: int,
    bms: int,
    inc: int,
    turn_ms: int,
    evals: [int],
}

func fresh_frame(human_side: int) -> Frame {
    cur := 12
    if human_side == 0 - 1 {
        cur = 52
    }
    Frame{pos: board.setup(), hist: [], sans: [], played: [], cursor: cur, selected: 0 - 1, targets: [], last_from: 0 - 1, last_to: 0 - 1, hint: "", hlast: 0 - 1, after: 0, show_bar: false, bar_cp: 0, bar_pct: 50, bar_mate: 0, wms: 0 - 1, bms: 0 - 1, inc: 0, turn_ms: 0, evals: []}
}

func replay(played: [int]) -> Frame {
    st := Frame{pos: board.setup(), hist: [], sans: [], played: [], cursor: 12, selected: 0 - 1, targets: [], last_from: 0 - 1, last_to: 0 - 1, hint: "", hlast: 0 - 1, after: 0, show_bar: false, bar_cp: 0, bar_pct: 50, bar_mate: 0, wms: 0 - 1, bms: 0 - 1, inc: 0, turn_ms: 0, evals: []}
    i := 0
    while i < len(played) {
        st.sans = vec.push(st.sans, san.notation(st.pos, played[i]))
        st.hist = ai.push_hist(st.hist, st.pos)
        st.pos = moves.make(st.pos, played[i])
        st.last_from = moves.mv_from(played[i])
        st.last_to = moves.mv_to(played[i])
        st.played = vec.push(st.played, played[i])
        i = i + 1
    }
    st.cursor = st.last_to
    st = refresh_bar(st)
    st
}

// Rebuild a live frame from bare move ints (PGN load): full SAN,
// history, eval cache and bar, ready to continue playing.

pub func from_moves(ms: [int]) -> Frame {
    st := fresh_frame(1)
    st = refresh_bar(st)
    st.evals = [st.bar_cp]
    i := 0
    while i < len(ms) {
        st = do_move(st, ms[i])
        i = i + 1
    }
    st
}

// Eval-bar cache: iterative-deepening 1→2 with a 200ms clock, run once
// per POSITION (never per frame — cursor movement stays free). Depth 1
// always completes, so the bar is instant; depth 2 refines it when the
// clock allows, and every move re-runs it, so the number keeps tracking
// the board instead of going stale. mate scores short-circuit to the
// waterline ends.
// Synchronous by design: ZZ green tasks exist (task.spawn) but
// try_join never observes completion and two in-flight spawns deadlock
// (zaidejjo/zz#398) — no background worker can deepen the bar while the
// engine thinks until upstream fixes polling.

pub func refresh_bar(st: Frame) -> Frame {
    ms := moves.gen_legal(st.pos)
    if len(ms) == 0 {
        if moves.in_check(st.pos) {
            if st.pos.side == 1 {
                st.bar_mate = 0 - 1
                st.bar_pct = 0
                st.bar_cp = 0 - 99999
            } else {
                st.bar_mate = 1
                st.bar_pct = 100
                st.bar_cp = 99999
            }
        } else {
            st.bar_mate = 0
            st.bar_pct = 50
            st.bar_cp = 0
        }
        return st
    }
    bar_eng := person.Engine{name: "Bar", elo: 0, depth: 2, movems: 200, variety: 0, blunder: 0, joker: false}
    r := person.search_root(bar_eng, st.pos, st.hist)
    if len(r.scores) == 0 {
        st.bar_cp = eval.white_cp(st.pos)
        st.bar_pct = eval.win_pct(st.bar_cp)
        st.bar_mate = 0
        return st
    }
    best := r.scores[0]
    i := 1
    while i < len(r.scores) {
        if r.scores[i] > best {
            best = r.scores[i]
        }
        i = i + 1
    }
    w := best
    if st.pos.side == 0 - 1 {
        w = 0 - best
    }
    if w > 90000 {
        st.bar_mate = 1
        st.bar_pct = 100
        st.bar_cp = 99999
    } else {
        if w < 0 - 90000 {
            st.bar_mate = 0 - 1
            st.bar_pct = 0
            st.bar_cp = 0 - 99999
        } else {
            cp := w - 8
            if st.pos.side == 0 - 1 {
                cp = w + 8
            }
            st.bar_cp = cp
            st.bar_pct = eval.win_pct(cp)
            st.bar_mate = 0
        }
    }
    st
}

func side_name(side: int) -> str {
    if side == 1 {
        "White"
    } else {
        "Black"
    }
}

func gfx_line(style: int, src: str) -> str {
    base := ""
    st := style
    if st == 1 {
        base = "Pieces: glyphs"
    } else {
        if st == 2 {
            base = "Pieces: letters"
        } else {
            base = "Pieces: ASCII art"
        }
    }
    base + " [" + src + "]"
}

func panel(st: Frame, eng: person.Engine, human_side: int, extra: str, mode: int, style: int, src: str) -> [str] {
    out := []
    out = vec.push(out, "ZZ Chess 0.2.0")
    if eng.elo == 0 {
        out = vec.push(out, eng.name)
    } else {
        out = vec.push(out, eng.name + " (" + str(eng.elo) + ")")
    }
    cl := clock_line(st)
    if len(cl) > 0 {
        out = vec.push(out, cl)
    }
    op := book.name_of(st.pos)
    if len(op) > 0 {
        out = vec.push(out, "Opening: " + op)
    }
    out = vec.push(out, gfx_line(style, src))
    if st.show_bar {
        out = vec.push(out, board_view.eval_line(st.bar_cp, st.bar_pct, st.bar_mate))
    }
    if len(st.evals) > 1 {
        out = vec.push(out, "Graph " + board_view.eval_graph(st.evals, 24))
    }
    res := person.result(st.pos, st.hist)
    if res != 0 {
        out = vec.push(out, "")
        out = vec.push(out, person.result_line(res))
        out = vec.push(out, "played " + str(len(st.played)) + " plies")
    } else {
        out = vec.push(out, "You play " + side_name(human_side))
        out = vec.push(out, "To move: " + side_name(st.pos.side))
        last := "—"
        if len(st.sans) > 0 {
            last = st.sans[len(st.sans) - 1]
        }
        out = vec.push(out, "Last: " + last + "  (" + str(len(st.played)) + " ply)")
        cap := board_view.captured(st.pos, mode)
        out = vec.push(out, cap[0])
        out = vec.push(out, cap[1])
        mv := board_view.movelist(st.sans, len(st.played), 4)
        i := 0
        while i < len(mv) {
            out = vec.push(out, mv[i])
            i = i + 1
        }
        if len(st.hint) > 0 {
            out = vec.push(out, "Coach: " + st.hint)
        }
        if len(extra) > 0 {
            out = vec.push(out, extra)
        }
    }
    out = vec.push(out, "")
    out = vec.push(out, "arrows/hjkl move · enter select")
    out = vec.push(out, "? coach hint · u undo · q resign · e eval")
    out
}

pub func draw_frame(rows: [str], side: [str]) {
    cols := 80
    rows_n := 24
    sz := screen.size()
    if len(sz) >= 2 {
        cols = sz[0]
        rows_n = sz[1]
    }
    ox := 0
    oy := 0
    frame := []
    if cols >= 94 {
        if cols > 92 {
            ox = (cols - 92) / 2
        }
        total := len(rows)
        if len(side) > total {
            total = len(side)
        }
        if rows_n > total {
            oy = (rows_n - total) / 2
        }
        frame = board_view.compose(rows, side, ox, oy)
    } else {
        below := rows
        below = vec.push(below, "")
        i := 0
        while i < len(side) {
            below = vec.push(below, side[i])
            i = i + 1
        }
        if cols > 60 {
            ox = (cols - 60) / 2
        }
        if rows_n > len(below) {
            oy = (rows_n - len(below)) / 2
        }
        frame = board_view.compose(below, [], ox, oy)
    }
    screen.clear()
    screen.write(str.join(frame, "\r\n"))
    screen.flush()
}

func draw(st: Frame, eng: person.Engine, human_side: int, extra: str, mode: int, style: int, src: str) {
    rows := board_view.render(st.pos, st.cursor, st.selected, st.targets, st.last_from, st.last_to, mode, style)
    if st.show_bar {
        rows = board_view.with_bar(rows, st.bar_pct, mode)
    }
    side := panel(st, eng, human_side, extra, mode, style, src)
    draw_frame(rows, side)
}

pub func do_move(st: Frame, m: int) -> Frame {
    st.sans = vec.push(st.sans, san.notation(st.pos, m))
    st.hist = ai.push_hist(st.hist, st.pos)
    st.pos = moves.make(st.pos, m)
    st.last_from = moves.mv_from(m)
    st.last_to = moves.mv_to(m)
    st.played = vec.push(st.played, m)
    st.cursor = st.last_to
    st.selected = 0 - 1
    st.targets = []
    st.hint = ""
    if moves.in_check(st.pos) && person.result(st.pos, st.hist) == 0 {
        toasted := toast.top("Check!", 2, 900)
        if toasted < 0 {
            st.hint = "Check!"
        }
    }
    st = tick_clock(st)
    st = refresh_bar(st)
    st.evals = vec.push(st.evals, st.bar_cp)
    st
}

// Clock deduct: the mover pays the elapsed think plus gains the
// increment. No live ticking — the blocking key reader cannot redraw
// mid-thought — so time settles when the move lands.

func tick_clock(st: Frame) -> Frame {
    if st.wms < 0 {
        return st
    }
    if st.turn_ms > 0 {
        el := time.now_ms() - st.turn_ms
        if el < 0 {
            el = 0
        }
        if st.pos.side == 1 {
            st.wms = st.wms - el
        } else {
            st.bms = st.bms - el
        }
        if st.wms < 0 {
            st.wms = 0
        }
        if st.bms < 0 {
            st.bms = 0
        }
    }
    if st.pos.side == 1 {
        st.wms = st.wms + st.inc
    } else {
        st.bms = st.bms + st.inc
    }
    st.turn_ms = time.now_ms()
    st
}

pub func fmt_ms(ms: int) -> str {
    t := ms
    if t < 0 {
        t = 0
    }
    sec := t / 1000
    m := sec / 60
    r := sec % 60
    tail := str(r)
    if r < 10 {
        tail = "0" + tail
    }
    str(m) + ":" + tail
}

pub func clock_line(st: Frame) -> str {
    if st.wms < 0 {
        ""
    } else {
        line := "Clock: W " + fmt_ms(st.wms) + " · B " + fmt_ms(st.bms)
        if st.inc > 0 {
            line = line + " (+" + str(st.inc / 1000) + ")"
        }
        line
    }
}

// 0 none, 1 white flagged, 2 black flagged.

pub func flagged(st: Frame) -> int {
    if st.wms < 0 {
        return 0
    }
    if st.wms <= 0 {
        return 1
    }
    if st.bms <= 0 {
        return 2
    }
    0
}

func flag_line(f: int) -> str {
    if f == 1 {
        "0-1 Black wins on time"
    } else {
        if f == 2 {
            "1-0 White wins on time"
        } else {
            ""
        }
    }
}

func pick_promo(legal: [int], from: int, to: int) -> int {
    opts := board_view.find_moves(legal, from, to)
    if len(opts) == 0 {
        return 0
    }
    if moves.mv_promo(opts[0]) == 0 {
        return opts[0]
    }
    c := pick.pick("Promote to", ["Queen", "Rook", "Bishop", "Knight"])
    if c < 0 {
        return 0
    }
    want := 5
    if c == 1 {
        want = 4
    } else {
        if c == 2 {
            want = 3
        } else {
            if c == 3 {
                want = 2
            }
        }
    }
    i := 0
    while i < len(opts) {
        if moves.mv_promo(opts[i]) == want {
            return opts[i]
        }
        i = i + 1
    }
    opts[0]
}

func key_dx(k: int) -> int {
    if k == tkeys.left() || k == 104 {
        0 - 1
    } else {
        if k == tkeys.right() || k == 108 {
            1
        } else {
            0
        }
    }
}

func key_dy(k: int) -> int {
    if k == tkeys.up() || k == 107 {
        1
    } else {
        if k == tkeys.down() || k == 106 {
            0 - 1
        } else {
            0
        }
    }
}

// Shared loop: engine games (duo=false, one human side) and hotseat
// (duo=true, both sides human). Returns the final frame; cursor
// -1000 means quit-to-menu mid-game.

func game_loop(st: Frame, eng: person.Engine, human_side: int, duo: bool, mode: int, style: int, src: str) -> Frame {
    quit := false
    while !quit {
        hs := human_side
        if duo {
            hs = st.pos.side
        }
        fl := flagged(st)
        res := person.result(st.pos, st.hist)
        if fl != 0 || res != 0 {
            line := flag_line(fl)
            if fl == 0 {
                line = person.result_line(res)
            }
            draw(st, eng, hs, line, mode, style, src)
            c := pick.pick(line, ["Review", "Rematch", "Done"])
            if c == 0 {
                st.after = 1
            } else {
                if c == 1 {
                    st.after = 2
                } else {
                    st.after = 0
                }
            }
            quit = true
        } else {
            if duo || st.pos.side == human_side {
                st = human_frame(st, eng, hs, mode, style, src, duo)
                if st.cursor == 0 - 1000 {
                    quit = true
                }
            } else {
                draw(st, eng, hs, "thinking… (" + eng.name + " d" + str(eng.depth) + " " + str(eng.movems) + "ms)", mode, style, src)
                m := book.probe(st.pos)
                dt := 0 - 1
                if m == 0 {
                    t0 := time.now_ms()
                    m = person.best_move_for(eng, st.pos, st.hist)
                    dt = time.now_ms() - t0
                }
                st = do_move(st, m)
                if dt >= 0 {
                    st.hint = eng.name + " " + str(dt) + "ms"
                }
                if st.hlast >= 0 {
                    st.cursor = st.hlast
                }
            }
        }
    }
    st
}

func with_clock(st: Frame, clock: [int]) -> Frame {
    st.wms = clock[0]
    st.bms = clock[1]
    st.inc = clock[2]
    st
}

func start_frame(human_side: int, clock: [int]) -> Frame {
    st := fresh_frame(human_side)
    st = with_clock(st, clock)
    st = refresh_bar(st)
    st.evals = [st.bar_cp]
    st.turn_ms = time.now_ms()
    st
}

// Shared screen session: the report (and PGN save notice) print to a
// cooked terminal below, so the exit stays explicit — never deferred.

func finish(st: Frame, eng: person.Engine, human_side: int, duo: bool, white: str, black: str) -> int {
    if !screen.is_tty() {
        return 0
    }
    if !screen.enter() {
        return 0
    }
    screen.hide()
    mode := screen.mode()
    board_view.ensure_config()
    style := board_view.resolve_style()
    src := board_view.style_source()
    st = game_loop(st, eng, human_side, duo, mode, style, src)
    if st.after == 1 {
        review_loop(st)
        c := pick.pick("Reviewed", ["Rematch", "Done"])
        if c == 0 {
            st.after = 2
        } else {
            st.after = 0
        }
    }
    screen.exit()
    opp := ""
    delta := 0
    if !duo {
        delta = note_result(st, eng, human_side)
        opp = eng.name
    }
    show_report(st, white, black, opp, delta)
    st.after
}

pub func run(eng: person.Engine, human_side: int, clock: [int]) -> bool {
    if !screen.is_tty() {
        return false
    }
    flip := human_side
    again := true
    while again {
        st := start_frame(flip, clock)
        code := 0
        if flip == 1 {
            code = finish(st, eng, flip, false, "Human", eng.name)
        } else {
            code = finish(st, eng, flip, false, eng.name, "Human")
        }
        if code == 2 {
            flip = 0 - flip
        } else {
            again = false
        }
    }
    true
}

pub func run_duo(clock: [int]) -> bool {
    if !screen.is_tty() {
        return false
    }
    again := true
    while again {
        st := start_frame(1, clock)
        code := finish(st, person.human(), 1, true, "Human", "Human")
        if code == 2 {
            again = true
        } else {
            again = false
        }
    }
    true
}

// Continue a loaded game: clock + turn stamp on the replayed frame,
// then the normal loop, report and save.

pub func run_loaded(st: Frame, eng: person.Engine, human_side: int, clock: [int], white: str, black: str) -> bool {
    if !screen.is_tty() {
        return false
    }
    st = with_clock(st, clock)
    st.turn_ms = time.now_ms()
    code := finish(st, eng, human_side, false, white, black)
    if code != 2 {
        return true
    }
    flip := 0 - human_side
    again := true
    while again {
        st2 := start_frame(flip, clock)
        c2 := 0
        if flip == 1 {
            c2 = finish(st2, eng, flip, false, "Human", eng.name)
        } else {
            c2 = finish(st2, eng, flip, false, eng.name, "Human")
        }
        if c2 == 2 {
            flip = 0 - flip
        } else {
            again = false
        }
    }
    true
}

// Post-game review: step through the played moves on the big board.
// Pure reconstruction (make-only, no search), so scrubbing is instant.

func review_loop(st: Frame) {
    mode := screen.mode()
    style := board_view.resolve_style()
    idx := len(st.played)
    quit := false
    while !quit {
        p := board.setup()
        k := 0
        while k < idx {
            p = moves.make(p, st.played[k])
            k = k + 1
        }
        rows := board_view.render(p, 0 - 1, 0 - 1, [], 0 - 1, 0 - 1, mode, style)
        label := "Start position"
        if idx > 0 {
            label = move_no(idx - 1) + st.sans[idx - 1]
        }
        side := [label + "  (" + str(idx) + "/" + str(len(st.played)) + ")", "", "left/right step · q done"]
        draw_frame(rows, side)
        t := tkeys.read()
        if t == tkeys.eof() || t == tkeys.ctrl_c() || t == tkeys.esc() || t == 113 {
            quit = true
        } else {
            if t == tkeys.left() || t == 104 {
                if idx > 0 {
                    idx = idx - 1
                }
            } else {
                if t == tkeys.right() || t == 108 {
                    if idx < len(st.played) {
                        idx = idx + 1
                    }
                }
            }
        }
    }
}

// Threat radar: mate-in-1 replies and hanging queens, checked once per
// turn (never per keypress). Mate scan only resolves checking replies,
// so it stays cheap: makes + king tests for all, full results for checks.

func mate_threat(p: board.Pos, human_side: int) -> str {
    q := p
    q.side = 0 - human_side
    ms := moves.gen_legal(q)
    i := 0
    while i < len(ms) {
        r := moves.make(q, ms[i])
        if moves.in_check(r) {
            res := person.result(r, [])
            if res == 1 && human_side == 0 - 1 {
                return san.notation(q, ms[i])
            }
            if res == 2 && human_side == 1 {
                return san.notation(q, ms[i])
            }
        }
        i = i + 1
    }
    ""
}

func queen_hangs(p: board.Pos, human_side: int) -> bool {
    want := 5 * human_side
    i := 0
    while i < 64 {
        if p.b[i] == want {
            if moves.is_attacked(p.b, i, 0 - human_side) && !moves.is_attacked(p.b, i, human_side) {
                return true
            }
        }
        i = i + 1
    }
    false
}

pub func threat_line(p: board.Pos, human_side: int) -> str {
    line := ""
    m := mate_threat(p, human_side)
    if m != "" {
        line = "Mate threat: " + m
    }
    if queen_hangs(p, human_side) {
        if len(line) > 0 {
            line = line + " · queen hangs"
        } else {
            line = "Queen hangs"
        }
    }
    line
}

// One human turn: cursor loop until a move is made. Returns the frame;
// cursor -1000 signals quit-to-menu (checked by run()).

func human_frame(st: Frame, eng: person.Engine, human_side: int, mode: int, style: int, src: str, duo: bool) -> Frame {
    th := threat_line(st.pos, human_side)
    if len(th) > 0 {
        if len(st.hint) > 0 {
            st.hint = st.hint + " · " + th
        } else {
            st.hint = th
        }
    }
    done := false
    while !done {
        draw(st, eng, human_side, "", mode, style, src)
        k := tkeys.read()
        if k == tkeys.eof() || k == tkeys.ctrl_c() {
            st.cursor = 0 - 1000
            done = true
        } else {
            if k == 113 {
                if pick.pick("Resign?", ["Resign", "Keep playing"]) == 0 {
                    st.cursor = 0 - 1000
                    done = true
                }
            } else {
                if k == tkeys.esc() {
                    st.selected = 0 - 1
                    st.targets = []
                } else {
                    if k == 104 || k == 106 || k == 107 || k == 108 || k == tkeys.up() || k == tkeys.down() || k == tkeys.left() || k == tkeys.right() {
                        st.cursor = board_view.step_cursor(st.cursor, key_dx(k), key_dy(k))
                    } else {
                        if k == tkeys.enter() || k == 32 {
                            st = press(st, human_side)
                            if st.selected == 0 - 2 {
                                st.selected = 0 - 1
                                done = true
                            }
                        } else {
                            if k == 63 {
                                st.hint = hint_for(st)
                            } else {
                                if k == 117 {
                                    if duo {
                                        st = undo_n(st, human_side, 1)
                                    } else {
                                        st = undo(st, human_side)
                                    }
                                } else {
                                    if k == 101 {
                                        st.show_bar = !st.show_bar
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    st
}

// Enter/space: select own piece, or move to a target. A completed move
// sets selected to -2 (move-done sentinel, translated by human_frame).

func press(st: Frame, human_side: int) -> Frame {
    if st.selected < 0 {
        v := st.pos.b[st.cursor]
        if v * human_side > 0 {
            st.selected = st.cursor
            st.targets = board_view.targets_for(st.pos, st.cursor)
        }
        return st
    }
    if board_view.has_sq(st.targets, st.cursor) {
        legal := moves.gen_legal(st.pos)
        m := pick_promo(legal, st.selected, st.cursor)
        if m != 0 {
            st = do_move(st, m)
            st.hlast = st.last_to
            st.selected = 0 - 2
            return st
        }
    }
    v := st.pos.b[st.cursor]
    if v * human_side > 0 {
        st.selected = st.cursor
        st.targets = board_view.targets_for(st.pos, st.cursor)
    } else {
        st.selected = 0 - 1
        st.targets = []
    }
    st
}

func slice_moves(played: [int], n: int) -> [int] {
    out := []
    i := 0
    while i < n && i < len(played) {
        out = vec.push(out, played[i])
        i = i + 1
    }
    out
}

func undo(st: Frame, human_side: int) -> Frame {
    undo_n(st, human_side, 2)
}

func undo_n(st: Frame, human_side: int, n: int) -> Frame {
    if st.pos.side != human_side || len(st.played) < n {
        return st
    }
    st2 := replay(slice_moves(st.played, len(st.played) - n))
    st2.cursor = st.cursor
    st2.show_bar = st.show_bar
    // Eval history runs parallel to played (+1 seed): drop the same tail
    // so the report never reads a removed position.
    st2.evals = slice_moves(st.evals, len(st.evals) - n)
    st2.wms = st.wms
    st2.bms = st.bms
    st2.inc = st.inc
    st2.turn_ms = time.now_ms()
    st2
}

func hint_for(st: Frame) -> str {
    m := person.best_move_for(person.expert(), st.pos, st.hist)
    if m == 0 {
        ""
    } else {
        san.notation(st.pos, m)
    }
}

// Post-game report: result, per-side accuracy from the cached eval
// history, and each side's worst move. Accuracy is chess.com-flavored
// without floats: every move scores 100 - 3 * win%-points-dropped
// (mover perspective, clamped), averaged.

func move_no(ply: int) -> str {
    num := ply / 2 + 1
    if ply % 2 == 0 {
        str(num) + ". "
    } else {
        str(num) + "... "
    }
}

// [accuracy, moves, worst_ply, worst_loss] for one side. evals[i] is
// the cached white-cp after i plies (seed + one per move).

func acc_of(evals: [int], side: int) -> [int] {
    tot := 0
    n := 0
    wl := 0 - 1
    wp := 0 - 1
    i := 0
    while i + 1 < len(evals) {
        mover := 1
        if i % 2 == 1 {
            mover = 0 - 1
        }
        if mover == side {
            b := eval.win_pct(evals[i])
            a := eval.win_pct(evals[i + 1])
            mb := b
            ma := a
            if mover == 0 - 1 {
                mb = 100 - b
                ma = 100 - a
            }
            loss := mb - ma
            if loss < 0 {
                loss = 0
            }
            if loss > 100 {
                loss = 100
            }
            sc := 100 - loss * 3
            if sc < 0 {
                sc = 0
            }
            tot = tot + sc
            n = n + 1
            if wl < 0 || loss > wl {
                wl = loss
                wp = i
            }
        }
        i = i + 1
    }
    acc := 100
    if n > 0 {
        acc = tot / n
    }
    [acc, n, wp, wl]
}

func acc_line(name: str, r: [int]) -> str {
    if r[1] == 0 {
        name + " accuracy — (no moves)"
    } else {
        unit := " moves"
        if r[1] == 1 {
            unit = " move"
        }
        name + " accuracy " + str(r[0]) + "% over " + str(r[1]) + unit
    }
}

func worst_line(name: str, r: [int], sans: [str]) -> str {
    if r[1] == 0 || r[2] < 0 || r[2] >= len(sans) {
        ""
    } else {
        name + " worst: " + move_no(r[2]) + sans[r[2]] + " (-" + str(r[3]) + "%)"
    }
}

pub func result_str(st: Frame) -> str {
    fl := flagged(st)
    if fl == 1 {
        "0-1 Black wins on time"
    } else {
        if fl == 2 {
            "1-0 White wins on time"
        } else {
            res := person.result(st.pos, st.hist)
            if res == 0 {
                "unfinished"
            } else {
                person.result_line(res)
            }
        }
    }
}

pub func report(st: Frame) -> [str] {
    out := []
    out = vec.push(out, "Chesz report — " + result_str(st))
    out = vec.push(out, "Moves played: " + str(len(st.played)))
    w := acc_of(st.evals, 1)
    b := acc_of(st.evals, 0 - 1)
    out = vec.push(out, acc_line("White", w))
    out = vec.push(out, acc_line("Black", b))
    line := worst_line("White", w, st.sans)
    if len(line) > 0 {
        out = vec.push(out, line)
    }
    line = worst_line("Black", b, st.sans)
    if len(line) > 0 {
        out = vec.push(out, line)
    }
    if len(st.played) > 0 {
        out = vec.push(out, board_view.eval_line(st.bar_cp, st.bar_pct, st.bar_mate))
    }
    out
}

// Record one finished engine game (human perspective). Unfinished
// quits record nothing.

pub func note_result(st: Frame, eng: person.Engine, human_side: int) -> int {
    fl := flagged(st)
    res := person.result(st.pos, st.hist)
    if fl == 0 && res == 0 {
        return 0
    }
    hwon := false
    draw := false
    if fl == 1 {
        hwon = human_side == 0 - 1
    } else {
        if fl == 2 {
            hwon = human_side == 1
        } else {
            if res == 1 {
                hwon = human_side == 1
            } else {
                if res == 2 {
                    hwon = human_side == 0 - 1
                } else {
                    draw = true
                }
            }
        }
    }
    score10 := 0
    if draw {
        score10 = 5
    } else {
        if hwon {
            score10 = 10
        }
    }
    my := stats.ladder()
    delta := 32 * (score10 - stats.expected10(my, eng.elo)) / 10
    stats.record(eng.name, score10)
    stats.ladder_add(delta)
    delta
}

func show_report(st: Frame, white: str, black: str, opp: str, delta: int) {
    lines := report(st)
    println("")
    i := 0
    while i < len(lines) {
        println(lines[i])
        i = i + 1
    }
    if opp != "" {
        rl := stats.line_for(opp)
        if len(rl) > 0 {
            println("Record vs " + opp + ": " + rl + " (W-L-D)")
        }
        if delta != 0 {
            tail := str(delta)
            if delta > 0 {
                tail = "+" + tail
            }
            println("You: " + str(stats.ladder()) + " (" + tail + ")")
        }
    }
    if len(st.played) > 0 {
        path := save_pgn(st, white, black)
        if len(path) > 0 {
            println("Saved PGN: " + path)
        } else {
            println("(PGN save failed)")
        }
    }
}

func games_home() -> str {
    match env.home_dir() {
        .some(h) => h + "/.config/chesz/games"
        .none => "./chesz_games"
    }
}

// Auto-save every played game beside the config. Never overwrites
// (millisecond filename); "" when the disk says no.

func save_pgn(st: Frame, white: str, black: str) -> str {
    dir := games_home()
    match fs.mkdir_all(dir) {
        .ok(_) => 0
        .err(_) => 0 - 1
    }
    res := pgn.result_of(person.result(st.pos, st.hist), flagged(st))
    path := dir + "/game_" + str(time.now_ms()) + ".pgn"
    match fs.write(path, pgn.build(white, black, st.sans, res)) {
        .ok(_) => path
        .err(_) => ""
    }
}
