// Blunder drills: your own worst moments, quizzed back. Scans up to
// 30 games/*.pgn for >=20-point eval drops, keeps the worst 8, and
// asks you to beat your old move (within 5 points of the pre-blunder
// eval, static — instant). Three tries each, then the static-best
// reply is revealed. Empty games/ prints a nudge instead.

import std.env
import std.fs
import std.str
import std.vec

import chesz.engine.board
import chesz.engine.drills
import chesz.engine.eval
import chesz.engine.fen
import chesz.engine.moves
import chesz.engine.pgn
import chesz.engine.san
import chesz.tui.board_view
import chesz.tui.game
import chesz.tui.pick
import tui.keys as tkeys
import tui.screen

func games_home() -> str {
    match env.home_dir() {
        .some(h) => h + "/.config/chesz/games"
        .none => "./chesz_games"
    }
}

func collect() -> [drills.Blunder] {
    all := []
    match fs.read_dir(games_home()) {
        .ok(files) => {
            n := 0
            i := 0
            while i < len(files) && n < 30 {
                name := files[i]
                if str.ends_with(name, ".pgn") || str.ends_with(name, ".PGN") {
                    match fs.read_to_string(games_home() + "/" + name) {
                        .ok(text) => {
                            found := drills.find_blunders(pgn.tokens(text), 20)
                            k := 0
                            while k < len(found) {
                                all = vec.push(all, found[k])
                                k = k + 1
                            }
                            n = n + 1
                        }
                        .err(_) => {
                            skip := 0
                            skip = skip
                        }
                    }
                }
                i = i + 1
            }
        }
        .err(_) => {
            skip := 0
            skip = skip
        }
    }
    drills.top_n(all, 8)
}

func mover_pre(p: board.Pos) -> int {
    w := eval.win_pct(eval.white_cp(p))
    if p.side == 1 {
        w
    } else {
        100 - w
    }
}

func mover_post(p: board.Pos, m: int) -> int {
    q := moves.make(p, m)
    w := eval.win_pct(eval.white_cp(q))
    if p.side == 1 {
        w
    } else {
        100 - w
    }
}

func draw_drill(p: board.Pos, cursor: int, selected: int, targets: [int], idx: int, total: int, b: drills.Blunder, tries: int, note: str, mode: int, style: int, theme: int, pal: [int]) {
    rows := board_view.render(p, cursor, selected, targets, 0 - 1, 0 - 1, mode, style, theme, pal)
    side := []
    side = vec.push(side, "Drill " + str(idx + 1) + "/" + str(total))
    side = vec.push(side, "You played " + b.played + " (-" + str(b.loss) + "%)")
    side = vec.push(side, "Find better")
    side = vec.push(side, "Tries left: " + str(tries))
    if len(note) > 0 {
        side = vec.push(side, note)
    }
    side = vec.push(side, "")
    side = vec.push(side, "arrows/hjkl move · enter select")
    side = vec.push(side, "q skip drill")
    _g := game.draw_frame(rows, side)
}

func queenish(legal: [int], from: int, to: int) -> int {
    opts := board_view.find_moves(legal, from, to)
    if len(opts) == 0 {
        return 0
    }
    i := 0
    while i < len(opts) {
        if moves.mv_promo(opts[i]) == 5 {
            return opts[i]
        }
        i = i + 1
    }
    opts[0]
}

func drill_loop(start: board.Pos, b: drills.Blunder, idx: int, total: int, mode: int, style: int, theme: int, pal: [int]) -> bool {
    p := start
    pre := mover_pre(p)
    cursor := 28
    selected := 0 - 1
    targets := []
    tries := 3
    note := ""
    done := false
    won := false
    while !done {
        draw_drill(p, cursor, selected, targets, idx, total, b, tries, note, mode, style, theme, pal)
        k := tkeys.read()
        if k == tkeys.eof() || k == tkeys.ctrl_c() || k == 113 || k == tkeys.esc() {
            done = true
        } else {
            if k == 104 || k == 106 || k == 107 || k == 108 || k == tkeys.up() || k == tkeys.down() || k == tkeys.left() || k == tkeys.right() {
                dx := 0
                dy := 0
                if k == tkeys.left() || k == 104 {
                    dx = 0 - 1
                }
                if k == tkeys.right() || k == 108 {
                    dx = 1
                }
                if k == tkeys.up() || k == 107 {
                    dy = 1
                }
                if k == tkeys.down() || k == 106 {
                    dy = 0 - 1
                }
                cursor = board_view.step_cursor(cursor, dx, dy)
            } else {
                if k == tkeys.enter() || k == 32 {
                    if selected < 0 {
                        v := p.b[cursor]
                        if (p.side == 1 && v > 0) || (p.side == 0 - 1 && v < 0) {
                            selected = cursor
                            targets = board_view.targets_for(p, cursor)
                        }
                    } else {
                        if board_view.has_sq(targets, cursor) {
                            m := queenish(moves.gen_legal(p), selected, cursor)
                            if m != 0 {
                                if mover_post(p, m) >= pre - 5 {
                                    won = true
                                    done = true
                                } else {
                                    tries = tries - 1
                                    selected = 0 - 1
                                    targets = []
                                    if tries <= 0 {
                                        sol := drills.best_reply(p)
                                        msg := "Out of tries"
                                        if sol != 0 {
                                            msg = "Out of tries — " + san.notation(p, sol)
                                        }
                                        pick.pick(msg, ["OK"])
                                        done = true
                                    } else {
                                        note = "Still worse — " + str(tries) + " tries left"
                                    }
                                }
                            }
                        } else {
                            v := p.b[cursor]
                            if (p.side == 1 && v > 0) || (p.side == 0 - 1 && v < 0) {
                                selected = cursor
                                targets = board_view.targets_for(p, cursor)
                            } else {
                                selected = 0 - 1
                                targets = []
                            }
                        }
                    }
                }
            }
        }
    }
    won
}

pub func run() -> bool {
    if !screen.is_tty() {
        return false
    }
    if !screen.enter() {
        return false
    }
    defer screen.exit()
    screen.hide()
    mode := screen.mode()
    board_view.ensure_config()
    style := board_view.resolve_style()
    theme := board_view.resolve_theme()
    pal := board_view.load_custom(theme)
    set := collect()
    if len(set) == 0 {
        pick.pick("No blunders mined — play some games first", ["OK"])
        return true
    }
    solved := 0
    i := 0
    while i < len(set) {
        if let .some(p) = fen.parse(set[i].fen) {
            if drill_loop(p, set[i], i, len(set), mode, style, theme, pal) {
                solved = solved + 1
            }
        }
        i = i + 1
    }
    pick.pick("Fixed " + str(solved) + "/" + str(len(set)) + " leaks", ["OK"])
    true
}
