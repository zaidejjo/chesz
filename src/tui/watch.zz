// Spectate: engine vs engine on the big board. Auto-advances with a
// quit poll between moves; q/esc/EOF leaves, anything else continues.

import std.str
import std.term
import std.vec

import chesz.engine.board
import chesz.engine.book
import chesz.engine.person
import chesz.tui.board_view
import chesz.tui.game
import chesz.tui.mouse
import chesz.tui.pick
import tui.keys as tkeys
import tui.screen

func watch_panel(st: game.Frame, eng_w: person.Engine, eng_b: person.Engine, mode: int, style: int, src: str) -> [str] {
    out := []
    out = vec.push(out, "Chesz — watch")
    if style == 1 {
        out = vec.push(out, "Pieces: glyphs [" + src + "]")
    } else {
        if style == 2 {
            out = vec.push(out, "Pieces: letters [" + src + "]")
        } else {
            out = vec.push(out, "Pieces: ASCII art [" + src + "]")
        }
    }
    out = vec.push(out, "White: " + eng_w.name + " (" + str(eng_w.elo) + ")")
    out = vec.push(out, "Black: " + eng_b.name + " (" + str(eng_b.elo) + ")")
    op := book.name_of(st.pos)
    if len(op) > 0 {
        out = vec.push(out, "Opening: " + op)
    }
    if st.show_bar {
        out = vec.push(out, board_view.eval_line(st.bar_cp, st.bar_pct, st.bar_mate))
    }
    if len(st.evals) > 1 {
        out = vec.push(out, "Graph " + board_view.eval_graph(st.evals, 24))
    }
    res := person.result(st.pos, st.hist)
    if res != 0 {
        out = vec.push(out, "")
        out = vec.push(out, person.result_line(res))
    } else {
        last := "—"
        if len(st.sans) > 0 {
            last = st.sans[len(st.sans) - 1]
        }
        out = vec.push(out, "Last: " + last + "  (" + str(len(st.played)) + " ply)")
        cap := board_view.captured(st.pos, mode)
        out = vec.push(out, cap[0])
        out = vec.push(out, cap[1])
    }
    out = vec.push(out, "")
    out = vec.push(out, "q quits · e eval · anything else steps")
    out
}

func watch_draw(st: game.Frame, eng_w: person.Engine, eng_b: person.Engine, mode: int, style: int, src: str, theme: int) -> game.Frame {
    rows := board_view.render(st.pos, 0 - 1, 0 - 1, [], st.last_from, st.last_to, mode, style, theme, st.tpal)
    if st.show_bar {
        rows = board_view.with_bar(rows, st.bar_pct, mode)
    }
    side := watch_panel(st, eng_w, eng_b, mode, style, src)
    g := game.draw_frame(rows, side)
    st.m_ox = g[0]
    st.m_oy = g[1]
    st
}

pub func run(eng_w: person.Engine, eng_b: person.Engine) -> bool {
    if !screen.is_tty() {
        return false
    }
    if !screen.enter() {
        return false
    }
    defer screen.exit()
    screen.hide()
    mouse.enable()
    mode := screen.mode()
    board_view.ensure_config()
    style := board_view.resolve_style()
    src := board_view.style_source()
    theme := board_view.resolve_theme()
    st := game.Frame{pos: board.setup(), hist: [], sans: [], played: [], cursor: 0, selected: 0 - 1, targets: [], last_from: 0 - 1, last_to: 0 - 1, hint: "", hlast: 0 - 1, after: 0, m_ox: 0, m_oy: 0, tpal: [], show_bar: false, bar_cp: 0, bar_pct: 50, bar_mate: 0, wms: 0 - 1, bms: 0 - 1, inc: 0, turn_ms: 0, evals: [], flipped: false, zen: false, blind: false}
    st.tpal = board_view.load_custom(theme)
    st = game.refresh_bar(st)
    quit := false
    while !quit {
        res := person.result(st.pos, st.hist)
        if res != 0 {
            st = watch_draw(st, eng_w, eng_b, mode, style, src, theme)
            pick.pick(person.result_line(res), ["OK"])
            quit = true
        } else {
            st = watch_draw(st, eng_w, eng_b, mode, style, src, theme)
            if let .ok(v) = term.poll(400) {
                if v {
                    k := tkeys.read()
                    if k == tkeys.eof() || k == 27 || k == 113 {
                        quit = true
                    } else {
                        if k == 101 {
                            st.show_bar = !st.show_bar
                        }
                    }
                }
            }
            if !quit {
                eng := eng_w
                if st.pos.side == 0 - 1 {
                    eng = eng_b
                }
                m := book.probe(st.pos)
                if m == 0 {
                    m = person.best_move_for(eng, st.pos, st.hist)
                }
                st = game.do_move(st, m)
            }
        }
    }
    mouse.disable()
    true
}
