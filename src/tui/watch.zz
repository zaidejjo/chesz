// Spectate: engine vs engine on the big board. Auto-advances with a
// quit poll between moves; q/esc/EOF leaves, anything else continues.

import std.str
import std.term
import std.vec

import chesz.engine.board
import chesz.engine.book
import chesz.engine.person
import chesz.tui.board_view
import chesz.tui.game
import chesz.tui.pick
import tui.keys as tkeys
import tui.screen

func watch_panel(st: game.Frame, eng_w: person.Engine, eng_b: person.Engine, mode: int) -> [str] {
    out := []
    out = vec.push(out, "ZZ Chess 0.2.0 — watch")
    if mode == 0 {
        out = vec.push(out, "Pieces: letters")
    } else {
        out = vec.push(out, "Pieces: ASCII art")
    }
    out = vec.push(out, "White: " + eng_w.name + " (" + str(eng_w.elo) + ")")
    out = vec.push(out, "Black: " + eng_b.name + " (" + str(eng_b.elo) + ")")
    res := person.result(st.pos, st.hist)
    if res != 0 {
        out = vec.push(out, "")
        out = vec.push(out, person.result_line(res))
    } else {
        last := "—"
        if len(st.sans) > 0 {
            last = st.sans[len(st.sans) - 1]
        }
        out = vec.push(out, "Last: " + last + "  (" + str(len(st.played)) + " ply)")
        cap := board_view.captured(st.pos, mode)
        out = vec.push(out, cap[0])
        out = vec.push(out, cap[1])
    }
    out = vec.push(out, "")
    out = vec.push(out, "q quits · anything else steps")
    out
}

func watch_draw(st: game.Frame, eng_w: person.Engine, eng_b: person.Engine, mode: int, style: int) {
    rows := board_view.render(st.pos, 0 - 1, 0 - 1, [], st.last_from, st.last_to, mode, style)
    side := watch_panel(st, eng_w, eng_b, mode)
    game.draw_frame(rows, side)
}

pub func run(eng_w: person.Engine, eng_b: person.Engine) -> bool {
    if !screen.is_tty() {
        return false
    }
    if !screen.enter() {
        return false
    }
    defer screen.exit()
    screen.hide()
    mode := screen.mode()
    board_view.ensure_config()
    style := board_view.resolve_style()
    st := game.Frame{pos: board.setup(), hist: [], sans: [], played: [], cursor: 0, selected: 0 - 1, targets: [], last_from: 0 - 1, last_to: 0 - 1, hint: ""}
    quit := false
    while !quit {
        res := person.result(st.pos, st.hist)
        if res != 0 {
            watch_draw(st, eng_w, eng_b, mode, style)
            pick.pick(person.result_line(res), ["OK"])
            quit = true
        } else {
            watch_draw(st, eng_w, eng_b, mode, style)
            if let .ok(v) = term.poll(400) {
                if v {
                    k := tkeys.read()
                    if k == tkeys.eof() || k == 27 || k == 113 {
                        quit = true
                    }
                }
            }
            if !quit {
                eng := eng_w
                if st.pos.side == 0 - 1 {
                    eng = eng_b
                }
                m := book.probe(st.pos)
                if m == 0 {
                    m = person.best_move_for(eng, st.pos, st.hist)
                }
                st = game.do_move(st, m)
            }
        }
    }
    true
}
