// Persistent records: per-engine W/L/D plus the player ladder,
// in ~/.config/chesz/stats.json. Reads tolerate a missing or corrupt
// file (defaults); writes rebuild from fixed keys so concurrent
// trillion-line histories are unnecessary — one small object.
// Text-core functions (ladder_in/rec_in/build_text) stay pure and
// unit-tested; only the thin wrappers touch the disk.

import std.env
import std.fs
import std.json
import std.str
import std.vec

pub func opps() -> [str] {
    ["Joker", "Novice", "Club", "Expert", "Master", "Grandmaster", "Adaptive"]
}

func stats_path() -> str {
    match env.home_dir() {
        .some(h) => h + "/.config/chesz/stats.json"
        .none => "./chesz_stats.json"
    }
}

func root_of(text: str) -> json {
    if text == "" {
        return json.null()
    }
    json.parse_or_null(text)
}

func get_int(j: json, key: str, fb: int) -> int {
    match json.get(j, key) {
        .ok(v) => json.as_int(v)
        .err(_) => fb
    }
}

pub func ladder_in(text: str) -> int {
    j := root_of(text)
    if !json.is_object(j) {
        return 800
    }
    get_int(j, "ladder", 800)
}

// Flat schema (zaidejjo/zz#402: nested objects are unreadable, so one
// top-level int per counter: Club_g, Club_w, Club_l, Club_d).

func reckey(opp: str, k: str) -> str {
    opp + "_" + k
}

pub func rec_in(text: str, opp: str) -> [int] {
    j := root_of(text)
    if !json.is_object(j) {
        return [0, 0, 0, 0]
    }
    [get_int(j, reckey(opp, "g"), 0), get_int(j, reckey(opp, "w"), 0), get_int(j, reckey(opp, "l"), 0), get_int(j, reckey(opp, "d"), 0)]
}

func read_text() -> str {
    match fs.read_to_string(stats_path()) {
        .ok(t) => t
        .err(_) => ""
    }
}

pub func ladder() -> int {
    ladder_in(read_text())
}

pub func rec_for(opp: str) -> [int] {
    rec_in(read_text(), opp)
}

pub func line_for(opp: str) -> str {
    r := rec_for(opp)
    if r[0] == 0 {
        ""
    } else {
        str(r[1]) + "-" + str(r[2]) + "-" + str(r[3])
    }
}

pub func build_text(lad: int, recs: [[int]]) -> str {
    build_text_full(lad, recs, 0, "")
}

pub func build_text_full(lad: int, recs: [[int]], streak_n: int, skind: str) -> str {
    names := opps()
    out := "{\"ladder\": " + str(lad)
    i := 0
    while i < len(names) && i < len(recs) {
        out = out + ", \"" + reckey(names[i], "g") + "\": " + str(recs[i][0])
        out = out + ", \"" + reckey(names[i], "w") + "\": " + str(recs[i][1])
        out = out + ", \"" + reckey(names[i], "l") + "\": " + str(recs[i][2])
        out = out + ", \"" + reckey(names[i], "d") + "\": " + str(recs[i][3])
        i = i + 1
    }
    out = out + ", \"streak_n\": " + str(streak_n) + ", \"skind\": \"" + skind + "\""
    out + "}\n"
}

func get_str(j: json, key: str) -> str {
    match json.get(j, key) {
        .ok(v) => {
            if json.is_string(v) {
                json.as_str(v)
            } else {
                ""
            }
        }
        .err(_) => ""
    }
}

// Streak core: [count, kind] where kind is "W"/"L"/"D"/"".

pub func streak_in(text: str) -> [int] {
    j := root_of(text)
    if !json.is_object(j) {
        return [0, 0]
    }
    n := get_int(j, "streak_n", 0)
    k := get_str(j, "skind")
    code := 0
    if k == "W" {
        code = 1
    } else {
        if k == "L" {
            code = 2
        } else {
            if k == "D" {
                code = 3
            }
        }
    }
    [n, code]
}

func streak_kind(code: int) -> str {
    if code == 1 {
        "W"
    } else {
        if code == 2 {
            "L"
        } else {
            if code == 3 {
                "D"
            } else {
                ""
            }
        }
    }
}

// Aggregate W-L-D over every opponent.

pub func totals_in(text: str) -> [int] {
    names := opps()
    g := 0
    w := 0
    l := 0
    d := 0
    i := 0
    while i < len(names) {
        r := rec_in(text, names[i])
        g = g + r[0]
        w = w + r[1]
        l = l + r[2]
        d = d + r[3]
        i = i + 1
    }
    [g, w, l, d]
}

// Lobby profile card: ladder + aggregate record + streak.

pub func profile_in(text: str) -> str {
    lad := ladder_in(text)
    t := totals_in(text)
    line := "Ladder " + str(lad)
    if t[0] == 0 {
        line = line + " · no games yet"
    } else {
        line = line + " · " + str(t[1]) + "-" + str(t[2]) + "-" + str(t[3]) + " over " + str(t[0])
    }
    st := streak_in(text)
    if st[0] >= 2 && st[1] > 0 {
        line = line + " · streak " + streak_kind(st[1]) + str(st[0])
    }
    line
}

pub func profile() -> str {
    profile_in(read_text())
}

pub func dump() -> str {
    read_text()
}

func write_full(lad: int, changed: str, rec: [int], streak_n: int, skind: str) {
    text := read_text()
    names := opps()
    recs := []
    i := 0
    while i < len(names) {
        r := rec_in(text, names[i])
        if names[i] == changed {
            r = rec
        }
        recs = vec.push(recs, r)
        i = i + 1
    }
    home := ""
    match env.home_dir() {
        .some(h) => home = h + "/.config/chesz"
        .none => home = "."
    }
    match fs.mkdir_all(home) {
        .ok(_) => 0
        .err(_) => 0 - 1
    }
    match fs.write(stats_path(), build_text_full(lad, recs, streak_n, skind)) {
        .ok(_) => 0
        .err(_) => 0 - 1
    }
}

func write_all(lad: int, changed: str, rec: [int]) {
    st := streak_in(read_text())
    write_full(lad, changed, rec, st[0], streak_kind(st[1]))
}

// score10: 10 win, 5 draw, 0 loss (tenths dodge floats).

pub func record(opp: str, score10: int) {
    r := rec_for(opp)
    r[0] = r[0] + 1
    kind := ""
    if score10 >= 10 {
        r[1] = r[1] + 1
        kind = "W"
    } else {
        if score10 >= 5 {
            r[3] = r[3] + 1
            kind = "D"
        } else {
            r[2] = r[2] + 1
            kind = "L"
        }
    }
    st := streak_in(read_text())
    nn := 1
    if streak_kind(st[1]) == kind {
        nn = st[0] + 1
    }
    write_full(ladder(), opp, r, nn, kind)
}

// Expected score in tenths for myelo vs oppelo (linear logistic
// stand-in; exact at even, saturates past ±400).

pub func expected10(myelo: int, oppelo: int) -> int {
    e := 5 + (myelo - oppelo) / 80
    if e < 0 {
        e = 0
    }
    if e > 10 {
        e = 10
    }
    e
}

pub func ladder_add(delta: int) -> int {
    v := ladder() + delta
    if v < 400 {
        v = 400
    }
    if v > 2400 {
        v = 2400
    }
    write_all(v, "", [0, 0, 0, 0])
    v
}
