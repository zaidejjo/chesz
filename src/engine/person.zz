// Rated personalities. One search, many strengths: depth + clock set
// the ceiling, `variety` (centipawn window around best) and `blunder`
// (per-mille random-move rate) bring it down to human. Joker plays
// uniform-random legal chess. Mate scores never enter the variety
// window — no personality "varieties" away a forced mate.

import std.time
import std.vec

import ai
import board
import moves
import rand
import stats
import tt

pub struct Engine {
    name: str,
    elo: int,
    depth: int,
    movems: int,
    variety: int,
    blunder: int,
    joker: bool,
}

pub func joker() -> Engine {
    Engine{name: "Joker", elo: 400, depth: 1, movems: 50, variety: 0, blunder: 1000, joker: true}
}

pub func human() -> Engine {
    Engine{name: "Human", elo: 0, depth: 0, movems: 0, variety: 0, blunder: 0, joker: false}
}

pub func novice() -> Engine {
    Engine{name: "Novice", elo: 800, depth: 1, movems: 200, variety: 150, blunder: 80, joker: false}
}

pub func club() -> Engine {
    Engine{name: "Club", elo: 1200, depth: 2, movems: 500, variety: 60, blunder: 25, joker: false}
}

pub func expert() -> Engine {
    Engine{name: "Expert", elo: 1600, depth: 3, movems: 1500, variety: 25, blunder: 8, joker: false}
}

pub func master() -> Engine {
    Engine{name: "Master", elo: 2000, depth: 4, movems: 3000, variety: 0, blunder: 0, joker: false}
}

// Grandmaster: depth 5 with the shared table (TT + killers carry the
// extra ply). Native-only in practice — the VM needs ~10x per ply
// down here — same deal Master already had, one rung further.

pub func grandmaster() -> Engine {
    Engine{name: "Grandmaster", elo: 2250, depth: 5, movems: 4000, variety: 0, blunder: 0, joker: false}
}

// Adaptive: reads the lobby ladder and plays at your level — depth by
// band, variety and blunder scaled down as you climb, so every game is
// close without ever throwing like Joker does.

pub func adaptive() -> Engine {
    rating := stats.ladder()
    depth := 1
    variety := 150
    blunder := 80
    if rating >= 2000 {
        depth = 5
        variety = 0
        blunder = 0
    } else {
        if rating >= 1800 {
            depth = 4
            variety = 0
            blunder = 0
        } else {
            if rating >= 1400 {
                depth = 3
                variety = 25
                blunder = 8
            } else {
                if rating >= 1000 {
                    depth = 2
                    variety = 60
                    blunder = 25
                }
            }
        }
    }
    Engine{name: "Adaptive", elo: rating, depth: depth, movems: 800, variety: variety, blunder: blunder, joker: false}
}

pub func roster() -> [Engine] {
    [joker(), novice(), club(), expert(), master(), grandmaster(), adaptive()]
}

pub func roster_names() -> [str] {
    ["Joker (~400, chaos)", "Novice (800)", "Club (1200)", "Expert (1600)", "Master (2000)", "Grandmaster (2250, native)", "Adaptive (your level)"]
}

pub func by_index(i: int) -> Engine {
    r := roster()
    if i < 0 || i >= len(r) {
        club()
    } else {
        r[i]
    }
}

func uniform(ms: [int]) -> int {
    (k, _) := rand.below(rand.auto_seed(), len(ms))
    ms[k]
}

// Score every root move at depth d (full window, negated).

func score_root(p: board.Pos, ms: [int], d: int, t: tt.TT) -> [int] {
    out := []
    i := 0
    while i < len(ms) {
        q := moves.make(p, ms[i])
        out = vec.push(out, 0 - ai.search(q, d - 1, 0 - 1000000, 1000000, 1, t))
        i = i + 1
    }
    out
}

// Score every root move at depth d, abandoning the tail when the
// deadline passes (deadline < 0 means no cap). Unsearched moves keep
// their previous scores, so the clock bounds overshoot to one move
// instead of one depth.

func score_root_capped(p: board.Pos, ms: [int], prev: [int], d: int, deadline: int, t: tt.TT) -> [int] {
    out := []
    i := 0
    while i < len(ms) {
        if deadline > 0 && time.now_ms() >= deadline {
            out = vec.push(out, prev[i])
        } else {
            q := moves.make(p, ms[i])
            out = vec.push(out, 0 - ai.search(q, d - 1, 0 - 1000000, 1000000, 1, t))
        }
        i = i + 1
    }
    out
}

// Reorder moves by their previous-iteration scores, best first
// (the poor engine's hash move). Index sort + gather keeps a parallel
// score array aligned through the permutation.

func order_idx(scores: [int]) -> [int] {
    idx := []
    i := 0
    while i < len(scores) {
        idx = vec.push(idx, i)
        i = i + 1
    }
    n := 1
    while n < len(idx) {
        key := idx[n]
        j := n - 1
        while j >= 0 && scores[idx[j]] < scores[key] {
            idx[j + 1] = idx[j]
            j = j - 1
        }
        idx[j + 1] = key
        n = n + 1
    }
    idx
}

func gather(v: [int], idx: [int]) -> [int] {
    out := []
    i := 0
    while i < len(idx) {
        out = vec.push(out, v[idx[i]])
        i = i + 1
    }
    out
}

func order_by_scores(ms: [int], scores: [int]) -> [int] {
    gather(ms, order_idx(scores))
}

func contains(v: [int], x: int) -> bool {
    i := 0
    while i < len(v) {
        if v[i] == x {
            return true
        }
        i = i + 1
    }
    false
}

pub struct Root {
    moves: [int],
    scores: [int],
    depth: int,
}

pub func best_move_for(eng: Engine, p: board.Pos, hist: [int]) -> int {
    all := moves.gen_legal(p)
    if len(all) == 0 {
        return 0
    }
    if eng.joker {
        return uniform(all)
    }
    (roll, _) := rand.below(rand.auto_seed(), 1000)
    if roll < eng.blunder {
        return uniform(all)
    }
    r := search_root(eng, p, hist)
    pick_in_window(r.moves, r.scores, eng.variety)
}

// One iterative-deepening run: repetition-filtered, ordered, scored.
// Returns the final root moves + scores + depth actually reached
// (the clock can stop the climb early; depth 1 always completes).

pub func search_root(eng: Engine, p: board.Pos, hist: [int]) -> Root {
    all := moves.gen_legal(p)
    if len(all) == 0 {
        return Root{moves: [], scores: [], depth: 0}
    }
    // Repetition filter first (shuffle loops bore everyone), falling
    // back to the full list when everything repeats.
    ms := []
    i := 0
    while i < len(all) {
        q := moves.make(p, all[i])
        if !ai.seen_before(hist, q.side, q.b) {
            ms = vec.push(ms, all[i])
        }
        i = i + 1
    }
    if len(ms) == 0 {
        ms = all
    }
    ms = ai.order_moves(p, ms)
    // One table for the whole iterative climb: deeper iterations reuse
    // shallower entries (depth-preferred replacement keeps the best).
    t := tt.new_tt()
    scores := score_root(p, ms, 1, t)
    if eng.depth <= 1 {
        tt.drop_tt(t)
        return Root{moves: ms, scores: scores, depth: 1}
    }
    start := time.now_ms()
    d := 2
    reached := 1
    while d <= eng.depth {
        if eng.movems > 0 && time.now_ms() - start >= eng.movems {
            d = eng.depth + 1
        } else {
            ix := order_idx(scores)
            ms = gather(ms, ix)
            scores = gather(scores, ix)
            dl := 0 - 1
            if eng.movems > 0 {
                dl = start + eng.movems
            }
            scores = score_root_capped(p, ms, scores, d, dl, t)
            reached = d
            d = d + 1
        }
    }
    tt.drop_tt(t)
    Root{moves: ms, scores: scores, depth: reached}
}

// Uniform draw among moves within `window` cp of best. Mating best
// (score > 90000) short-circuits to the mate itself.

pub func pick_in_window(ms: [int], scores: [int], window: int) -> int {
    best := 0 - 1000000
    i := 0
    while i < len(scores) {
        if scores[i] > best {
            best = scores[i]
        }
        i = i + 1
    }
    if best > 90000 {
        i = 0
        while i < len(scores) {
            if scores[i] == best {
                return ms[i]
            }
            i = i + 1
        }
        return ms[0]
    }
    cands := []
    i = 0
    while i < len(ms) {
        if scores[i] >= best - window {
            cands = vec.push(cands, ms[i])
        }
        i = i + 1
    }
    if len(cands) == 0 {
        return ms[0]
    }
    uniform(cands)
}

// Shared game result for every frontend: 0 ongoing, 1 white mates,
// 2 black mates, 3 stalemate, 4 fifty-move, 5 threefold, 6 material.

pub func result(p: board.Pos, hist: [int]) -> int {
    if p.half >= 100 {
        return 4
    }
    if ai.repetitions(hist, p) >= 3 {
        return 5
    }
    if ai.insufficient_material(p.b) {
        return 6
    }
    ms := moves.gen_legal(p)
    if len(ms) > 0 {
        return 0
    }
    if moves.in_check(p) {
        if p.side == 1 {
            return 2
        }
        return 1
    }
    3
}

pub func result_line(st: int) -> str {
    table := ["", "1-0 white mates", "0-1 black mates", "1/2-1/2 stalemate", "1/2-1/2 fifty-move rule", "1/2-1/2 threefold repetition", "1/2-1/2 dead position"]
    if st < 0 || st >= len(table) {
        "1/2-1/2 dead position"
    } else {
        table[st]
    }
}
