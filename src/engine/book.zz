// Tiny built-in opening book: 44 battle-tested replies keyed by
// placement + side. Single reply per key (deterministic, testable);
// personalities supply the variety. Main consults it before the
// engine while the game is young; UCI skips it (GUIs bring books).

import std.str

import board
import fen
import moves
import san

func keys() -> [str] {
    ["rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w", "rnbqkbnr/pppppppp/8/8/4P3/8/PPPP1PPP/RNBQKBNR b", "rnbqkbnr/pppppppp/8/8/3P4/8/PPP1PPPP/RNBQKBNR b", "rnbqkbnr/pppp1ppp/8/4p3/4P3/8/PPPP1PPP/RNBQKBNR w", "rnbqkbnr/pp1ppppp/8/2p5/4P3/8/PPPP1PPP/RNBQKBNR w", "rnbqkbnr/pppp1ppp/4p3/8/4P3/8/PPPP1PPP/RNBQKBNR w", "rnbqkbnr/ppp1pppp/8/3p4/3P4/8/PPP1PPPP/RNBQKBNR w", "rnbqkb1r/pppppppp/5n2/8/3P4/8/PPP1PPPP/RNBQKBNR w", "r1bqkbnr/pppp1ppp/2n5/4p3/4P3/5N2/PPPP1PPP/RNBQKB1R w", "rnbqkb1r/pppp1ppp/5n2/4p3/4P3/5N2/PPPP1PPP/RNBQKB1R w", "rnbqkbnr/pp2pppp/3p4/2p5/4P3/5N2/PPPP1PPP/RNBQKB1R w", "rnbqkbnr/pppppppp/8/8/2P5/8/PP1PPPPP/RNBQKBNR b", "rnbqkbnr/pppppppp/8/8/8/5N2/PPPPPPPP/RNBQKB1R b", "rnbqkbnr/pp1ppppp/2p5/8/4P3/8/PPPP1PPP/RNBQKBNR w", "rnbqkbnr/pp1ppppp/8/2p5/4P3/5N2/PPPP1PPP/RNBQKB1R b", "rnbqkbnr/ppp2ppp/4p3/3p4/3PP3/8/PPP2PPP/RNBQKBNR w", "rnbqkbnr/pp2pppp/2p5/3p4/3PP3/8/PPP2PPP/RNBQKBNR w", "r1bqk1nr/pppp1ppp/2n5/2b1p3/2B1P3/5N2/PPPP1PPP/RNBQK2R w", "rnbqkbnr/ppp1pppp/8/3p4/3P1B2/8/PPP1PPPP/RNQ1KBNR b", "rnbqkbnr/pp2pppp/3p4/2p5/3PP3/5N2/PPP2PPP/RNBQKB1R b", "rnbqkbnr/pp2pppp/3p4/8/3pP3/5N2/PPP2PPP/RNBQKB1R w", "rnbqkbnr/pp2pppp/3p4/8/3NP3/8/PPP2PPP/RNBQKB1R b", "rnbqkb1r/pp2pppp/3p1n2/8/3NP3/8/PPP2PPP/RNBQKB1R w", "rnbqkb1r/pp2pppp/3p1n2/8/3NP3/2N5/PPP2PPP/R1BQKB1R b", "rnbqkb1r/1p2pppp/p2p1n2/8/3NP3/2N5/PPP2PPP/R1BQKB1R w", "rnbqkbnr/ppp1pppp/8/3p4/2PP4/8/PP2PPPP/RNBQKBNR b", "rnbqkbnr/ppp2ppp/4p3/3p4/2PP4/8/PP2PPPP/RNBQKBNR w", "rnbqkb1r/ppp2ppp/4pn2/3p4/2PP4/2N5/PP2PPPP/R1BQKBNR b", "rnbqkb1r/ppp2ppp/4pn2/3p4/2PP4/2N5/PP2PPPP/R1BQKBNR w", "rnbqkb1r/pppppppp/5n2/8/2PP4/8/PP2PPPP/RNBQKBNR b", "rnbqkb1r/pppppp1p/5np1/8/2PP4/8/PP2PPPP/RNBQKBNR w", "rnbqkb1r/pppppp1p/5np1/8/2PP4/2N5/PP2PPPP/R1BQKBNR b", "rnbqk2r/ppppppbp/5np1/8/2PP4/2N5/PP2PPPP/R1BQKBNR w", "r1bqkbnr/pppp1ppp/2n5/4p3/3PP3/5N2/PPP2PPP/RNBQKB1R b", "r1bqkbnr/pppp1ppp/2n5/8/3pP3/5N2/PPP2PPP/RNBQKB1R w", "r1bqkbnr/pppp1ppp/2n5/8/3NP3/8/PPP2PPP/RNBQKB1R b", "rnbqkbnr/pp1ppppp/2p5/8/3PP3/8/PPP2PPP/RNBQKBNR b", "rnbqkbnr/pp2pppp/2p5/8/3Pp3/2N5/PPP2PPP/R1BQKBNR w", "rnbqkbnr/pp2pppp/2p5/8/3PN3/8/PPP2PPP/R1BQKBNR b", "rnbqkbnr/pppp1ppp/4p3/8/3PP3/8/PPP2PPP/RNBQKBNR b", "rnbqkbnr/ppp2ppp/4p3/3p4/3PP3/2N5/PPP2PPP/R1BQKBNR b", "rnbqkb1r/pppp1ppp/4pn2/8/2PP4/8/PP2PPPP/RNBQKBNR w", "rnbqkb1r/pppp1ppp/4pn2/8/2PP4/2N5/PP2PPPP/R1BQKBNR b", "rnbqk2r/pppp1ppp/4pn2/8/1bPP4/2N5/PP2PPPP/R1BQKBNR w"]
}

func replies() -> [str] {
    ["e2e4", "e7e5", "d7d5", "g1f3", "g1f3", "d2d4", "c2c4", "c2c4", "f1b5", "f3e5", "d2d4", "e7e5", "d7d5", "d2d4", "d7d6", "b1c3", "b1c3", "c2c3", "g8f6", "c5d4", "f3d4", "g8f6", "b1c3", "a7a6", "c1e3", "e7e6", "b1c3", "g8f6", "c1g5", "g7g6", "b1c3", "f8g7", "e2e4", "e5d4", "f3d4", "g8f6", "d7d5", "f3e4", "c8f5", "d7d5", "f8b4", "b1c3", "f8b4", "e2e3"]
}

pub func probe(p: board.Pos) -> int {
    parts := str.split(fen.generate(p), " ")
    if len(parts) < 2 {
        return 0
    }
    key := parts[0] + " " + parts[1]
    ks := keys()
    rs := replies()
    i := 0
    while i < len(ks) {
        if ks[i] == key {
            return san.parse_coord(rs[i], moves.gen_legal(p))
        }
        i = i + 1
    }
    0
}

// Opening name from the placement ("" when unrecognized — the panel
// hides the line). Rank fields index 0..7 top-down: [2] is rank 6,
// [3] rank 5, [4] rank 4.

pub func name_of(p: board.Pos) -> str {
    fields := str.split(fen.generate(p), " ")
    if len(fields) < 1 {
        return ""
    }
    ranks := str.split(fields[0], "/")
    if len(ranks) < 8 {
        return ""
    }
    if str.starts_with(ranks[3], "1B") {
        return "Ruy Lopez"
    }
    if str.starts_with(ranks[4], "2B") {
        return "Italian Game"
    }
    if str.starts_with(ranks[2], "p2p") {
        return "Najdorf Sicilian"
    }
    if ranks[1] == "ppppppbp" && ranks[2] == "5np1" {
        return "King's Indian Defence"
    }
    if ranks[3] == "2p5" {
        return "Sicilian Defence"
    }
    if ranks[4] == "2PP4" && ranks[3] == "3p4" {
        return "Queen's Gambit"
    }
    if ranks[2] == "4p3" && ranks[3] == "3p4" {
        return "French Defence"
    }
    if ranks[2] == "2p5" {
        return "Caro-Kann"
    }
    if ranks[4] == "3P1B2" {
        return "London System"
    }
    if ranks[4] == "4PP2" {
        return "King's Gambit"
    }
    ""
}
