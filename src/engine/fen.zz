// FEN import/export. Startpos:
// rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1
// parse() returns .none on malformed input, never throws.

import std.str

import board

pub func startpos() -> str {
    "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
}

pub func kiwipete() -> str {
    "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1"
}

func piece_val(c: str) -> int {
    if c == "P" {
        1
    } else {
        if c == "N" {
            2
        } else {
            if c == "B" {
                3
            } else {
                if c == "R" {
                    4
                } else {
                    if c == "Q" {
                        5
                    } else {
                        if c == "K" {
                            6
                        } else {
                            if c == "p" {
                                0 - 1
                            } else {
                                if c == "n" {
                                    0 - 2
                                } else {
                                    if c == "b" {
                                        0 - 3
                                    } else {
                                        if c == "r" {
                                            0 - 4
                                        } else {
                                            if c == "q" {
                                                0 - 5
                                            } else {
                                                if c == "k" {
                                                    0 - 6
                                                } else {
                                                    0
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

func digit(c: str) -> int {
    if c == "1" {
        1
    } else {
        if c == "2" {
            2
        } else {
            if c == "3" {
                3
            } else {
                if c == "4" {
                    4
                } else {
                    if c == "5" {
                        5
                    } else {
                        if c == "6" {
                            6
                        } else {
                            if c == "7" {
                                7
                            } else {
                                if c == "8" {
                                    8
                                } else {
                                    0 - 1
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

func file_num(c: str) -> int {
    if c == "a" {
        0
    } else {
        if c == "b" {
            1
        } else {
            if c == "c" {
                2
            } else {
                if c == "d" {
                    3
                } else {
                    if c == "e" {
                        4
                    } else {
                        if c == "f" {
                            5
                        } else {
                            if c == "g" {
                                6
                            } else {
                                if c == "h" {
                                    7
                                } else {
                                    0 - 1
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

func opt_int(s: str, fallback: int) -> int {
    match int(s) {
        .some(n) => n
        .none => fallback
    }
}

pub func parse(text: str) -> Option<board.Pos> {
    parts := str.split(str.trim(text), " ")
    if len(parts) < 4 {
        return .none
    }
    rows := str.split(parts[0], "/")
    if len(rows) != 8 {
        return .none
    }
    b := board.new_board()
    r := 0
    while r < 8 {
        row := rows[7 - r]
        f := 0
        i := 0
        ok := true
        while i < len(row) {
            c := row[i]
            d := digit(c)
            if d > 0 {
                f = f + d
            } else {
                v := piece_val(c)
                if v == 0 {
                    ok = false
                } else {
                    if f >= 8 {
                        ok = false
                    } else {
                        b[r * 8 + f] = v
                        f = f + 1
                    }
                }
            }
            i = i + 1
        }
        if !ok || f != 8 {
            return .none
        }
        r = r + 1
    }
    side := 1
    if parts[1] == "b" {
        side = 0 - 1
    } else {
        if parts[1] != "w" {
            return .none
        }
    }
    cast := 0
    if parts[2] != "-" {
        ci := 0
        while ci < len(parts[2]) {
            c := parts[2][ci]
            if c == "K" {
                cast = cast + 1
            } else {
                if c == "Q" {
                    cast = cast + 2
                } else {
                    if c == "k" {
                        cast = cast + 4
                    } else {
                        if c == "q" {
                            cast = cast + 8
                        } else {
                            return .none
                        }
                    }
                }
            }
            ci = ci + 1
        }
    }
    ep := 0 - 1
    if parts[3] != "-" {
        if len(parts[3]) != 2 {
            return .none
        }
        f := file_num(parts[3][0])
        match int(parts[3][1]) {
            .some(n) => {
                if f < 0 || n < 1 || n > 8 {
                    return .none
                }
                ep = f + (n - 1) * 8
            }
            .none => {
                return .none
            }
        }
    }
    half := 0
    full := 1
    if len(parts) >= 6 {
        half = opt_int(parts[4], 0)
        full = opt_int(parts[5], 1)
        if half < 0 || full < 1 {
            return .none
        }
    }
    .some(board.Pos{b: b, side: side, cast: cast, ep: ep, half: half, full: full})
}

pub func generate(p: board.Pos) -> str {
    out := ""
    r := 7
    while r >= 0 {
        empty := 0
        f := 0
        while f < 8 {
            v := p.b[r * 8 + f]
            if v == 0 {
                empty = empty + 1
            } else {
                if empty > 0 {
                    out = out + str(empty)
                    empty = 0
                }
                out = out + board.glyph(v)
            }
            f = f + 1
        }
        if empty > 0 {
            out = out + str(empty)
        }
        if r > 0 {
            out = out + "/"
        }
        r = r - 1
    }
    if p.side == 1 {
        out = out + " w"
    } else {
        out = out + " b"
    }
    if p.cast == 0 {
        out = out + " -"
    } else {
        rights := ""
        if (p.cast % 2) == 1 {
            rights = rights + "K"
        }
        if ((p.cast / 2) % 2) == 1 {
            rights = rights + "Q"
        }
        if ((p.cast / 4) % 2) == 1 {
            rights = rights + "k"
        }
        if ((p.cast / 8) % 2) == 1 {
            rights = rights + "q"
        }
        out = out + " " + rights
    }
    if p.ep < 0 {
        out = out + " -"
    } else {
        out = out + " " + board.sq_name(p.ep)
    }
    out + " " + str(p.half) + " " + str(p.full)
}
