// Chess in ZZ: full legal move generation (castling, en passant,
// promotion), check/checkmate/stalemate detection, and a negamax AI.
//
//   d_zz run examples/chess/main.zz          self-test + help
//   d_zz run examples/chess/main.zz perft    perft(1..3) vs known counts
//   d_zz run examples/chess/main.zz ai       AI vs AI, depth 2
//   d_zz run examples/chess/main.zz play     human (white) vs AI, moves like e2e4

import std.env
import std.fs
import std.str
import std.time
import std.vec

import ask
import chesz.engine.ai
import chesz.engine.board
import chesz.engine.book
import chesz.engine.explore as explore_mod
import chesz.engine.fen
import chesz.engine.moves
import chesz.engine.person
import chesz.engine.pgn
import chesz.engine.san
import chesz.engine.tourney
import chesz.tui.game
import chesz.tui.lesson
import chesz.tui.lobby
import chesz.uci.uci

func perft(p: board.Pos, d: int) -> int {
    if d == 0 {
        return 1
    }
    ms := moves.gen_legal(p)
    if d == 1 {
        return len(ms)
    }
    n := 0
    i := 0
    while i < len(ms) {
        n = n + perft(moves.make(p, ms[i]), d - 1)
        i = i + 1
    }
    n
}

func selftest() {
    p := board.setup()
    n1 := perft(p, 1)
    n2 := perft(p, 2)
    println("perft(1) = " + str(n1) + " (want 20)")
    println("perft(2) = " + str(n2) + " (want 400)")
    if n1 == 20 && n2 == 400 {
        println("movegen OK")
    } else {
        println("MOVEGEN BROKEN")
    }
    ms := moves.gen_legal(p)
    println("startpos legal moves: " + str(len(ms)) + " (want 20)")
    m := ai.best_move(p, 1, [])
    println("depth-1 pick: " + board.move_name(m))
}

func perft_check() {
    p := board.setup()
    d := 1
    while d <= 3 {
        n := perft(p, d)
        want := 0
        if d == 1 {
            want = 20
        } else {
            if d == 2 {
                want = 400
            } else {
                want = 8902
            }
        }
        mark := "OK"
        if n != want {
            mark = "FAIL"
        }
        println("perft(" + str(d) + ") = " + str(n) + " (want " + str(want) + ") " + mark)
        d = d + 1
    }
}

func play_game(eng_w: person.Engine, eng_b: person.Engine, max_ply: int) {
    p := board.setup()
    ply := 0
    done := false
    hist := []
    while ply < max_ply && !done {
        st := person.result(p, hist)
        if st != 0 {
            println(person.result_line(st))
            done = true
        } else {
            eng := eng_w
            if p.side == 0 - 1 {
                eng = eng_b
            }
            m := book.probe(p)
            if m == 0 {
                m = person.best_move_for(eng, p, hist)
            }
            name := san.notation(p, m)
            if p.side == 1 {
                print(str(ply / 2 + 1) + ". " + name + " ")
            } else {
                println(name)
            }
            hist = ai.push_hist(hist, p)
            p = moves.make(p, m)
            ply = ply + 1
        }
    }
    if !done {
        println("1/2-1/2 move cap")
    }
    board.show(p.b)
}

// Headless match for the gauntlet: 1 white wins, 2 black wins, 0 draw.

func play_match(eng_w: person.Engine, eng_b: person.Engine, max_ply: int) -> int {
    p := board.setup()
    hist := []
    ply := 0
    while ply < max_ply {
        st := person.result(p, hist)
        if st == 1 {
            return 1
        }
        if st == 2 {
            return 2
        }
        if st != 0 {
            return 0
        }
        eng := eng_w
        if p.side == 0 - 1 {
            eng = eng_b
        }
        m := book.probe(p)
        if m == 0 {
            m = person.best_move_for(eng, p, hist)
        }
        hist = ai.push_hist(hist, p)
        p = moves.make(p, m)
        ply = ply + 1
    }
    0
}

func gauntlet() {
    // Novice vs Club, home and away, twice: 4 games, 60 plies.
    wside := [1, 2, 1, 2]
    n2 := 0
    c2 := 0
    gi := 0
    while gi < 4 {
        w := person.by_index(wside[gi])
        b := person.by_index(3 - wside[gi])
        println(w.name + " (white) vs " + b.name + " (black)")
        r := play_match(w, b, 60)
        if r == 1 {
            println("1-0 " + w.name + " wins")
        } else {
            if r == 2 {
                println("0-1 " + b.name + " wins")
            } else {
                println("1/2-1/2 draw")
            }
        }
        if wside[gi] == 1 {
            // Novice white: r==1 feeds novice, r==2 feeds club.
            if r == 1 {
                n2 = n2 + 2
            } else {
                if r == 2 {
                    c2 = c2 + 2
                } else {
                    n2 = n2 + 1
                    c2 = c2 + 1
                }
            }
        } else {
            if r == 1 {
                c2 = c2 + 2
            } else {
                if r == 2 {
                    n2 = n2 + 2
                } else {
                    n2 = n2 + 1
                    c2 = c2 + 1
                }
            }
        }
        gi = gi + 1
    }
    edge := 0 - elo_of_pm(n2 * 1000 / 8)
    println("Novice " + fmt_pts(n2) + " / 4, Club " + fmt_pts(c2) + " / 4 — Club +" + str(edge) + " Elo over Novice")
}

pub func fmt_pts(p2: int) -> str {
    if p2 % 2 == 1 {
        str(p2 / 2) + ".5"
    } else {
        str(p2 / 2)
    }
}

// Score-per-mille to Elo diff, piecewise-linear on the logistic
// anchors (640,100) (760,200) (850,300) (910,400), caps at ±800.

pub func elo_of_pm(pm: int) -> int {
    if pm >= 1000 {
        return 800
    }
    if pm <= 0 {
        return 0 - 800
    }
    if pm == 500 {
        return 0
    }
    if pm > 500 {
        return upper_elo(pm)
    }
    0 - upper_elo(1000 - pm)
}

pub func upper_elo(pm: int) -> int {
    // pm in (500, 1000): walk the anchor segments.
    lo := [500, 640, 760, 850, 910]
    base := [0, 100, 200, 300, 400]
    num := [100, 100, 100, 100, 400]
    den := [140, 120, 90, 60, 90]
    i := 0
    while i + 1 < len(lo) && pm >= lo[i + 1] {
        i = i + 1
    }
    base[i] + num[i] * (pm - lo[i]) / den[i]
}

func play_human(eng: person.Engine, human_side: int) {
    p := board.setup()
    board.show(p.b)
    done := false
    hist := []
    while !done {
        st := person.result(p, hist)
        if st != 0 {
            println(person.result_line(st))
            done = true
        } else {
            if p.side == human_side {
                legal := moves.gen_legal(p)
                s := ask.text("your move (e2e4, O-O, hint, resign)", "", |s: str| len(s) >= 3)
                if s == "hint" {
                    hm := person.best_move_for(person.expert(), p, hist)
                    println("coach (" + person.expert().name + "): try " + san.notation(p, hm))
                } else {
                    if s == "resign" {
                        if ask.confirm("Resign this game?", false) {
                            if human_side == 1 {
                                println("0-1 resigned")
                            } else {
                                println("1-0 resigned")
                            }
                            done = true
                        }
                    } else {
                        m := san.parse_coord(s, legal)
                        if m == 0 {
                            println("illegal move, try again")
                        } else {
                            println("you: " + san.notation(p, m))
                            hist = ai.push_hist(hist, p)
                            p = moves.make(p, m)
                            board.show(p.b)
                        }
                    }
                }
            } else {
                t0 := time.now_ms()
                m := book.probe(p)
                tag := "book"
                if m == 0 {
                    m = person.best_move_for(eng, p, hist)
                    tag = str(time.now_ms() - t0) + "ms"
                }
                println("engine (" + eng.name + "): " + san.notation(p, m) + " [" + tag + "]")
                hist = ai.push_hist(hist, p)
                p = moves.make(p, m)
                board.show(p.b)
            }
        }
    }
}

func pick_engine() -> person.Engine {
    opts := person.roster_names()
    c := ask.select("Engine", opts)
    i := 0
    while i < len(opts) {
        if opts[i] == c {
            return person.by_index(i)
        }
        i = i + 1
    }
    person.club()
}

func menu() {
    again := true
    while again {
        c := ask.select("Chesz", ["Play vs engine (board UI)", "Play vs engine (text)", "Watch engine vs engine", "Self-test", "Quit"])
        if c == "Play vs engine (board UI)" {
            side := ask.select("Play as", ["White", "Black"])
            human := 1
            if side == "Black" {
                human = 0 - 1
            }
            if !game.run(pick_engine(), human, [0 - 1, 0 - 1, 0]) {
                play_human(person.club(), human)
            }
            again = ask.confirm("Back to menu?", true)
        } else {
            if c == "Play vs engine (text)" {
                side := ask.select("Play as", ["White", "Black"])
                human := 1
                if side == "Black" {
                    human = 0 - 1
                }
                play_human(pick_engine(), human)
                again = ask.confirm("Back to menu?", true)
            } else {
                if c == "Watch engine vs engine" {
                    play_game(pick_engine(), pick_engine(), 120)
                    again = ask.confirm("Back to menu?", true)
                } else {
                    if c == "Self-test" {
                        selftest()
                        again = ask.confirm("Back to menu?", true)
                    } else {
                        again = false
                    }
                }
            }
        }
    }
    println("bye!")
}

func analyze(fen_text: str) {
    match fen.parse(fen_text) {
        .some(p) => {
            board.show(p.b)
            r := person.search_root(person.expert(), p, [])
            n := 3
            if len(r.moves) < n {
                n = len(r.moves)
            }
            i := 0
            while i < n {
                println(str(i + 1) + ". " + san.notation(p, r.moves[i]) + " " + uci.score_line(r.scores[i]) + " (depth " + str(r.depth) + ")")
                i = i + 1
            }
            pv := ai.pv(p, 2, 4)
            if len(pv) > 0 {
                line := "PV:"
                q := p
                k := 0
                while k < len(pv) {
                    line = line + " " + san.notation(q, pv[k])
                    q = moves.make(q, pv[k])
                    k = k + 1
                }
                println(line)
            }
        }
        .none => println("bad FEN")
    }
}

// Opening explorer: mine games/*.pgn, recognize the position at ply 6
// via book.name_of, print a games/white% table.

func explore() {
    home := ""
    match env.home_dir() {
        .some(h) => home = h + "/.config/chesz/games"
        .none => home = "./chesz_games"
    }
    match fs.read_dir(home) {
        .ok(all) => {
            openings := []
            results := []
            i := 0
            while i < len(all) {
                n := all[i]
                if str.ends_with(n, ".pgn") || str.ends_with(n, ".PGN") {
                    match fs.read_to_string(home + "/" + n) {
                        .ok(text) => {
                            openings = vec.push(openings, explore_mod.opening_at6(pgn.tokens(text)))
                            results = vec.push(results, explore_mod.result_of_text(text))
                        }
                        .err(_) => {
                            skip := 0
                            skip = skip
                        }
                    }
                }
                i = i + 1
            }
            if len(openings) == 0 {
                println("no games yet")
                return
            }
            lines := explore_mod.summarize(openings, results)
            i = 0
            while i < len(lines) {
                println(lines[i])
                i = i + 1
            }
        }
        .err(_) => println("no games yet")
    }
}

// Tournament: round-robin over every personality, alternating colors,
// crosstable at the end.

func tournament() {
    names := person.roster_names()
    n := len(names)
    mat := []
    i := 0
    while i < n * n {
        mat = vec.push(mat, 0 - 1)
        i = i + 1
    }
    a := 0
    while a < n {
        b := a + 1
        while b < n {
            println(tourney.short_of(names[a]) + " vs " + tourney.short_of(names[b]))
            r1 := tourney.play_game(person.by_index(a), person.by_index(b), 40)
            ends := ["1/2-1/2", "1-0", "0-1"]
            println(ends[r1] + " (" + tourney.short_of(names[a]) + " white)")
            r2 := tourney.play_game(person.by_index(b), person.by_index(a), 40)
            println(ends[r2] + " (" + tourney.short_of(names[b]) + " white)")
            if r1 == 1 {
                mat[a * n + b] = 2
                mat[b * n + a] = 0
            } else {
                if r1 == 2 {
                    mat[a * n + b] = 0
                    mat[b * n + a] = 2
                } else {
                    mat[a * n + b] = 1
                    mat[b * n + a] = 1
                }
            }
            if r2 == 1 {
                mat[b * n + a] = 2
                mat[a * n + b] = 0
            } else {
                if r2 == 2 {
                    mat[b * n + a] = 0
                    mat[a * n + b] = 2
                } else {
                    mat[b * n + a] = 1
                    mat[a * n + b] = 1
                }
            }
            b = b + 1
        }
        a = a + 1
    }
    lines := tourney.table(names, mat, n)
    i := 0
    while i < len(lines) {
        println(lines[i])
        i = i + 1
    }
}

// Import a PGN file: replay its movetext, print every move, end with
// the board and the result. Stops at the first token our notation
// cannot name (with its move number).

func import_pgn(path: str) {
    match fs.read_to_string(path) {
        .ok(text) => {
            toks := pgn.tokens(text)
            p := board.setup()
            hist := []
            ok := true
            i := 0
            while i < len(toks) && ok {
                m := san.parse_san(p, toks[i])
                if m == 0 {
                    println("cannot parse move " + str(i + 1) + ": " + toks[i])
                    ok = false
                } else {
                    num := i / 2 + 1
                    if i % 2 == 0 {
                        println(str(num) + ". " + san.notation(p, m))
                    } else {
                        println(str(num) + "... " + san.notation(p, m))
                    }
                    hist = ai.push_hist(hist, p)
                    p = moves.make(p, m)
                }
                i = i + 1
            }
            if ok {
                board.show(p.b)
                st := person.result(p, hist)
                if st == 0 {
                    println("* unfinished (" + str(len(toks)) + " plies)")
                } else {
                    println(person.result_line(st))
                }
            }
        }
        .err(_) => println("cannot read " + path)
    }
}

func show_fen(fen_text: str) {
    match fen.parse(fen_text) {
        .some(p) => {
            board.show(p.b)
            println("fen: " + fen.generate(p))
            ms := moves.gen_legal(p)
            println("legal moves: " + str(len(ms)))
            if moves.in_check(p) {
                println("side to move is in check")
            }
            if p.half >= 100 {
                println("fifty-move draw")
            }
            if ai.insufficient_material(p.b) {
                println("dead position")
            }
        }
        .none => println("bad FEN")
    }
}

func show_help() {
    println("chesz — chess in the terminal (engine + board UI)")
    println("")
    println("usage: chesz [command]")
    println("")
    println("  (no args)          lobby: play, hotseat, load PGN, puzzles, lessons, watch")
    println("  play               human (white) vs Club in plain text")
    println("  tui [white|black]  board UI vs Club (falls back to text)")
    println("  ai                 Club vs Club demo, 40 plies")
    println("  gauntlet           Novice vs Club x4 with an Elo table")
    println("  tournament         round-robin over every personality + crosstable")
    println("  explore            win rates per opening mined from games/")
    println("  lessons            guided Scholar's mate + back-rank lessons")
    println("  analyze [FEN]      Expert top-3 over a position + PV line")
    println("  fen FEN            inspect a position (moves, checks, draws)")
    println("  pgn FILE           replay a PGN file, print the game")
    println("  perft              movegen self-check (20 / 400 / 8902)")
    println("  uci                UCI loop for GUIs (Cutechess, lichess bots)")
    println("  --help, -h         this help")
    println("")
    println("board keys: arrows/hjkl move · enter select · ? hint · u undo")
    println("            q resign · e eval bar · f flip · z zen · s suspend")
}

func main(args: [str]) {
    if len(args) == 0 {
        if !lobby.run() {
            menu()
        }
        return
    }
    if args[0] == "perft" {
        perft_check()
        return
    }
    if args[0] == "ai" {
        play_game(person.club(), person.club(), 40)
        return
    }
    if args[0] == "play" {
        play_human(person.club(), 1)
        return
    }
    if args[0] == "gauntlet" {
        gauntlet()
        return
    }
    if args[0] == "tournament" {
        tournament()
        return
    }
    if args[0] == "explore" {
        explore()
        return
    }
    if args[0] == "lessons" {
        if !lesson.run() {
            println("lessons need a terminal")
        }
        return
    }
    if args[0] == "uci" {
        uci.run()
        return
    }
    if args[0] == "analyze" {
        if len(args) > 1 {
            analyze(args[1])
        } else {
            analyze(fen.startpos())
        }
        return
    }
    if args[0] == "tui" {
        human := 1
        if len(args) > 1 && args[1] == "black" {
            human = 0 - 1
        }
        if !game.run(person.club(), human, [0 - 1, 0 - 1, 0]) {
            play_human(person.club(), human)
        }
        return
    }
    if args[0] == "fen" && len(args) > 1 {
        show_fen(args[1])
        return
    }
    if args[0] == "pgn" && len(args) > 1 {
        import_pgn(args[1])
        return
    }
    if args[0] == "--help" || args[0] == "-h" || args[0] == "help" {
        show_help()
        return
    }
    println("usage: chesz [--help] | perft | ai | play | tui [white|black] | gauntlet | tournament | explore | lessons | uci | analyze [FEN] | fen FEN | pgn FILE")
}
