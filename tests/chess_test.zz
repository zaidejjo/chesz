@test
func lessons_data_legal() {
    assert_eq(lessons.count(), 2)
    i := 0
    while i < lessons.count() {
        assert_eq(len(lessons.desc_at(i)) > 0, true)
        match fen.parse(lessons.fen_at(i)) {
            .some(p) => {
                seq := lessons.moves_at(i)
                assert_eq(len(seq) > 0, true)
                k := 0
                while k < len(seq) {
                    m := san.parse_san(p, seq[k])
                    assert_eq(m != 0, true)
                    p = moves.make(p, m)
                    k = k + 1
                }
            }
            .none => panic("lesson FEN rejected")
        }
        i = i + 1
    }
}

