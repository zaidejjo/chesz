    match fen.parse("rnbqkbnr/ppp2ppp/4p3/3p4/3PP3/8/PPP2PPP/RNBQKBNR w KQkq - 0 1") {
        .some(p) => assert_eq(book.name_of(p), "French Defence")
        .none => panic("french FEN rejected")
    }
    match fen.parse("rnbqkbnr/pp2pppp/2p5/3p4/3PP3/8/PPP2PPP/RNBQKBNR w KQkq - 0 1") {
        .some(p) => assert_eq(book.name_of(p), "Caro-Kann")
        .none => panic("caro FEN rejected")
    }
    match fen.parse("rnbqkbnr/ppp1pppp/8/3p4/3P1B2/8/PPP1PPPP/RNQ1KBNR b KQkq - 0 1") {
        .some(p) => assert_eq(book.name_of(p), "London System")
        .none => panic("london FEN rejected")
    }
    match fen.parse("rnbqkbnr/ppp1pppp/8/3p4/2PP4/8/PP2PPPP/RNBQKBNR w KQkq - 0 1") {
        .some(p) => assert_eq(book.name_of(p), "Queen's Gambit")
        .none => panic("queens FEN rejected")
