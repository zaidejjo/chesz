@test
func netproto_lines() {
    assert_eq(netproto.default_port(), 8377)
    assert_eq(netproto.addr_host("192.168.1.5:8377"), "192.168.1.5")
    assert_eq(netproto.addr_port("192.168.1.5:8377"), 8377)
    assert_eq(netproto.addr_host("lan-pc"), "lan-pc")
    assert_eq(netproto.addr_port("lan-pc"), 8377)
    assert_eq(netproto.addr_port("h:9999"), 9999)
    assert_eq(netproto.addr_port("h:abc"), 8377)
    assert_eq(netproto.hello_color(netproto.hello_build("white")), "white")
    assert_eq(netproto.hello_color(netproto.hello_build("black")), "black")
    assert_eq(netproto.hello_color("garbage"), "")
    assert_eq(netproto.hello_color("hello chesz/1 white"), "white")
    c := netproto.clock_parse(netproto.clock_build(300000, 299000, 1000))
    assert_eq(len(c), 3)
    assert_eq(c[0], 300000)
    assert_eq(c[1], 299000)
    assert_eq(c[2], 1000)
    assert_eq(len(netproto.clock_parse("nope")), 0)
    line := netproto.move_build("e2e4", 300000, 299500)
    assert_eq(netproto.kind_of(line), "move")
    assert_eq(netproto.move_coord(line), "e2e4")
    assert_eq(netproto.move_wms(line), 300000)
    assert_eq(netproto.move_bms(line), 299500)
    assert_eq(netproto.kind_of("resign"), "resign")
    assert_eq(netproto.move_coord("resign"), "")
}

@test
func net_loopback_handshake() {
    // Single-threaded: the kernel completes the handshake on connect,
    // so write-then-accept-then-read works with no peer task.
    match net.tcp_listen("127.0.0.1:18377") {
        .ok(l) => {
            match net.tcp_connect("127.0.0.1:18377", 3000) {
                .ok(c) => {
                    match c.write(netproto.hello_build("white")) {
                        .ok(_) => 0
                        .err(_) => 0 - 1
                    }
                    match l.accept() {
                        .ok(s) => {
                            match s.read_line() {
                                .ok(got) => assert_eq(netproto.hello_color(got), "white")
                                .err(_) => panic("loopback read failed")
                            }
                            match s.write(netproto.clock_build(300000, 300000, 0)) {
                                .ok(_) => 0
                                .err(_) => 0 - 1
                            }
                            match c.read_line() {
                                .ok(got) => {
                                    back := netproto.clock_parse(got)
                                    assert_eq(len(back), 3)
                                    assert_eq(back[0], 300000)
                                }
                                .err(_) => panic("loopback clock read failed")
                            }
                            match c.close() {
                                .ok(_) => 0
                                .err(_) => 0 - 1
                            }
                            match s.close() {
                                .ok(_) => 0
                                .err(_) => 0 - 1
                            }
                            assert_eq(1, 1)
                        }
                        .err(_) => panic("loopback accept failed")
                    }
                    assert_eq(1, 1)
                }
                .err(_) => panic("loopback connect failed")
            }
            assert_eq(1, 1)
        }
        .err(_) => panic("loopback listen failed")
    }
}

@test
func custom_clock_math() {
    c := lobby.clock_of(5, 3)
    assert_eq(c[0], 300000)
    assert_eq(c[1], 300000)
    assert_eq(c[2], 3000)
}

@test
func share_bundle_text() {
    st := report_frame([0, 0, 0], ["e4", "e5"], [101, 102], 0 - 1)
    text := game.share_text(st, "Human", "Club")
    assert_eq(str.contains(text, "[White \"Human\"]"), true)
    assert_eq(str.contains(text, "Chesz report"), true)
    assert_eq(str.contains(text, "Graph"), true)
}
