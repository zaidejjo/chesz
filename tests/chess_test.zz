@test
func theme_tables() {
    assert_eq(board_view.theme_count(), 15)
    assert_eq(board_view.theme_of("catppuccin"), 4)
    assert_eq(board_view.theme_of("tokyo-night"), 6)
    assert_eq(board_view.theme_of("rose-pine"), 14)
    assert_eq(board_view.theme_of("nope"), 0 - 1)
    assert_eq(board_view.theme_name(6), "tokyo-night")
    assert_eq(board_view.theme_name(99), "lichess")
    r := board_view.hex_rgb("#ff0000")
    assert_eq(r[0], 255)
    assert_eq(r[1], 0)
    assert_eq(r[2], 0)
    r = board_view.hex_rgb("#1a2B3c")
    assert_eq(r[0], 26)
    assert_eq(r[1], 43)
    assert_eq(r[2], 60)
    assert_eq(len(board_view.hex_rgb("nope")), 0)
    assert_eq(len(board_view.hex_rgb("#12")), 0)
    assert_eq(len(board_view.load_custom(0)), 0)
    assert_eq(len(board_view.load_custom(0 - 5)), 0)
    // Every builtin id round-trips and renders a full board.
    match fen.parse(fen.startpos()) {
        .some(p) => {
            t := 0
            while t < board_view.theme_count() {
                assert_eq(board_view.theme_name(board_view.theme_of(board_view.theme_name(t))), board_view.theme_name(t))
                rows := board_view.render(p, 0 - 1, 0 - 1, [], 0 - 1, 0 - 1, 3, 2, t, [])
                assert_eq(len(rows), 19)
                t = t + 1
            }
        }
        .none => panic("startpos rejected")
    }
}

@test
func board_themes() {
    assert_eq(board_view.theme_of("lichess"), 0)
    assert_eq(board_view.theme_of("green"), 1)
