// Chess engine tests: FEN roundtrips, clocks, movegen sanity.
// Fast — no search beyond depth-2 perft.

import std.str

import chesz.engine.ai
import chesz.engine.book
import chesz.engine.eval
import chesz.engine.fen
import chesz.engine.moves
import chesz.engine.person
import chesz.engine.san
import chesz.main
import chesz.tui.board_view
import chesz.tui.pick
import chesz.uci.uci
import tui.keys as tkeys

@test
func fen_startpos_roundtrip() {
    match fen.parse(fen.startpos()) {
        .some(p) => {
            assert_eq(p.side, 1)
            assert_eq(p.cast, 15)
            assert_eq(p.ep, 0 - 1)
            assert_eq(p.half, 0)
            assert_eq(p.full, 1)
            assert_eq(fen.generate(p), fen.startpos())
        }
        .none => panic("startpos FEN rejected")
    }
}

@test
func fen_kiwipete_fields() {
    match fen.parse(fen.kiwipete()) {
        .some(p) => {
            assert_eq(p.side, 1)
            assert_eq(p.cast, 15)
            assert_eq(len(moves.gen_legal(p)), 48)
        }
        .none => panic("kiwipete FEN rejected")
    }
}

@test
func fen_rejects_garbage() {
    match fen.parse("not a fen") {
        .some(_) => panic("garbage FEN accepted")
        .none => assert_eq(1, 1)
    }
    match fen.parse("8/8/8/8/8/8/8/8 w - - 0 1") {
        .some(p) => assert_eq(fen.generate(p), "8/8/8/8/8/8/8/8 w - - 0 1")
        .none => panic("empty board rejected")
    }
}

@test
func clocks_tick() {
    match fen.parse(fen.startpos()) {
        .some(p) => {
            // e2e4: pawn double push, clock reset, ep set, side flips.
            ms := moves.gen_legal(p)
            found := false
            i := 0
            while i < len(ms) {
                if moves.mv_from(ms[i]) == 12 && moves.mv_to(ms[i]) == 28 {
                    q := moves.make(p, ms[i])
                    assert_eq(q.half, 0)
                    assert_eq(q.side, 0 - 1)
                    assert_eq(q.ep, 20)
                    assert_eq(q.full, 1)
                    found = true
                }
                i = i + 1
            }
            assert_eq(found, true)
            // Ng1f3: quiet knight move, clock ticks, number holds (white).
            i = 0
            found = false
            while i < len(ms) {
                if moves.mv_from(ms[i]) == 6 && moves.mv_to(ms[i]) == 21 {
                    q := moves.make(p, ms[i])
                    assert_eq(q.half, 1)
                    assert_eq(q.ep, 0 - 1)
                    assert_eq(q.full, 1)
                    found = true
                }
                i = i + 1
            }
            assert_eq(found, true)
        }
        .none => panic("startpos rejected")
    }
}

@test
func perft_startpos_shallow() {
    match fen.parse(fen.startpos()) {
        .some(p) => {
            assert_eq(len(moves.gen_legal(p)), 20)
            n := 0
            ms := moves.gen_legal(p)
            i := 0
            while i < len(ms) {
                n = n + len(moves.gen_legal(moves.make(p, ms[i])))
                i = i + 1
            }
            assert_eq(n, 400)
        }
        .none => panic("startpos rejected")
    }
}

@test
func san_spot_checks() {
    match fen.parse(fen.startpos()) {
        .some(p) => {
            // e2e4 -> "e4", Ng1f3 -> "Nf3".
            ms := moves.gen_legal(p)
            i := 0
            seen_e4 := false
            seen_nf3 := false
            while i < len(ms) {
                m := ms[i]
                if moves.mv_from(m) == 12 && moves.mv_to(m) == 28 {
                    assert_eq(san.notation(p, m), "e4")
                    seen_e4 = true
                }
                if moves.mv_from(m) == 6 && moves.mv_to(m) == 21 {
                    assert_eq(san.notation(p, m), "Nf3")
                    seen_nf3 = true
                }
                i = i + 1
            }
            assert_eq(seen_e4, true)
            assert_eq(seen_nf3, true)
        }
        .none => panic("startpos rejected")
    }
    // Scholar's mate finish is mate: Qxf7#.
    match fen.parse("r1bqkbnr/pppp1ppp/2n5/4p2Q/2B1P3/8/PPPP1PPP/RNB1K1NR w KQkq - 0 1") {
        .some(p) => {
            ms := moves.gen_legal(p)
            i := 0
            found := false
            while i < len(ms) {
                m := ms[i]
                if moves.mv_from(m) == 39 && moves.mv_to(m) == 53 {
                    assert_eq(san.notation(p, m), "Qxf7#")
                    found = true
                }
                i = i + 1
            }
            assert_eq(found, true)
        }
        .none => panic("mate FEN rejected")
    }
}

@test
func draw_rules() {
    match fen.parse("8/8/4k3/8/8/4K3/8/8 w - - 0 1") {
        .some(p) => assert_eq(ai.insufficient_material(p.b), true)
        .none => panic("kings FEN rejected")
    }
    // Startpos: not dead.
    match fen.parse(fen.startpos()) {
        .some(p) => assert_eq(ai.insufficient_material(p.b), false)
        .none => panic("startpos rejected")
    }
    // Fifty-move clock triggers at 100.
    match fen.parse("8/8/4k3/8/8/4K3/8/8 w - - 100 60") {
        .some(p) => assert_eq(p.half >= 100, true)
        .none => panic("fifty FEN rejected")
    }
    // Repetition counting: fresh history sees the current board once.
    match fen.parse(fen.startpos()) {
        .some(p) => {
            assert_eq(ai.repetitions([], p), 1)
            h := ai.push_hist([], p)
            assert_eq(ai.repetitions(h, p), 2)
        }
        .none => panic("startpos rejected")
    }
}

@test
func eval_symmetry_and_material() {
    match fen.parse(fen.startpos()) {
        .some(p) => {
            // Perfect symmetry: only tempo scores.
            assert_eq(eval.evaluate(p), 8)
        }
        .none => panic("startpos rejected")
    }
    match fen.parse("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR b KQkq - 0 1") {
        .some(p) => {
            // Same board, black to move: mirror image, tempo only.
            assert_eq(eval.evaluate(p), 8)
        }
        .none => panic("mirror FEN rejected")
    }
    // White up a knight: roughly a piece plus change.
    match fen.parse("rnbqkb1r/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1") {
        .some(p) => {
            s := eval.evaluate(p)
            assert_eq(s > 200 && s < 500, true)
        }
        .none => panic("knight-up FEN rejected")
    }
}

@test
func null_move_passes() {
    match fen.parse(fen.startpos()) {
        .some(p) => {
            q := moves.null_move(p)
            assert_eq(q.side, 0 - 1)
            assert_eq(q.ep, 0 - 1)
            assert_eq(q.half, 1)
            assert_eq(q.full, 1)
        }
        .none => panic("startpos rejected")
    }
}

@test
func master_mates_in_one() {
    // Depth-1 solver: mate-in-1 is visible at the frontier (root
    // quiescence finds the mate), so this stays fast on the VM.
    solver := person.Engine{name: "Solver", elo: 0, depth: 1, movems: 2000, variety: 0, blunder: 0, joker: false}
    match fen.parse("r1bqkbnr/pppp1ppp/2n5/4p2Q/2B1P3/8/PPPP1PPP/RNB1K1NR w KQkq - 0 1") {
        .some(p) => {
            assert_eq(ai.best_score(p, 1) > 90000, true)
            m := person.best_move_for(solver, p, [])
            assert_eq(str.ends_with(san.notation(p, m), "#"), true)
        }
        .none => panic("mate FEN rejected")
    }
}

@test
func joker_always_legal() {
    match fen.parse(fen.startpos()) {
        .some(p) => {
            legal := moves.gen_legal(p)
            t := 0
            while t < 10 {
                m := person.best_move_for(person.joker(), p, [])
                found := false
                i := 0
                while i < len(legal) {
                    if legal[i] == m {
                        found = true
                    }
                    i = i + 1
                }
                assert_eq(found, true)
                t = t + 1
            }
        }
        .none => panic("startpos rejected")
    }
}

@test
func book_answers_openings() {
    match fen.parse(fen.startpos()) {
        .some(p) => {
            m := book.probe(p)
            assert_eq(m != 0, true)
            assert_eq(san.notation(p, m), "e4")
            // After 1.e4 the book has a black reply.
            q := moves.make(p, m)
            r := book.probe(q)
            assert_eq(r != 0, true)
            assert_eq(san.notation(q, r), "e5")
        }
        .none => panic("startpos rejected")
    }
    // Empty board: no book.
    match fen.parse("8/8/8/8/8/8/8/8 w - - 0 1") {
        .some(p) => assert_eq(book.probe(p), 0)
        .none => panic("empty FEN rejected")
    }
}

@test
func coord_parser() {
    match fen.parse(fen.startpos()) {
        .some(p) => {
            legal := moves.gen_legal(p)
            m := san.parse_coord("e2e4", legal)
            assert_eq(m != 0, true)
            assert_eq(moves.mv_from(m), 12)
            assert_eq(moves.mv_to(m), 28)
            // No castling through a full back rank.
            assert_eq(san.parse_coord("O-O", legal), 0)
            assert_eq(san.parse_coord("xxxx", legal), 0)
        }
        .none => panic("startpos rejected")
    }
    match fen.parse("8/4P3/8/8/8/8/8/4K2k w - - 0 1") {
        .some(p) => {
            m := san.parse_coord("e7e8q", moves.gen_legal(p))
            assert_eq(moves.mv_promo(m), 5)
        }
        .none => panic("promo FEN rejected")
    }
}

@test
func uci_score_lines() {
    assert_eq(uci.score_line(150), "score cp 150")
    assert_eq(uci.score_line(-40), "score cp -40")
    assert_eq(uci.score_line(99998), "score mate 1")
    assert_eq(uci.score_line(-99997), "score mate -2")
}

@test
func elo_table_anchors() {
    assert_eq(main.elo_of_pm(500), 0)
    assert_eq(main.elo_of_pm(1000), 800)
    assert_eq(main.elo_of_pm(0), 0 - 800)
    e := main.elo_of_pm(750)
    assert_eq(e > 150 && e < 250, true)
    assert_eq(main.elo_of_pm(250), 0 - main.elo_of_pm(750))
}

func has_move(ms: [int], m: int) -> bool {
    i := 0
    while i < len(ms) {
        if ms[i] == m {
            return true
        }
        i = i + 1
    }
    false
}

func check_loud_parity(fen_text: str) {
    match fen.parse(fen_text) {
        .some(p) => {
            pseudo := moves.gen_pseudo(p)
            loud := moves.gen_loud(p)
            i := 0
            while i < len(loud) {
                assert_eq(has_move(pseudo, loud[i]), true)
                assert_eq(ai.is_loud(p, loud[i]), true)
                i = i + 1
            }
            n := 0
            i = 0
            while i < len(pseudo) {
                if ai.is_loud(p, pseudo[i]) {
                    n = n + 1
                    assert_eq(has_move(loud, pseudo[i]), true)
                }
                i = i + 1
            }
            assert_eq(len(loud), n)
        }
        .none => panic("bad FEN: " + fen_text)
    }
}

@test
func loud_matches_pseudo() {
    check_loud_parity(fen.startpos())
    check_loud_parity(fen.kiwipete())
    check_loud_parity("r1bqkbnr/pppp1ppp/2n5/4p2Q/2B1P3/8/PPPP1PPP/RNB1K1NR w KQkq - 0 1")
    check_loud_parity("8/4P3/8/8/8/8/8/4K2k w - - 0 1")
}

@test
func view_renders_big_plain_board() {
    match fen.parse(fen.startpos()) {
        .some(p) => {
            rows := board_view.render(p, 12, 0 - 1, [], 0 - 1, 0 - 1, 0, 2)
            // Border + 16 cell rows + border + footer.
            assert_eq(len(rows), 19)
            i := 0
            while i < len(rows) {
                assert_eq(str.contains(rows[i], "\e"), false)
                i = i + 1
            }
            assert_eq(str.starts_with(rows[0], "  +"), true)
            assert_eq(str.starts_with(rows[2], "8 "), true)
            assert_eq(str.contains(rows[18], "a      b"), true)
        }
        .none => panic("startpos rejected")
    }
}

@test
func view_compose_centers() {
    match fen.parse(fen.startpos()) {
        .some(p) => {
            rows := board_view.render(p, 12, 0 - 1, [], 0 - 1, 0 - 1, 0, 2)
            frame := board_view.compose(rows, ["hi"], 4, 2)
            assert_eq(len(frame), 21)
            assert_eq(str.starts_with(frame[2], "    "), true)
            assert_eq(str.contains(frame[2], "hi"), true)
            assert_eq(frame[0], "")
            assert_eq(frame[1], "")
        }
        .none => panic("startpos rejected")
    }
}

@test
func view_cursor_and_targets() {
    match fen.parse(fen.startpos()) {
        .some(p) => {
            // e2 pawn has exactly e3+e4.
            tg := board_view.targets_for(p, 12)
            assert_eq(len(tg), 2)
            assert_eq(board_view.has_sq(tg, 20), true)
            assert_eq(board_view.has_sq(tg, 28), true)
            // Empty square: no targets.
            assert_eq(len(board_view.targets_for(p, 27)), 0)
            // Cursor clamps at the edges, never wraps.
            assert_eq(board_view.step_cursor(0, 0 - 1, 0 - 1), 0)
            assert_eq(board_view.step_cursor(63, 1, 1), 63)
            assert_eq(board_view.step_cursor(0, 1, 0), 1)
        }
        .none => panic("startpos rejected")
    }
}

@test
func pick_steps() {
    assert_eq(pick.step(1, 3, tkeys.up()), 0)
    assert_eq(pick.step(0, 3, tkeys.up()), 0)
    assert_eq(pick.step(0, 3, tkeys.down()), 1)
    assert_eq(pick.step(2, 3, tkeys.down()), 2)
    assert_eq(pick.step(2, 3, 1004), 0)
    assert_eq(pick.step(0, 3, 1005), 2)
    assert_eq(pick.step(1, 3, 107), 0)
    assert_eq(pick.step(1, 3, 106), 2)
    assert_eq(pick.step(1, 3, 999), 1)
}

@test
func view_promo_variants() {
    match fen.parse("8/4P3/8/8/8/8/8/4K2k w - - 0 1") {
        .some(p) => {
            legal := moves.gen_legal(p)
            opts := board_view.find_moves(legal, 52, 60)
            assert_eq(len(opts), 4)
        }
        .none => panic("promo FEN rejected")
    }
}

@test
func view_ascii_pieces() {
    match fen.parse(fen.startpos()) {
        .some(p) => {
            assert_eq(board_view.ascii_art(1, 0), "  (_)  ")
            assert_eq(board_view.ascii_art(1, 1), " _|_|_ ")
            assert_eq(board_view.ascii_art(4, 0), "|_|_|_|")
            assert_eq(board_view.ascii_art(0 - 6, 1), " _|_|_ ")
            assert_eq(board_view.ascii_art(0, 0), "       ")
            rows := board_view.render(p, 12, 0 - 1, [], 0 - 1, 0 - 1, 3, 0)
            assert_eq(len(rows), 19)
            assert_eq(str.contains(rows[1], "|_|_|_|"), true)
            assert_eq(str.contains(rows[13], "(_)"), true)
        }
        .none => panic("startpos rejected")
    }
}

@test
func tray_and_movelist() {
    match fen.parse(fen.startpos()) {
        .some(p) => {
            cap := board_view.captured(p, 0)
            assert_eq(cap[0], "W takes: -")
            assert_eq(cap[1], "B takes: -")
        }
        .none => panic("startpos rejected")
    }
    match fen.parse("rnbqkbnr/ppp1pppp/8/3P4/8/8/PPPP1PPP/RNBQKBNR b KQkq - 0 1") {
        .some(p) => {
            cap := board_view.captured(p, 0)
            assert_eq(cap[0], "W takes: p")
            assert_eq(cap[1], "B takes: -")
        }
        .none => panic("capture FEN rejected")
    }
    mv := board_view.movelist(["e4", "e5", "Nf3"], 3, 2)
    assert_eq(len(mv), 2)
    assert_eq(mv[0], "1... e5")
    assert_eq(mv[1], "2. Nf3")
}

@test
func style_config() {
    assert_eq(board_view.style_of("glyphs"), 1)
    assert_eq(board_view.style_of("letters"), 2)
    assert_eq(board_view.style_of("ascii"), 0)
    assert_eq(board_view.style_of("nope"), 0 - 1)
    assert_eq(board_view.style_in_json("{\"pieces\": \"glyphs\"}"), 1)
    assert_eq(board_view.style_in_json("{\"pieces\": \"chaos\"}"), 0 - 1)
    assert_eq(board_view.style_in_json("not json"), 0 - 1)
    assert_eq(board_view.style_in_json("{\"nope\": 1}"), 0 - 1)
}

@test
func eval_bar_math() {
    // Logistic anchors + symmetry: mate handled by callers, never here.
    assert_eq(eval.win_pct(0), 50)
    assert_eq(eval.win_pct(100), 64)
    assert_eq(eval.win_pct(0 - 100), 36)
    assert_eq(eval.win_pct(1000), 99)
    assert_eq(eval.win_pct(0 - 1000), 1)
    assert_eq(eval.win_pct(200) + eval.win_pct(0 - 200), 100)
    // white_cp strips tempo: startpos reads exactly 0 either side to move.
    match fen.parse(fen.startpos()) {
        .some(p) => {
            assert_eq(eval.white_cp(p), 0)
        }
        .none => panic("startpos rejected")
    }
    match fen.parse("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR b KQkq - 0 1") {
        .some(p) => {
            assert_eq(eval.white_cp(p), 0)
        }
        .none => panic("mirror FEN rejected")
    }
    // New terms stay silent at startpos (symmetry + no outposts).
    match fen.parse(fen.startpos()) {
        .some(p) => {
            assert_eq(eval.evaluate(p), 8)
        }
        .none => panic("startpos rejected")
    }
    // Display formatting.
    assert_eq(board_view.fmt_cp(65), "+0.65")
    assert_eq(board_view.fmt_cp(0 - 5), "-0.05")
    assert_eq(board_view.fmt_cp(0), "+0.00")
    assert_eq(board_view.eval_line(65, 64, 0), "Eval: +0.65 · White 64%")
    assert_eq(board_view.eval_line(0, 100, 1), "Eval: mate 1 · White 100%")
    assert_eq(board_view.eval_line(0, 0, 0 - 1), "Eval: mated 1 · White 0%")
    // Bar keeps 19 rows and fills white from the bottom.
    match fen.parse(fen.startpos()) {
        .some(p) => {
            rows := board_view.render(p, 12, 0 - 1, [], 0 - 1, 0 - 1, 0, 2)
            b := board_view.with_bar(rows, 62, 0)
            assert_eq(len(b), 19)
            assert_eq(str.starts_with(b[1], "."), true)
            assert_eq(str.starts_with(b[16], "#"), true)
            e := board_view.with_bar(rows, 0, 0)
            assert_eq(str.starts_with(e[16], "."), true)
            f := board_view.with_bar(rows, 100, 0)
            assert_eq(str.starts_with(f[1], "#"), true)
            assert_eq(str.starts_with(f[16], "#"), true)
            // Fractional waterline: pct 6 lights only the bottom row,
            // pct 50 fills exactly the bottom eight of sixteen.
            g := board_view.with_bar(rows, 6, 0)
            assert_eq(str.starts_with(g[16], "#"), true)
            assert_eq(str.starts_with(g[15], "."), true)
            h := board_view.with_bar(rows, 50, 0)
            assert_eq(str.starts_with(h[8], "."), true)
            assert_eq(str.starts_with(h[9], "#"), true)
        }
        .none => panic("startpos rejected")
    }
}

@test
func book_grew_past_sicilian() {
    // 1.e4 c5 2.Nf3 -> d6; French 3.Nc3; London 2...Nf6.
    match fen.parse("rnbqkbnr/pp1ppppp/8/2p5/4P3/5N2/PPPP1PPP/RNBQKB1R b KQkq - 0 1") {
        .some(p) => assert_eq(book.probe(p) != 0, true)
        .none => panic("sicilian FEN rejected")
    }
    match fen.parse("rnbqkbnr/ppp2ppp/4p3/3p4/3PP3/8/PPP2PPP/RNBQKBNR w KQkq - 0 1") {
        .some(p) => assert_eq(book.probe(p) != 0, true)
        .none => panic("french FEN rejected")
    }
    match fen.parse("rnbqkbnr/ppp1pppp/8/3p4/3P1B2/8/PPP1PPPP/RNQ1KBNR b KQkq - 0 1") {
        .some(p) => assert_eq(book.probe(p) != 0, true)
        .none => panic("london FEN rejected")
    }
}
