    assert_eq(str.ends_with(rows[0], "╮"), true)
    assert_eq(str.contains(rows[3], "> Play vs engine"), true)
    assert_eq(str.contains(rows[4], "  Quit"), true)
    assert_eq(str.contains(rows[6], "---"), true)
    assert_eq(str.contains(rows[7], "arrows"), true)
    assert_eq(str.starts_with(rows[8], "╰"), true)
    assert_eq(str.ends_with(rows[8], "╯"), true)
}

