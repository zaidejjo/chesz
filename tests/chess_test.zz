    assert_eq(board_view.theme_of("blue"), 3)
    assert_eq(board_view.theme_of("nope"), 0 - 1)
    assert_eq(board_view.theme_in_json("{\"theme\": \"green\"}"), 1)
    assert_eq(board_view.theme_in_json("{\"theme\": \"chaos\"}"), 0 - 1)
    assert_eq(board_view.theme_in_json("{\"nope\": 1}"), 0 - 1)
    match fen.parse(fen.startpos()) {
        .some(p) => {
            a := board_view.render(p, 0 - 1, 0 - 1, [], 0 - 1, 0 - 1, 3, 2, 0, [])
            b := board_view.render(p, 0 - 1, 0 - 1, [], 0 - 1, 0 - 1, 3, 2, 1, [])
            assert_eq(len(a), len(b))
            assert_eq(a[1] == b[1], false)
        }
        .none => panic("startpos rejected")
    }
}

@test
func mouse_hit_testing() {
    assert_eq(mouse.is_mouse([2000, 0, 36, 16]), true)
    assert_eq(mouse.is_mouse([101]), false)
    assert_eq(mouse.is_mouse([2001]), false)
    // ox=4, oy=2, no bar: e2 lives at x=36, y=16.
    assert_eq(mouse.board_sq(36, 16, 4, 2, false), 12)
    // a8 top-left cell corner.
    assert_eq(mouse.board_sq(8, 4, 4, 2, false), 56)
    // h1 bottom-right cell corner.
    assert_eq(mouse.board_sq(63, 19, 4, 2, false), 7)
    // Border, footer and margins miss.
    assert_eq(mouse.board_sq(4, 2, 4, 2, false), 0 - 1)
    assert_eq(mouse.board_sq(36, 21, 4, 2, false), 0 - 1)
    assert_eq(mouse.board_sq(1, 1, 4, 2, false), 0 - 1)
    // Bar prefix shifts two columns.
    assert_eq(mouse.board_sq(38, 16, 4, 2, true), 12)
    assert_eq(mouse.board_sq(8, 16, 4, 2, true), 0 - 1)
}

