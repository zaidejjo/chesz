}

@test
func view_ascii_pieces() {
    match fen.parse(fen.startpos()) {
        .some(p) => {
            assert_eq(board_view.ascii_art(1, 0), "  (_)  ")
            assert_eq(board_view.ascii_art(1, 1), " _|_|_ ")
            assert_eq(board_view.ascii_art(4, 0), "|_|_|_|")
            assert_eq(board_view.ascii_art(0 - 6, 1), " _|_|_ ")
            assert_eq(board_view.ascii_art(0, 0), "       ")
            rows := board_view.render(p, 12, 0 - 1, [], 0 - 1, 0 - 1, 3, 0, 0, [])
            assert_eq(len(rows), 19)
            assert_eq(str.contains(rows[1], "|_|_|_|"), true)
            assert_eq(str.contains(rows[13], "(_)"), true)
        }
        .none => panic("startpos rejected")
    }
}

@test
func tray_and_movelist() {
    match fen.parse(fen.startpos()) {
        .some(p) => {
            cap := board_view.captured(p, 0)
            assert_eq(cap[0], "W takes: -")
            assert_eq(cap[1], "B takes: -")
        }
        .none => panic("startpos rejected")
    }
    match fen.parse("rnbqkbnr/ppp1pppp/8/3P4/8/8/PPPP1PPP/RNBQKBNR b KQkq - 0 1") {
        .some(p) => {
            cap := board_view.captured(p, 0)
            assert_eq(cap[0], "W takes: p")
            assert_eq(cap[1], "B takes: -")
        }
        .none => panic("capture FEN rejected")
    }
    mv := board_view.movelist(["e4", "e5", "Nf3"], 3, 2)
    assert_eq(len(mv), 2)
    assert_eq(mv[0], "1... e5")
    assert_eq(mv[1], "2. Nf3")
}

@test
func style_config() {
    assert_eq(board_view.style_of("glyphs"), 1)
    assert_eq(board_view.style_of("letters"), 2)
    assert_eq(board_view.style_of("ascii"), 0)
    assert_eq(board_view.style_of("nope"), 0 - 1)
    assert_eq(board_view.style_in_json("{\"pieces\": \"glyphs\"}"), 1)
    assert_eq(board_view.style_in_json("{\"pieces\": \"chaos\"}"), 0 - 1)
    assert_eq(board_view.style_in_json("not json"), 0 - 1)
    assert_eq(board_view.style_in_json("{\"nope\": 1}"), 0 - 1)
}

@test
func eval_bar_math() {
    // Logistic anchors + symmetry: mate handled by callers, never here.
    assert_eq(eval.win_pct(0), 50)
    assert_eq(eval.win_pct(100), 64)
    assert_eq(eval.win_pct(0 - 100), 36)
    assert_eq(eval.win_pct(1000), 99)
    assert_eq(eval.win_pct(0 - 1000), 1)
    assert_eq(eval.win_pct(200) + eval.win_pct(0 - 200), 100)
    // white_cp strips tempo: startpos reads exactly 0 either side to move.
    match fen.parse(fen.startpos()) {
        .some(p) => {
            assert_eq(eval.white_cp(p), 0)
        }
        .none => panic("startpos rejected")
    }
    match fen.parse("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR b KQkq - 0 1") {
        .some(p) => {
            assert_eq(eval.white_cp(p), 0)
        }
        .none => panic("mirror FEN rejected")
    }
    // New terms stay silent at startpos (symmetry + no outposts).
    match fen.parse(fen.startpos()) {
        .some(p) => {
            assert_eq(eval.evaluate(p), 8)
        }
        .none => panic("startpos rejected")
    }
    // Display formatting.
    assert_eq(board_view.fmt_cp(65), "+0.65")
    assert_eq(board_view.fmt_cp(0 - 5), "-0.05")
    assert_eq(board_view.fmt_cp(0), "+0.00")
    assert_eq(board_view.eval_line(65, 64, 0), "Eval: +0.65 · White 64%")
    assert_eq(board_view.eval_line(0, 100, 1), "Eval: mate 1 · White 100%")
    assert_eq(board_view.eval_line(0, 0, 0 - 1), "Eval: mated 1 · White 0%")
    // Bar keeps 19 rows and fills white from the bottom.
    match fen.parse(fen.startpos()) {
        .some(p) => {
            rows := board_view.render(p, 12, 0 - 1, [], 0 - 1, 0 - 1, 0, 2, 0, [])
            b := board_view.with_bar(rows, 62, 0)
            assert_eq(len(b), 19)
            assert_eq(str.starts_with(b[1], "."), true)
            assert_eq(str.starts_with(b[16], "#"), true)
            e := board_view.with_bar(rows, 0, 0)
            assert_eq(str.starts_with(e[16], "."), true)
            f := board_view.with_bar(rows, 100, 0)
            assert_eq(str.starts_with(f[1], "#"), true)
            assert_eq(str.starts_with(f[16], "#"), true)
            // Fractional waterline: pct 6 lights only the bottom row,
            // pct 50 fills exactly the bottom eight of sixteen.
            g := board_view.with_bar(rows, 6, 0)
            assert_eq(str.starts_with(g[16], "#"), true)
            assert_eq(str.starts_with(g[15], "."), true)
            h := board_view.with_bar(rows, 50, 0)
            assert_eq(str.starts_with(h[8], "."), true)
            assert_eq(str.starts_with(h[9], "#"), true)
        }
        .none => panic("startpos rejected")
    }
}

@test
func clock_format() {
    assert_eq(game.fmt_ms(300000), "5:00")
    assert_eq(game.fmt_ms(61000), "1:01")
    assert_eq(game.fmt_ms(9000), "0:09")
    assert_eq(game.fmt_ms(0), "0:00")
}

func report_frame(evals: [int], sans: [str], played: [int], wms: int) -> game.Frame {
    st := game.Frame{pos: board.setup(), hist: [], sans: sans, played: played, cursor: 12, selected: 0 - 1, targets: [], last_from: 0 - 1, last_to: 0 - 1, hint: "", hlast: 0 - 1, after: 0, m_ox: 0, m_oy: 0, tpal: [], show_bar: false, bar_cp: 0, bar_pct: 50, bar_mate: 0, wms: wms, bms: 60000, inc: 0, turn_ms: 0, evals: evals, flipped: false, zen: false, blind: false}
    st
}

@test
func report_stable_game() {
    st := report_frame([0, 0, 0], ["e4", "e5"], [101, 102], 0 - 1)
    lines := game.report(st)
    assert_eq(lines[0], "Chesz report — unfinished")
    assert_eq(lines[1], "Moves played: 2")
    assert_eq(lines[2], "White accuracy 100% over 1 move")
    assert_eq(lines[3], "Black accuracy 100% over 1 move")
    assert_eq(lines[4], "White worst: 1. e4 (-0%)")
    assert_eq(lines[5], "Black worst: 1... e5 (-0%)")
    assert_eq(lines[6], "Eval: +0.00 · White 50%")
}

@test
func report_blunder_and_flag() {
    // White drops 35 win points on move 1; white then flags.
    st := report_frame([0, 0 - 300, 0 - 300], ["d4", "d5"], [201, 202], 0)
    assert_eq(game.result_str(st), "0-1 Black wins on time")
    lines := game.report(st)
    assert_eq(lines[0], "Chesz report — 0-1 Black wins on time")
    assert_eq(lines[2], "White accuracy 0% over 1 move")
    assert_eq(lines[3], "Black accuracy 100% over 1 move")
    assert_eq(lines[4], "White worst: 1. d4 (-35%)")
}

@test
func san_roundtrip() {
    match fen.parse(fen.startpos()) {
        .some(p) => {
            m := san.parse_san(p, "e4")
            assert_eq(moves.mv_from(m), 12)
            assert_eq(moves.mv_to(m), 28)
            m = san.parse_san(p, "Nf3")
            assert_eq(moves.mv_from(m), 6)
            assert_eq(moves.mv_to(m), 21)
            assert_eq(san.parse_san(p, "O-O"), 0)
            assert_eq(san.parse_san(p, "zzz"), 0)
        }
        .none => panic("startpos rejected")
    }
    match fen.parse("r1bqkbnr/pppp1ppp/2n5/4p2Q/2B1P3/8/PPPP1PPP/RNB1K1NR w KQkq - 0 1") {
        .some(p) => {
            m := san.parse_san(p, "Qxf7#")
            assert_eq(m != 0, true)
            assert_eq(san.notation(p, m), "Qxf7#")
        }
        .none => panic("mate FEN rejected")
    }
}

@test
func pgn_build_and_tokens() {
    assert_eq(pgn.result_of(1, 0), "1-0")
    assert_eq(pgn.result_of(0, 0), "*")
    assert_eq(pgn.result_of(3, 0), "1/2-1/2")
    assert_eq(pgn.result_of(0, 1), "0-1")
    assert_eq(pgn.result_of(0, 2), "1-0")
    text := pgn.build("Human", "Club", ["e4", "e5", "Nf3"], "*")
    assert_eq(str.contains(text, "[White \"Human\"]"), true)
    assert_eq(str.contains(text, "1. e4 e5 2. Nf3 *"), true)
    toks := pgn.tokens(text)
    assert_eq(len(toks), 3)
    assert_eq(toks[0], "e4")
    assert_eq(toks[2], "Nf3")
    // Foreign noise drops out: comments, NAGs, annotations, numbers.
    toks = pgn.tokens("1. e4! {{}best} e5 $12 2. Nf3? 1-0")
    assert_eq(len(toks), 3)
    assert_eq(toks[0], "e4")
    assert_eq(toks[2], "Nf3")
    // Full roundtrip back onto the board.
    match fen.parse(fen.startpos()) {
        .some(p) => {
            i := 0
            while i < len(toks) {
                m := san.parse_san(p, toks[i])
                assert_eq(m != 0, true)
                p = moves.make(p, m)
                i = i + 1
            }
            assert_eq(fen.generate(p), "rnbqkbnr/pppp1ppp/8/4p3/4P3/5N2/PPPP1PPP/RNBQKB1R b KQkq - 1 2")
        }
        .none => panic("startpos rejected")
    }
}

@test
func browser_paths() {
    assert_eq(browse.parent_of("/a/b/c"), "/a/b")
    assert_eq(browse.parent_of("/a"), "/")
    assert_eq(browse.parent_of("/"), "/")
    assert_eq(browse.join_path("/", "x.pgn"), "/x.pgn")
    assert_eq(browse.join_path("/a", "x.pgn"), "/a/x.pgn")
    assert_eq(browse.is_pgn_name("game.pgn"), true)
    assert_eq(browse.is_pgn_name("game.PGN"), true)
    assert_eq(browse.is_pgn_name("notes.txt"), false)
}

