@test
func handicap_odds_remove() {
    p := board.setup_odds(2)
    assert_eq(p.b[57], 0)
    assert_eq(p.b[56], 0 - 4)
    p = board.setup_odds(3)
    assert_eq(p.b[58], 0)
    p = board.setup_odds(4)
    assert_eq(p.b[56], 0)
    assert_eq((p.cast / 8) % 2, 0)
    // White-side odds drop White queenside + its castling bit.
    p = board.setup_odds_side(4, 1)
    assert_eq(p.b[0], 0)
    assert_eq((p.cast / 2) % 2, 0)
    // Even game is untouched.
    p = board.setup_odds(0)
    assert_eq(p.b[57], 0 - 2)
    assert_eq(p.cast, 15)
}

