func view_promo_variants() {
    match fen.parse("8/4P3/8/8/8/8/8/4K2k w - - 0 1") {
        .some(p) => {
            legal := moves.gen_legal(p)
            opts := board_view.find_moves(legal, 52, 60)
            assert_eq(len(opts), 4)
        }
        .none => panic("promo FEN rejected")
